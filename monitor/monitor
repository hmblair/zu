#!/usr/bin/env zsh

# monitor - Server Resource Monitor
# Shows CPU, memory, and storage usage via SSH

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
EXTERNAL_MOUNT="/mnt/external"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: monitor <host>"
    echo ""
    echo "Shows CPU, memory, and storage usage for a remote server."
    echo ""
    echo "Arguments:"
    echo "  host    SSH hostname (e.g., ssh.example.com)"
    echo ""
    echo "Examples:"
    echo "  monitor ssh.hmblair.com"
    echo "  monitor user@server.local"
}

error() {
    echo "${RED}Error:${NC} $1" >&2
    exit 1
}

# Format usage line with color based on percentage
format_usage() {
    local label="$1"
    local value="$2"
    local pct="$3"
    local warn="${4:-70}"
    local crit="${5:-90}"

    local color="$GREEN"
    if [[ "$pct" != "N/A" ]]; then
        local num="${pct%.*}"
        [[ $num -ge $crit ]] && color="$RED"
        [[ $num -ge $warn && $num -lt $crit ]] && color="$YELLOW"
    fi

    printf " %-21s ${color}%s${NC}\n" "$label" "$value"
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_monitor() {
    local host="$1"

    if [[ -z "$host" ]]; then
        usage
        exit 1
    fi

    # Get all stats in a single SSH call (value|percentage format)
    local stats
    stats=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "
        # CPU usage
        cpu=\$(top -bn1 2>/dev/null | grep 'Cpu(s)' | awk '{print \$2}')
        if [[ -z \"\$cpu\" ]]; then
            cpu=\$(top -bn1 2>/dev/null | grep '%Cpu' | awk '{print \$2}')
        fi
        [[ -z \"\$cpu\" ]] && echo 'cpu:N/A|0' || echo \"cpu:\${cpu}%|\$cpu\"

        # Memory usage (used / total in GB)
        free -b 2>/dev/null | awk '/^Mem:/ {
            used=\$3/1073741824; total=\$2/1073741824; pct=\$3/\$2*100
            printf \"mem:%.2f / %.2f GB|%.0f\n\", used, total, pct
        }' || echo 'mem:N/A|0'

        # Root storage usage (used / total in GB)
        df -B1 / 2>/dev/null | awk 'NR==2 {
            used=\$3/1073741824; total=\$2/1073741824; pct=\$3/\$2*100
            printf \"storage:%.2f / %.2f GB|%.0f\n\", used, total, pct
        }' || echo 'storage:N/A|0'

        # External storage usage (used / total in GB)
        df -B1 $EXTERNAL_MOUNT 2>/dev/null | awk 'NR==2 {
            used=\$3/1073741824; total=\$2/1073741824; pct=\$3/\$2*100
            printf \"external:%.2f / %.2f GB|%.0f\n\", used, total, pct
        }' || echo 'external:N/A|0'
    " 2>/dev/null)

    if [[ -z "$stats" ]]; then
        error "Failed to retrieve stats from $host"
    fi

    echo ""
    echo "${BOLD}Server: ${CYAN}$host${NC}"
    echo "─────────────────────────────────────────"

    # Parse results (value|percentage)
    local cpu_val cpu_pct mem_val mem_pct storage_val storage_pct external_val external_pct
    cpu_val=$(echo "$stats" | grep '^cpu:' | cut -d: -f2 | cut -d'|' -f1)
    cpu_pct=$(echo "$stats" | grep '^cpu:' | cut -d'|' -f2)
    mem_val=$(echo "$stats" | grep '^mem:' | cut -d: -f2 | cut -d'|' -f1)
    mem_pct=$(echo "$stats" | grep '^mem:' | cut -d'|' -f2)
    storage_val=$(echo "$stats" | grep '^storage:' | cut -d: -f2 | cut -d'|' -f1)
    storage_pct=$(echo "$stats" | grep '^storage:' | cut -d'|' -f2)
    external_val=$(echo "$stats" | grep '^external:' | cut -d: -f2 | cut -d'|' -f1)
    external_pct=$(echo "$stats" | grep '^external:' | cut -d'|' -f2)

    format_usage "CPU Usage:" "$cpu_val" "$cpu_pct"
    format_usage "Memory Usage:" "$mem_val" "$mem_pct"
    format_usage "Storage Usage:" "$storage_val" "$storage_pct"
    format_usage "External Usage:" "$external_val" "$external_pct"
    echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    help|--help|-h)
        usage
        ;;
    "")
        usage
        ;;
    *)
        cmd_monitor "$1"
        ;;
esac
