#!/usr/bin/env zsh

# ANSI colour tokens

BLACK='\033[0;30m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREY='\033[90m'

YELLOW_B='\033[1;33m'
BLUE_B='\033[1;34m'

WHITE='\033[0;37m'
BOLD='\033[1;37m'
NC='\033[0m'

# Styles (must come after colors in output strings)
ITALIC="\033[3m"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

error() {
    echo "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo "${GREEN}$1${NC}"
}

info() {
    echo "${CYAN}$1${NC}"
}

warn() {
    echo "${YELLOW}$1${NC}"
}

# Strikethrough tokens

ST='\e[9m'
NST='\e[0m'

# ─────────────────────────────────────────────────────────────────────────────
# OS detection
# ─────────────────────────────────────────────────────────────────────────────

ZU_IS_MACOS=0
[[ "$(uname -s)" == "Darwin" ]] && ZU_IS_MACOS=1

# ─────────────────────────────────────────────────────────────────────────────
# File utilities
# ─────────────────────────────────────────────────────────────────────────────

# Detect fastest available hash command (xxhash is 5-10x faster than md5)
if command -v xxhsum &>/dev/null; then
    ZU_HASH_CMD="xxhsum"
elif command -v xxh64sum &>/dev/null; then
    ZU_HASH_CMD="xxh64sum"
elif [[ $ZU_IS_MACOS -eq 1 ]]; then
    ZU_HASH_CMD="md5 -r"
else
    ZU_HASH_CMD="md5sum"
fi

# Get file hash
# Usage: zu_file_hash <file>
zu_file_hash() {
    $ZU_HASH_CMD "$1" 2>/dev/null | cut -d' ' -f1
}

# Get file size in bytes (portable)
# Usage: zu_file_size <file>
zu_file_size() {
    if [[ $ZU_IS_MACOS -eq 1 ]]; then
        stat -f '%z' "$1" 2>/dev/null
    else
        stat -c '%s' "$1" 2>/dev/null
    fi
}

# Get file modification time (portable)
# Usage: zu_file_mtime <file>
zu_file_mtime() {
    if [[ $ZU_IS_MACOS -eq 1 ]]; then
        stat -f '%Sm' -t '%Y:%m:%d %H:%M:%S' "$1" 2>/dev/null
    else
        stat -c '%y' "$1" 2>/dev/null | sed 's/-/:/g; s/\.[0-9]*//'
    fi
}

# Display a progress bar
# Usage: zu_progress_bar <current> <total>
zu_progress_bar() {
    local current="$1"
    local total="$2"
    local width=40
    local pct=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))

    printf "\r  [%s%s] %d/%d (%d%%)" \
        "$(printf '#%.0s' $(seq 1 $filled 2>/dev/null))" \
        "$(printf '.%.0s' $(seq 1 $empty 2>/dev/null))" \
        "$current" "$total" "$pct"
}

# Find files with sizes (portable)
# Usage: zu_find_with_sizes <dir> [separator]
# Output: size<sep>path per line (default separator is tab)
zu_find_with_sizes() {
    local dir="$1"
    local sep="${2:-	}"  # default tab
    if [[ $ZU_IS_MACOS -eq 1 ]]; then
        /usr/bin/find "$dir" -type f -exec stat -f "%z${sep}%N" {} + 2>/dev/null
    else
        /usr/bin/find "$dir" -type f -printf "%s${sep}%p\n" 2>/dev/null
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Encryption helpers (requires openssl)
# ─────────────────────────────────────────────────────────────────────────────

# Generate HMAC-SHA256 of data
# Usage: zu_hmac <data> <password>
zu_hmac() {
    local data="$1"
    local password="$2"
    printf '%s' "$data" | openssl dgst -sha256 -hmac "$password" -binary | xxd -p -c 64
}

# Encrypt data using AES-256-CBC with PBKDF2 and HMAC (encrypt-then-MAC)
# Output format: <base64_ciphertext>.<hmac_hex>
# Usage: zu_encrypt <data> <password>
zu_encrypt() {
    local data="$1"
    local password="$2"
    local ciphertext=$(printf '%s' "$data" | openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass "pass:$password" -base64 -A)
    local hmac=$(zu_hmac "$ciphertext" "$password")
    printf '%s.%s' "$ciphertext" "$hmac"
}

# Decrypt data using AES-256-CBC with PBKDF2, verifying HMAC first
# Usage: zu_decrypt <encrypted_file> <password>
# Returns decrypted data on success, empty string on failure
zu_decrypt() {
    local file="$1"
    local password="$2"
    if [[ ! -f "$file" ]]; then
        echo "{}"
        return 0
    fi
    local content=$(cat "$file")

    # Check for HMAC format (contains .)
    if [[ "$content" == *.* ]]; then
        local ciphertext="${content%.*}"
        local stored_hmac="${content##*.}"
        local computed_hmac=$(zu_hmac "$ciphertext" "$password")
        if [[ "$stored_hmac" != "$computed_hmac" ]]; then
            return 1  # HMAC verification failed
        fi
        content="$ciphertext"
    fi
    # Legacy format without HMAC still supported for migration

    local decrypted
    decrypted=$(printf '%s' "$content" | openssl enc -aes-256-cbc -d -salt -pbkdf2 -iter 100000 -pass "pass:$password" -base64 -A 2>/dev/null)
    if [[ $? -ne 0 ]] || [[ -z "$decrypted" ]]; then
        return 1
    fi
    printf '%s' "$decrypted"
    return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# Time and duration parsing
# ─────────────────────────────────────────────────────────────────────────────

# Parse time string (HH:MM) to minutes since midnight
# Usage: zu_parse_time <time>
zu_parse_time() {
    local time="$1"
    if ! [[ "$time" =~ ^([0-1]?[0-9]|2[0-3]):([0-5][0-9])$ ]]; then
        error "Invalid time format: $time (use HH:MM)"
    fi
    local hours="${time%%:*}"
    local mins="${time##*:}"
    # Remove leading zeros to avoid octal interpretation
    hours=$((10#$hours))
    mins=$((10#$mins))
    echo $((hours * 60 + mins))
}

# Check if current time is within a schedule (HH:MM-HH:MM)
# Usage: zu_is_schedule_active <schedule>
zu_is_schedule_active() {
    local schedule="$1"
    local start="${schedule%%-*}"
    local end="${schedule##*-}"

    local start_mins=$(zu_parse_time "$start")
    local end_mins=$(zu_parse_time "$end")
    local now_mins=$(( $(date +%H) * 60 + $(date +%M) ))
    # Remove leading zeros
    now_mins=$((10#$now_mins))

    if [[ $start_mins -le $end_mins ]]; then
        # Normal range (e.g., 09:00-17:00)
        [[ $now_mins -ge $start_mins && $now_mins -lt $end_mins ]]
    else
        # Crosses midnight (e.g., 22:00-06:00)
        [[ $now_mins -ge $start_mins || $now_mins -lt $end_mins ]]
    fi
}

# Parse duration string to seconds
# Usage: zu_parse_duration <duration>
# Supports: s (seconds), m (minutes), h (hours), d (days), w (weeks)
zu_parse_duration() {
    local duration="$1"
    local value="${duration%[smhdw]}"
    local unit="${duration: -1}"

    if ! [[ "$value" =~ ^[0-9]+$ ]]; then
        error "Invalid duration format: $duration"
    fi

    case "$unit" in
        s) echo $((value)) ;;
        m) echo $((value * 60)) ;;
        h) echo $((value * 3600)) ;;
        d) echo $((value * 86400)) ;;
        w) echo $((value * 604800)) ;;
        *) error "Invalid duration unit: $unit (use s, m, h, d, or w)" ;;
    esac
}

# Format seconds as human-readable duration
# Usage: zu_format_duration <seconds>
zu_format_duration() {
    local seconds="$1"

    if [[ $seconds -lt 0 ]]; then
        echo "expired"
        return
    fi

    local days=$((seconds / 86400))
    local hours=$(((seconds % 86400) / 3600))
    local minutes=$(((seconds % 3600) / 60))
    local secs=$((seconds % 60))

    local result=""
    [[ $days -gt 0 ]] && result+="${days}d "
    [[ $hours -gt 0 ]] && result+="${hours}h "
    [[ $minutes -gt 0 ]] && result+="${minutes}m "
    [[ $secs -gt 0 && $days -eq 0 && $hours -eq 0 ]] && result+="${secs}s"

    echo "${result% }"
}

# Menu selector function

function menu {

  _blink_on()     { echo -ne "\033[?25h"; }
  _blink_off()    { echo -ne "\033[?25l"; }
  _move_up()      { echo -ne "\033[${1:-1}A"; }
  _other_opt()    { echo -ne "   $1 "; }
  _selected_opt() { echo -ne " ${BOLD}→ $1${NC} "; }
  _input() {
    read -s -k1 key
    case $key in
      $'\e')
        read -s -k2 key
        case $key in
          '[A') echo up;;
          '[B') echo down;;
        esac
        ;;
      $'\n'|$'\r') echo enter;;
    esac
  }

  for opt in "$@"; do printf "\n"; done

  trap "_blink_on; stty echo; printf '\n'; exit" 2
  _blink_off

  local curr=0
  while true; do

    _move_up $#
    local idx=0
    for opt; do
      echo
      if [ $idx -eq $curr ]; then
        _selected_opt "$opt"
      else
        _other_opt "$opt"
      fi
      ((idx++))
    done

    case `_input` in
      enter) break;;
      up)    ((curr--));
             if [ $curr -lt 0 ]; then curr=$(($# - 1)); fi;;
      down)  ((curr++));
             if [ $curr -ge $# ]; then curr=0; fi;;
    esac

  done

  echo
  _blink_on

  return $curr

}

# ─────────────────────────────────────────────────────────────────────────────
# Service management (launchd)
# ─────────────────────────────────────────────────────────────────────────────

_zu_require_macos() {
    if [[ "$OSTYPE" != darwin* ]]; then
        error "Service management requires macOS."
    fi
}

ZU_USER_AGENTS_DIR="$HOME/Library/LaunchAgents"
ZU_SYSTEM_DAEMONS_DIR="/Library/LaunchDaemons"

# Get plist path for a service
# Usage: zu_service_path <label> [user|system]
zu_service_path() {
    local label="$1"
    local level="${2:-user}"

    if [[ "$level" == "system" ]]; then
        echo "$ZU_SYSTEM_DAEMONS_DIR/${label}.plist"
    else
        echo "$ZU_USER_AGENTS_DIR/${label}.plist"
    fi
}

# Check if a service plist exists
# Usage: zu_service_exists <label> [user|system]
zu_service_exists() {
    local label="$1"
    local level="${2:-user}"
    [[ -f "$(zu_service_path "$label" "$level")" ]]
}

# Get the last exit code of a service (0 = healthy, non-zero = error)
# Usage: zu_service_exit_code <label>
# Returns: exit code, or empty string if service not registered
zu_service_exit_code() {
    local label="$1"
    local info=$(launchctl list "$label" 2>/dev/null)
    local raw=$(echo "$info" | awk '/LastExitStatus/ {print $3}' | tr -d ';')
    [[ -n "$raw" ]] && echo $((raw / 256))
}

# Check if a service is healthy (exists and last exit was 0)
# Usage: zu_service_healthy <label> [user|system]
zu_service_healthy() {
    local label="$1"
    local level="${2:-user}"
    zu_service_exists "$label" "$level" || return 1
    local code=$(zu_service_exit_code "$label")
    [[ -z "$code" ]] || [[ "$code" -eq 0 ]]
}

# Load a service
# Usage: zu_service_load <label> [user|system]
zu_service_load() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    if [[ "$level" == "system" ]]; then
        sudo launchctl load "$plist_path" 2>/dev/null
    else
        launchctl load "$plist_path" 2>/dev/null
    fi
}

# Unload a service
# Usage: zu_service_unload <label> [user|system]
zu_service_unload() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    if [[ "$level" == "system" ]]; then
        sudo launchctl unload "$plist_path" 2>/dev/null
    else
        launchctl unload "$plist_path" 2>/dev/null
    fi
}

# Remove a service (unload + delete plist)
# Usage: zu_service_remove <label> [user|system]
zu_service_remove() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    zu_service_unload "$label" "$level"

    if [[ "$level" == "system" ]]; then
        sudo rm -f "$plist_path"
    else
        rm -f "$plist_path"
    fi
}

# Reload a service (unload + load)
# Usage: zu_service_reload <label> [user|system]
zu_service_reload() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"

    zu_service_unload "$label" "$level"
    zu_service_load "$label" "$level"
}

# Create a service plist
# Usage: zu_service_create <label> <script> [options] [-- <args>...]
#   --type <type>          run_at_load (default), keep_alive, interval:N, calendar:HH:MM
#   --level user|system    User or system service (default: user)
#   --log <path>           Log file path
#   --env <KEY=val>...     Environment variables
#   -- <args>...           Arguments to pass to script (must be last)
zu_service_create() {
    _zu_require_macos
    local label="$1"
    local script="$2"
    shift 2

    local -a args=()
    local type="run_at_load"
    local level="user"
    local log_path=""
    local -a env_vars=()

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --)
                shift
                # Everything after -- is a script argument
                args+=("$@")
                break
                ;;
            --type)
                type="$2"
                shift 2
                ;;
            --level)
                level="$2"
                shift 2
                ;;
            --log)
                log_path="$2"
                shift 2
                ;;
            --env)
                shift
                while [[ $# -gt 0 && "$1" != --* ]]; do
                    env_vars+=("$1")
                    shift
                done
                ;;
            *)
                shift
                ;;
        esac
    done

    local plist_path="$(zu_service_path "$label" "$level")"

    # Ensure directory exists
    if [[ "$level" == "system" ]]; then
        sudo mkdir -p "$(dirname "$plist_path")"
    else
        mkdir -p "$(dirname "$plist_path")"
    fi

    # Build plist content
    local plist="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$script</string>"

    for arg in "${args[@]}"; do
        plist+="
        <string>$arg</string>"
    done

    plist+="
    </array>"

    # Schedule type
    case "$type" in
        run_at_load)
            plist+="
    <key>RunAtLoad</key>
    <true/>"
            ;;
        keep_alive)
            plist+="
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>"
            ;;
        interval:*)
            local seconds="${type#interval:}"
            plist+="
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>$seconds</integer>"
            ;;
        calendar:*)
            local time="${type#calendar:}"
            local hour="${time%%:*}"
            local minute="${time#*:}"
            plist+="
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>$hour</integer>
        <key>Minute</key>
        <integer>$minute</integer>
    </dict>"
            ;;
    esac

    # Log paths
    if [[ -n "$log_path" ]]; then
        plist+="
    <key>StandardOutPath</key>
    <string>$log_path</string>
    <key>StandardErrorPath</key>
    <string>$log_path</string>"
    fi

    # Environment variables
    if [[ ${#env_vars[@]} -gt 0 ]]; then
        plist+="
    <key>EnvironmentVariables</key>
    <dict>"
        for env in "${env_vars[@]}"; do
            local key="${env%%=*}"
            local value="${env#*=}"
            plist+="
        <key>$key</key>
        <string>$value</string>"
        done
        plist+="
    </dict>"
    fi

    plist+="
</dict>
</plist>"

    # Write plist
    if [[ "$level" == "system" ]]; then
        echo "$plist" | sudo tee "$plist_path" > /dev/null
        sudo chmod 644 "$plist_path"
        sudo chown root:wheel "$plist_path"
    else
        echo "$plist" > "$plist_path"
        chmod 644 "$plist_path"
    fi
}
