#!/usr/bin/env zsh

# ANSI colour tokens

BLACK='\033[0;30m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREY='\033[90m'

YELLOW_B='\033[1;33m'
BLUE_B='\033[1;34m'

WHITE='\033[0;37m'
BOLD='\033[1;37m'
NC='\033[0m'

# Styles (must come after colors in output strings)
ITALIC="\033[3m"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

error() {
    echo "${RED}Error:${NC} $1" >&2
    exit 1
}

success() {
    echo "${GREEN}$1${NC}"
}

info() {
    echo "${CYAN}$1${NC}"
}

warn() {
    echo "${YELLOW}$1${NC}"
}

# Strikethrough tokens

ST='\e[9m'
NST='\e[0m'

# Menu selector function

function menu {

  _blink_on()     { echo -ne "\033[?25h"; }
  _blink_off()    { echo -ne "\033[?25l"; }
  _move_up()      { echo -ne "\033[${1:-1}A"; }
  _other_opt()    { echo -ne "   $1 "; }
  _selected_opt() { echo -ne " ${BOLD}→ $1${NC} "; }
  _input() {
    read -s -k1 key
    case $key in
      $'\e')
        read -s -k2 key
        case $key in
          '[A') echo up;;
          '[B') echo down;;
        esac
        ;;
      $'\n'|$'\r') echo enter;;
    esac
  }

  for opt in "$@"; do printf "\n"; done

  trap "_blink_on; stty echo; printf '\n'; exit" 2
  _blink_off

  local curr=0
  while true; do

    _move_up $#
    local idx=0
    for opt; do
      echo
      if [ $idx -eq $curr ]; then
        _selected_opt "$opt"
      else
        _other_opt "$opt"
      fi
      ((idx++))
    done

    case `_input` in
      enter) break;;
      up)    ((curr--));
             if [ $curr -lt 0 ]; then curr=$(($# - 1)); fi;;
      down)  ((curr++));
             if [ $curr -ge $# ]; then curr=0; fi;;
    esac

  done

  echo
  _blink_on

  return $curr

}

# ─────────────────────────────────────────────────────────────────────────────
# Service management (launchd)
# ─────────────────────────────────────────────────────────────────────────────

_zu_require_macos() {
    if [[ "$OSTYPE" != darwin* ]]; then
        error "Service management requires macOS."
    fi
}

ZU_USER_AGENTS_DIR="$HOME/Library/LaunchAgents"
ZU_SYSTEM_DAEMONS_DIR="/Library/LaunchDaemons"

# Get plist path for a service
# Usage: zu_service_path <label> [user|system]
zu_service_path() {
    local label="$1"
    local level="${2:-user}"

    if [[ "$level" == "system" ]]; then
        echo "$ZU_SYSTEM_DAEMONS_DIR/${label}.plist"
    else
        echo "$ZU_USER_AGENTS_DIR/${label}.plist"
    fi
}

# Check if a service plist exists
# Usage: zu_service_exists <label> [user|system]
zu_service_exists() {
    local label="$1"
    local level="${2:-user}"
    [[ -f "$(zu_service_path "$label" "$level")" ]]
}

# Load a service
# Usage: zu_service_load <label> [user|system]
zu_service_load() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    if [[ "$level" == "system" ]]; then
        sudo launchctl load "$plist_path" 2>/dev/null
    else
        launchctl load "$plist_path" 2>/dev/null
    fi
}

# Unload a service
# Usage: zu_service_unload <label> [user|system]
zu_service_unload() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    if [[ "$level" == "system" ]]; then
        sudo launchctl unload "$plist_path" 2>/dev/null
    else
        launchctl unload "$plist_path" 2>/dev/null
    fi
}

# Remove a service (unload + delete plist)
# Usage: zu_service_remove <label> [user|system]
zu_service_remove() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"
    local plist_path="$(zu_service_path "$label" "$level")"

    zu_service_unload "$label" "$level"

    if [[ "$level" == "system" ]]; then
        sudo rm -f "$plist_path"
    else
        rm -f "$plist_path"
    fi
}

# Reload a service (unload + load)
# Usage: zu_service_reload <label> [user|system]
zu_service_reload() {
    _zu_require_macos
    local label="$1"
    local level="${2:-user}"

    zu_service_unload "$label" "$level"
    zu_service_load "$label" "$level"
}

# Create a service plist
# Usage: zu_service_create <label> <script> [options]
#   --args <arg>...        Arguments to pass to script
#   --type <type>          run_at_load (default), keep_alive, interval:N, calendar:HH:MM
#   --level user|system    User or system service (default: user)
#   --log <path>           Log file path
#   --env <KEY=val>...     Environment variables
zu_service_create() {
    _zu_require_macos
    local label="$1"
    local script="$2"
    shift 2

    local -a args=()
    local type="run_at_load"
    local level="user"
    local log_path=""
    local -a env_vars=()

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --args)
                shift
                while [[ $# -gt 0 && "$1" != --* ]]; do
                    args+=("$1")
                    shift
                done
                ;;
            --type)
                type="$2"
                shift 2
                ;;
            --level)
                level="$2"
                shift 2
                ;;
            --log)
                log_path="$2"
                shift 2
                ;;
            --env)
                shift
                while [[ $# -gt 0 && "$1" != --* ]]; do
                    env_vars+=("$1")
                    shift
                done
                ;;
            *)
                shift
                ;;
        esac
    done

    local plist_path="$(zu_service_path "$label" "$level")"

    # Ensure directory exists
    if [[ "$level" == "system" ]]; then
        sudo mkdir -p "$(dirname "$plist_path")"
    else
        mkdir -p "$(dirname "$plist_path")"
    fi

    # Build plist content
    local plist="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$script</string>"

    for arg in "${args[@]}"; do
        plist+="
        <string>$arg</string>"
    done

    plist+="
    </array>"

    # Schedule type
    case "$type" in
        run_at_load)
            plist+="
    <key>RunAtLoad</key>
    <true/>"
            ;;
        keep_alive)
            plist+="
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>"
            ;;
        interval:*)
            local seconds="${type#interval:}"
            plist+="
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>$seconds</integer>"
            ;;
        calendar:*)
            local time="${type#calendar:}"
            local hour="${time%%:*}"
            local minute="${time#*:}"
            plist+="
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>$hour</integer>
        <key>Minute</key>
        <integer>$minute</integer>
    </dict>"
            ;;
    esac

    # Log paths
    if [[ -n "$log_path" ]]; then
        plist+="
    <key>StandardOutPath</key>
    <string>$log_path</string>
    <key>StandardErrorPath</key>
    <string>$log_path</string>"
    fi

    # Environment variables
    if [[ ${#env_vars[@]} -gt 0 ]]; then
        plist+="
    <key>EnvironmentVariables</key>
    <dict>"
        for env in "${env_vars[@]}"; do
            local key="${env%%=*}"
            local value="${env#*=}"
            plist+="
        <key>$key</key>
        <string>$value</string>"
        done
        plist+="
    </dict>"
    fi

    plist+="
</dict>
</plist>"

    # Write plist
    if [[ "$level" == "system" ]]; then
        echo "$plist" | sudo tee "$plist_path" > /dev/null
        sudo chmod 644 "$plist_path"
        sudo chown root:wheel "$plist_path"
    else
        echo "$plist" > "$plist_path"
        chmod 644 "$plist_path"
    fi
}
