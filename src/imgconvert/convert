#!/usr/bin/env zsh

# convert - Shared image/PDF conversion backend for the png and jpg commands.
# Dispatches on the invocation name (${0:t}): invoked as 'png' it targets PNG,
# as 'jpg' it targets JPEG. Uses macOS built-in tools (sips, qlmanage) - no
# dependencies.
#
# Hamish M. Blair

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Determine target format from how we were invoked
CMD="${0:t}"
case "$CMD" in
    png) TARGET_EXT="png"; SIPS_FORMAT="png" ;;
    jpg) TARGET_EXT="jpg"; SIPS_FORMAT="jpeg" ;;
    *)   error "Unknown invocation name: $CMD (expected png or jpg)" ;;
esac

usage() {
    if [[ "$TARGET_EXT" == "jpg" ]]; then
        cat << EOF
Usage: jpg <file>...

Convert images and PDFs to JPEG format.

Supported formats: png, jpeg, gif, tiff, bmp, pdf, heic, webp

Options:
  -o, --output <dir>     Output directory (default: same as input)
  -s, --size <pixels>    Max dimension in pixels (default: 2000 for PDF, original for images)
  -q, --quality <1-100>  JPEG quality (default: 90)
  -h, --help             Show this help

Examples:
  jpg photo.png              # Creates photo.jpg
  jpg scan.pdf               # Creates scan.jpg (2000px)
  jpg -q 75 *.png            # Convert with lower quality
  jpg -s 800 *.heic          # Resize to max 800px
  jpg -o ~/Desktop *.heic    # Convert all HEIC files, output to Desktop
EOF
    else
        cat << EOF
Usage: png <file>...

Convert images and PDFs to PNG format.

Supported formats: jpeg, jpg, gif, tiff, bmp, pdf, heic, webp

Options:
  -o, --output <dir>   Output directory (default: same as input)
  -s, --size <pixels>  Max dimension in pixels (default: 2000 for PDF, original for images)
  -h, --help           Show this help

Examples:
  png photo.jpg              # Creates photo.png (original size)
  png scan.pdf               # Creates scan.png (2000px)
  png -s 4000 doc.pdf        # Higher resolution PDF
  png -s 800 *.heic          # Resize images to max 800px
  png -o ~/Desktop *.heic    # Convert all HEIC files, output to Desktop
EOF
    fi
}

# Encode an image file to the target format with sips
sips_encode() {
    local src="$1"
    local out="$2"
    local size="$3"
    local quality="$4"

    local args=(-s format "$SIPS_FORMAT")
    [[ "$TARGET_EXT" == "jpg" ]] && args+=(-s formatOptions "$quality")
    [[ -n "$size" ]] && args+=(-Z "$size")
    sips "${args[@]}" "$src" --out "$out" &>/dev/null
}

convert_file() {
    local input="$1"
    local output_dir="$2"
    local size="$3"
    local quality="$4"

    if [[ ! -f "$input" ]]; then
        warn "File not found: $input"
        return 1
    fi

    local basename="${input:t:r}"
    local ext="${input:e:l}"
    local output="${output_dir}/${basename}.${TARGET_EXT}"

    # Handle name collision
    local counter=1
    while [[ -f "$output" ]]; do
        output="${output_dir}/${basename}-${counter}.${TARGET_EXT}"
        ((counter++))
    done

    case "$ext" in
        pdf)
            # sips cannot read PDFs; render to PNG with qlmanage (Quick Look),
            # then re-encode to the target format if needed.
            local pdf_size="${size:-2000}"
            local tmpdir=$(mktemp -d)
            qlmanage -t -s "$pdf_size" -o "$tmpdir" "$input" &>/dev/null
            local preview="$tmpdir/${input:t}.png"
            if [[ ! -f "$preview" ]]; then
                rm -rf "$tmpdir"
                warn "Failed to convert: $input"
                return 1
            fi
            if [[ "$TARGET_EXT" == "png" ]]; then
                mv "$preview" "$output"
            else
                # qlmanage already applied the size; re-encode without resizing
                sips_encode "$preview" "$output" "" "$quality"
                if [[ $? -ne 0 ]]; then
                    rm -rf "$tmpdir"
                    warn "Failed to convert: $input"
                    return 1
                fi
            fi
            rm -rf "$tmpdir"
            ;;
        png|jpg|jpeg|gif|tiff|tif|bmp|heic|heif|webp)
            sips_encode "$input" "$output" "$size" "$quality"
            if [[ $? -ne 0 ]]; then
                warn "Failed to convert: $input"
                return 1
            fi
            ;;
        *)
            warn "Unsupported format: $ext"
            return 1
            ;;
    esac

    echo "${GREEN}✓${NC} ${input:t} → ${output:t}"
    return 0
}

main() {
    local output_dir=""
    local size=""
    local quality="90"
    local files=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output_dir="$2"
                shift 2
                ;;
            -s|--size)
                size="$2"
                shift 2
                ;;
            -q|--quality)
                [[ "$TARGET_EXT" == "jpg" ]] || error "Unknown option: $1"
                quality="$2"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                files+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#files[@]} -eq 0 ]]; then
        usage
        exit 1
    fi

    local success=0
    local failed=0

    for file in "${files[@]}"; do
        local dir="${output_dir:-${file:h}}"
        [[ "$dir" == "." ]] && dir="$(pwd)"
        mkdir -p "$dir"

        if convert_file "$file" "$dir" "$size" "$quality"; then
            ((success++))
        else
            ((failed++))
        fi
    done

    if [[ ${#files[@]} -gt 1 ]]; then
        echo ""
        [[ $success -gt 0 ]] && echo "Converted: $success"
        [[ $failed -gt 0 ]] && echo "${YELLOW}Failed: $failed${NC}"
    fi
}

main "$@"
