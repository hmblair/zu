cmd_mount() {
    check_setup

    local NAME=""
    local ARCHIVE=""
    local MOUNTPOINT=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--archive)
                ARCHIVE="$2"
                shift 2
                ;;
            -m|--mountpoint)
                MOUNTPOINT="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$NAME" ]]; then
                    NAME="$1"
                else
                    error "Too many arguments. Use -a/--archive and -m/--mountpoint."
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup mount <name> [-a archive] [-m mountpoint]"
    fi

    if ! config_exists "$NAME"; then
        error "Backup '$NAME' not found"
    fi

    load_config "$NAME"

    export BORG_PASSPHRASE=$(<"$PASS_FILE")
    local REPO="$REMOTE_USER@$HOST:$HOST_DIR"

    # Check if borg mount is available (requires FUSE)
    if ! /opt/homebrew/bin/borg mount --help &>/dev/null; then
        error "borg mount not available. Install macFUSE: brew install macfuse"
    fi

    # If no archive specified, use latest
    if [[ -z "$ARCHIVE" ]]; then
        info "Finding latest archive..."
        ARCHIVE=$(/opt/homebrew/bin/borg list --last 1 --format '{archive}' "$REPO" 2>&1)
        if [[ $? -ne 0 ]]; then
            echo "$ARCHIVE" >&2
            error "Failed to list archives"
        fi
        if [[ -z "$ARCHIVE" ]]; then
            error "No archives found in repository"
        fi
        echo "Using archive: $ARCHIVE"
    fi

    # Verify archive exists
    info "Verifying archive '$ARCHIVE'..."
    local archive_check
    archive_check=$(/opt/homebrew/bin/borg info "$REPO::$ARCHIVE" 2>&1)
    if [[ $? -ne 0 ]]; then
        echo "$archive_check" >&2
        error "Archive '$ARCHIVE' not found or inaccessible"
    fi

    # Default mountpoint
    if [[ -z "$MOUNTPOINT" ]]; then
        MOUNTPOINT="/tmp/bkup-$NAME"
    fi

    # Check if already mounted (non-empty directory that we didn't just create)
    if [[ -d "$MOUNTPOINT" ]] && [[ -n "$(ls -A "$MOUNTPOINT" 2>/dev/null)" ]]; then
        error "Mountpoint is not empty: $MOUNTPOINT. Run 'bkup unmount $NAME' first."
    fi

    # Create mountpoint if needed
    if [[ ! -d "$MOUNTPOINT" ]]; then
        info "Creating mountpoint $MOUNTPOINT..."
        if ! mkdir -p "$MOUNTPOINT"; then
            error "Failed to create mountpoint: $MOUNTPOINT"
        fi
    fi


    # Mount the archive
    info "Mounting $NAME::$ARCHIVE to $MOUNTPOINT..."
    local mount_output
    mount_output=$(/opt/homebrew/bin/borg mount "$REPO::$ARCHIVE" "$MOUNTPOINT" 2>&1)
    if [[ $? -ne 0 ]]; then
        echo "$mount_output" >&2
        error "Failed to mount archive"
    fi

    # Verify mount succeeded (check if mountpoint has content)
    if [[ -z "$(ls -A "$MOUNTPOINT" 2>/dev/null)" ]]; then
        error "Mount command succeeded but $MOUNTPOINT appears empty"
    fi

    # Find the actual content path (skip single-child directories)
    local content_path="$MOUNTPOINT"
    while true; do
        local children=("$content_path"/*(N))
        if [[ ${#children[@]} -eq 1 ]] && [[ -d "${children[1]}" ]]; then
            content_path="${children[1]}"
        else
            break
        fi
    done

    echo ""
    success "Mounted at $MOUNTPOINT"
    echo ""
    if [[ "$content_path" != "$MOUNTPOINT" ]]; then
        echo "Content at:   $content_path"
        echo "Browse with:  l $content_path"
    else
        echo "Browse with:  l $MOUNTPOINT"
    fi
    echo "Unmount with: bkup unmount $NAME"
}

cmd_unmount() {
    local NAME="$1"

    # If no name provided, unmount all
    if [[ -z "$NAME" ]]; then
        local found=false
        for mountpoint in /tmp/bkup-*(N); do
            [[ -d "$mountpoint" ]] || continue
            local backup_name="${mountpoint#/tmp/bkup-}"
            found=true
            cmd_unmount "$backup_name"
        done
        if ! $found; then
            echo "${YELLOW}No backups mounted${NC}"
        fi
        return 0
    fi

    local MOUNTPOINT="/tmp/bkup-$NAME"

    # Check if mounted (has content)
    if [[ ! -d "$MOUNTPOINT" ]]; then
        error "Mountpoint doesn't exist: $MOUNTPOINT"
    fi

    if [[ -z "$(ls -A "$MOUNTPOINT" 2>/dev/null)" ]]; then
        info "Mountpoint exists but appears empty. Cleaning up..."
        rmdir "$MOUNTPOINT" 2>/dev/null
        success "Cleaned up stale mountpoint"
        return 0
    fi

    info "Unmounting $MOUNTPOINT..."

    # Try fusermount first (Linux), then umount (macOS)
    local unmount_output
    if command -v fusermount &>/dev/null; then
        unmount_output=$(fusermount -u "$MOUNTPOINT" 2>&1)
    else
        unmount_output=$(umount "$MOUNTPOINT" 2>&1)
    fi

    if [[ $? -ne 0 ]]; then
        echo "$unmount_output" >&2
        echo ""
        echo "If the mount is busy, try:"
        echo "  - Close any terminals or programs using $MOUNTPOINT"
        echo "  - Run: umount -f $MOUNTPOINT"
        error "Failed to unmount"
    fi

    # Clean up mountpoint
    if [[ -d "$MOUNTPOINT" ]]; then
        rmdir "$MOUNTPOINT" 2>/dev/null
    fi

    success "Unmounted $MOUNTPOINT"
}

cmd_test() {
    check_setup

    local NAME="$1"
    local configs=()

    if [[ -n "$NAME" ]]; then
        if ! config_exists "$NAME"; then
            error "Backup '$NAME' not found."
        fi
        configs=("$(config_path "$NAME")")
    else
        # Test all backups
        if [[ ! -d "$BACKUPS_DIR" ]] || [[ -z "$(ls -A "$BACKUPS_DIR" 2>/dev/null)" ]]; then
            echo "No backup configurations found."
            return
        fi
        configs=("$BACKUPS_DIR"/*.json)
    fi

    export BORG_PASSPHRASE=$(<"$PASS_FILE")
    local all_ok=true

    echo ""
    for config_file in "${configs[@]}"; do
        [[ ! -f "$config_file" ]] && continue
        local name=$(basename "$config_file" .json)

        # Load config values in a single python3 call
        local test_vals=$(python3 -c "
import json
c = json.load(open('$config_file'))
print(c['user'])
print(c['host'])
print(c['dest'])
print('\x00'.join(c['dirs']))
print('\x00'.join(c.get('excludes', [])))
")
        local -a tv=("${(@f)test_vals}")
        local user="${tv[1]}"
        local host="${tv[2]}"
        local dest="${tv[3]}"
        local dirs=("${(@s:\x00:)tv[4]}")
        local excludes=("${(@s:\x00:)tv[5]}")

        echo "${BOLD}Testing '$name'${NC}"
        echo "─────────────────────────────────────────"

        local ok=true

        # Test SSH connection
        printf "  SSH connection to %s@%s... " "$user" "$host"
        if ssh -o BatchMode=yes -o ConnectTimeout=5 "$user@$host" "true" 2>/dev/null; then
            echo "${GREEN}OK${NC}"
        else
            echo "${RED}FAILED${NC}"
            ok=false
        fi

        # Test repository access
        printf "  Repository %s... " "$dest"
        local repo="$user@$host:$dest"
        local repo_tmpfile=$(mktemp)
        /opt/homebrew/bin/borg info "$repo" >"$repo_tmpfile" 2>&1
        local repo_status=$?
        local repo_output=$(<"$repo_tmpfile")
        rm -f "$repo_tmpfile"
        if [[ $repo_status -eq 0 ]]; then
            echo "${GREEN}OK${NC}"
        else
            if echo "$repo_output" | grep -qi "passphrase\|wrong key\|decryption\|invalid key"; then
                echo "${RED}WRONG PASSPHRASE${NC}"
            elif echo "$repo_output" | grep -qi "does not exist\|not found\|no such file"; then
                echo "${RED}NOT FOUND${NC} (repository doesn't exist at this path)"
            elif echo "$repo_output" | grep -qi "not a valid repository\|invalid repository"; then
                echo "${RED}INVALID${NC} (path exists but is not a borg repository)"
            elif echo "$repo_output" | grep -qi "permission denied"; then
                echo "${RED}PERMISSION DENIED${NC}"
            elif echo "$repo_output" | grep -qi "lock"; then
                if pgrep -f "borg.*$dest" >/dev/null 2>&1; then
                    echo "${YELLOW}BACKUP IN PROGRESS${NC}"
                else
                    echo "${RED}STALE LOCK${NC} (run: borg break-lock $repo)"
                fi
            else
                echo "${RED}FAILED${NC}"
                echo "$repo_output" | head -3 | sed 's/^/    /'
            fi
            ok=false
        fi

        # Check repository health
        if $ok; then
            printf "  Repository health... "
            local check_tmpfile=$(mktemp)
            /opt/homebrew/bin/borg check "$repo" >"$check_tmpfile" 2>&1
            local check_status=$?
            local check_output=$(<"$check_tmpfile")
            rm -f "$check_tmpfile"
            if [[ $check_status -eq 0 ]]; then
                echo "${GREEN}OK${NC}"
            elif [[ $check_status -eq 1 ]]; then
                echo "${YELLOW}WARNINGS${NC}"
                echo "$check_output" | sed 's/^/    /'
            else
                echo "${RED}ERRORS${NC}"
                echo "$check_output" | sed 's/^/    /'
                ok=false
            fi
        fi

        # Check for repo lock (would block next backup)
        if $ok; then
            printf "  Repository lock... "
            if /opt/homebrew/bin/borg info "$repo" 2>&1 | grep -q "lock"; then
                if pgrep -f "borg.*$dest" >/dev/null 2>&1; then
                    echo "${YELLOW}BACKUP IN PROGRESS${NC} (skipping remaining checks)"
                    echo ""
                    continue
                else
                    echo "${RED}STALE LOCK${NC} (run: borg break-lock $repo)"
                    ok=false
                fi
            else
                echo "${GREEN}OK${NC}"
            fi
        fi

        # Test source directories
        for dir in "${dirs[@]}"; do
            printf "  Source %s... " "$dir"
            if [[ -d "$dir" ]]; then
                echo "${GREEN}OK${NC}"
            elif [[ -e "$dir" ]]; then
                echo "${YELLOW}exists (not a directory)${NC}"
            else
                echo "${RED}NOT FOUND${NC}"
                ok=false
            fi
        done

        # Test schedule plist
        local label="$(plist_label "$name")"
        local plist_file="$(zu_service_path "$label")"
        local bkup_path="$SCRIPT_PATH"
        printf "  Schedule plist... "
        if ! zu_service_exists "$label"; then
            echo "${RED}NOT FOUND${NC}"
            ok=false
        elif ! grep -q "<string>$bkup_path</string>" "$plist_file"; then
            echo "${RED}WRONG PATH${NC} (run 'bkup edit $name' to fix)"
            ok=false
        else
            echo "${GREEN}OK${NC}"
        fi

        # Test launchd status
        printf "  Launchd job... "
        local launchd_status=$(launchctl list "$label" 2>&1)
        if [[ $? -ne 0 ]]; then
            echo "${RED}NOT LOADED${NC} (run: launchctl load \"$plist_file\")"
            ok=false
        elif echo "$launchd_status" | grep -q '"LastExitStatus" = 127'; then
            echo "${RED}LAST RUN FAILED${NC} (command not found)"
            ok=false
        elif echo "$launchd_status" | grep -q '"LastExitStatus" = [^0]'; then
            echo "${YELLOW}LAST RUN HAD ERRORS${NC}"
        else
            echo "${GREEN}OK${NC}"
        fi

        # Dry run
        if $ok; then
            printf "  Dry run... "
            local exclude_args=()
            for exc in "${excludes[@]}"; do
                [[ -n "$exc" ]] && exclude_args+=(--exclude "$exc")
            done

            if /opt/homebrew/bin/borg create --dry-run "$repo::{now:%Y-%m-%d}" "${exclude_args[@]}" "${dirs[@]}" 2>/dev/null; then
                echo "${GREEN}OK${NC}"
            else
                echo "${RED}FAILED${NC}"
                ok=false
            fi
        fi

        if $ok; then
            echo "  ${GREEN}✓ All checks passed${NC}"
        else
            echo "  ${RED}✗ Some checks failed${NC}"
            all_ok=false
        fi
        echo ""
    done

    if $all_ok; then
        success "All backups OK"
        return 0
    else
        echo "${RED}Some backups have issues${NC}"
        return 1
    fi
}

cmd_remove() {
    local NAME="$1"

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup remove <name>"
    fi

    if ! config_exists "$NAME"; then
        error "Backup '$NAME' not found."
    fi

    # Unload and remove plist
    zu_service_remove "$(plist_label "$NAME")"

    # Remove config
    rm -f "$(config_path "$NAME")"

    success "Removed backup '$NAME'"
}

cmd_reset() {
    local names=("$@")

    # If no names provided, reset all backups
    if [[ ${#names[@]} -eq 0 ]]; then
        if [[ ! -d "$BACKUPS_DIR" ]] || [[ -z "$(ls -A "$BACKUPS_DIR" 2>/dev/null)" ]]; then
            error "No backups configured"
        fi
        for config_file in "$BACKUPS_DIR"/*.json(N); do
            names+=($(basename "$config_file" .json))
        done
    fi

    for NAME in "${names[@]}"; do
        if ! config_exists "$NAME"; then
            echo "${RED}Backup '$NAME' not found, skipping${NC}"
            continue
        fi

        local config_file="$(config_path "$NAME")"
        local label="$(plist_label "$NAME")"
        local reset_vals=$(python3 -c "import json; c=json.load(open('$config_file')); print(c.get('hour', 2)); print(c.get('minute', 0))")
        local -a rv=("${(@f)reset_vals}")
        local HOUR="${rv[1]}"
        local MINUTE="${rv[2]}"

        info "Resetting schedule for '$NAME'..."

        # Unload existing plist if present
        if zu_service_exists "$label"; then
            zu_service_unload "$label"
        fi

        # Recreate and load plist
        zu_service_create "$label" "$SCRIPT_PATH" \
            --args "run" "$NAME" \
            --type "calendar:${HOUR}:${MINUTE}" \
            --log "/tmp/bkup-$NAME.log" \
            --env "HOME=$HOME" "USER=$USER"
        zu_service_load "$label"

        success "Schedule reset to $(printf '%02d:%02d' $HOUR $MINUTE)"
    done
}

cmd_uninstall() {
    echo ""
    echo "${YELLOW}This will remove:${NC}"
    echo "  - All backup configurations"
    echo "  - All scheduled backup jobs"
    echo "  - Stored passphrase"
    echo ""
    echo "${GREY}(Remote repositories will not be affected)${NC}"
    echo ""
    read -q "confirm?Are you sure? [y/N] "
    echo ""
    [[ "$confirm" != "y" ]] && exit 0

    info "Uninstalling bkup..."

    # Remove all backup schedules
    if [[ -d "$BACKUPS_DIR" ]]; then
        for config_file in "$BACKUPS_DIR"/*.json(N); do
            [[ -f "$config_file" ]] || continue
            local name=$(basename "$config_file" .json)
            zu_service_remove "$(plist_label "$name")"
        done
    fi
    success "Removed scheduled jobs"

    # Remove config directory (configs + passphrase)
    if [[ -d "$CONFIG_DIR" ]]; then
        rm -rf "$CONFIG_DIR"
        success "Removed configurations and passphrase"
    fi

    echo ""
    success "Uninstall complete."
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    setup)
        cmd_setup
        ;;
    add)
        shift
        cmd_add "$@"
        ;;
    edit)
        cmd_edit "$2"
        ;;
    copy)
        cmd_copy "$2"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    test)
        cmd_test "$2"
        ;;
    archives)
        cmd_archives "$2"
        ;;
    mount)
        shift
        cmd_mount "$@"
        ;;
    unmount)
        cmd_unmount "$2"
        ;;
    status)
        cmd_status
        ;;
    list)
        cmd_list
        ;;
    remove)
        cmd_remove "$2"
        ;;
    reset)
        shift
        cmd_reset "$@"
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h)
        usage
        ;;
    "")
        usage
        ;;
    *)
        error "Unknown command: $1. Run 'bkup help' for usage."
        ;;
esac
