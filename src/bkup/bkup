#!/usr/bin/env zsh

# bkup - Borg backup CLI wrapper
# Creates borg backups to a remote repository over SSH

SCRIPT_DIR="${0:A:h}"
SCRIPT_PATH="${0:A}"
source "$SCRIPT_DIR/../common"

# Configuration
CONFIG_DIR="$HOME/.config/bkup"
BACKUPS_DIR="$CONFIG_DIR/backups"
PASS_FILE="$CONFIG_DIR/passphrase"
DEFAULT_LOG_DIR="$CONFIG_DIR/logs"
PLIST_PREFIX="com.zu.bkup"

# SSH options for borg - keep connection alive during long transfers
export BORG_RSH="ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=5 -o TCPKeepAlive=yes"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: bkup <command> [options]"
    echo ""
    echo "Commands:"
    echo "  setup                            One-time passphrase setup"
    echo "  add <name> [options] <dirs...>   Create and schedule a backup"
    echo "  edit <name>                      Edit an existing backup"
    echo "  copy <source>                    Copy a backup as a new one"
    echo "  run <name>                       Run a backup manually"
    echo "  test [name]                      Test backup connectivity and paths"
    echo "  archives <name>                  List backup archives (snapshots)"
    echo "  files <name> [archive] [opts]    List files in an archive"
    echo "  status                           Show last run status of all backups"
    echo "  list                             List all backup configurations"
    echo "  remove <name>                    Remove a backup and its schedule"
    echo "  uninstall                        Remove passphrase and all backups"
    echo ""
    echo "Add options:"
    echo "  -u, --user <user>         SSH user for remote host"
    echo "  -H, --host <host>         SSH hostname"
    echo "  -d, --dest <dir>          Remote backup directory"
    echo "  -l, --log-dir <dir>       Local log directory"
    echo "  -e, --exclude <path>      Exclude path (can be repeated)"
    echo "  --hour <0-23>             Hour to run backup (default: 2)"
    echo "  --minute <0-59>           Minute to run backup (default: 0)"
    echo ""
    echo "Files options:"
    echo "  -p, --path <path>         Filter by path pattern"
    echo ""
    echo "Examples:"
    echo "  bkup setup"
    echo "  bkup add personal -u john -H backup.example.com -d /backups \\"
    echo "    -l ~/logs --hour 3 ~/documents ~/projects"
    echo "  bkup run personal"
    echo "  bkup archives personal"
    echo "  bkup files personal"
    echo "  bkup files personal 2025-12-01"
    echo "  bkup list"
}

# Get path to a backup config file
config_path() {
    echo "$BACKUPS_DIR/$1.json"
}

# Get plist label for a backup
plist_label() {
    echo "$PLIST_PREFIX.$1"
}

# Check if a backup config exists
config_exists() {
    [[ -f "$(config_path "$1")" ]]
}

# Check if setup has been run
check_setup() {
    if [[ ! -f "$PASS_FILE" ]]; then
        error "Passphrase not configured. Run 'bkup setup' first."
    fi
}

# Load a backup config (sets variables: REMOTE_USER, HOST, HOST_DIR, LOG_DIR, EXCLUDES, DIRS)
load_config() {
    local name="$1"
    local config_file="$(config_path "$name")"

    if [[ ! -f "$config_file" ]]; then
        error "Backup '$name' not found. Run 'bkup list' to see available backups."
    fi

    REMOTE_USER=$(python3 -c "import json; print(json.load(open('$config_file'))['user'])")
    HOST=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
    HOST_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
    LOG_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['log_dir'])")
    EXCLUDES=($(python3 -c "import json; print('\n'.join(json.load(open('$config_file')).get('excludes', [])))"))
    DIRS=($(python3 -c "import json; print('\n'.join(json.load(open('$config_file'))['dirs']))"))
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_setup() {
    if [[ -f "$PASS_FILE" ]]; then
        echo "Passphrase already configured."
        read -q "confirm?Overwrite existing passphrase? [y/N] "
        echo ""
        [[ "$confirm" != "y" ]] && exit 0
    fi

    echo ""
    echo "Enter your Borg repository passphrase."
    echo ""

    local passphrase
    local confirm_pass
    read -s "passphrase?Passphrase: "
    echo ""
    read -s "confirm_pass?Confirm passphrase: "
    echo ""

    if [[ "$passphrase" != "$confirm_pass" ]]; then
        error "Passphrases do not match."
    fi

    if [[ -z "$passphrase" ]]; then
        error "Passphrase cannot be empty."
    fi

    # Create config directory and store passphrase
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    echo -n "$passphrase" > "$PASS_FILE"
    chmod 600 "$PASS_FILE"

    echo ""
    success "Passphrase saved."
    echo "You can now add backups with 'bkup add <name> ...'."
}

cmd_add() {
    check_setup

    local NAME=""
    local REMOTE_USER=""
    local HOST=""
    local HOST_DIR=""
    local LOG_DIR=""
    local EXCLUDES=()
    local DIRS=()
    local HOUR=""
    local MINUTE=""
    local TIME=""

    # Parse any provided arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -u|--user)
                REMOTE_USER="$2"
                shift 2
                ;;
            -H|--host)
                HOST="$2"
                shift 2
                ;;
            -d|--dest)
                HOST_DIR="$2"
                shift 2
                ;;
            -l|--log-dir)
                LOG_DIR="$2"
                shift 2
                ;;
            -e|--exclude)
                EXCLUDES+=("$2")
                shift 2
                ;;
            --hour)
                HOUR="$2"
                shift 2
                ;;
            --minute)
                MINUTE="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                # First positional arg is name, rest are dirs
                if [[ -z "$NAME" ]]; then
                    NAME="$1"
                else
                    DIRS+=("$1")
                fi
                shift
                ;;
        esac
    done

    echo ""
    info "Add new backup"
    echo "─────────────────────────────────────────"

    # Prompt for missing values (vared enables arrow keys/line editing)
    if [[ -z "$NAME" ]]; then
        vared -p "Name: " NAME
        [[ -z "$NAME" ]] && error "Name is required"
    else
        echo "Name: $NAME"
    fi

    # Check if already exists
    if config_exists "$NAME"; then
        read -q "confirm?Backup '$NAME' already exists. Overwrite? [y/N] "
        echo ""
        [[ "$confirm" != "y" ]] && exit 0
        zu_service_unload "$(plist_label "$NAME")"
    fi

    if [[ -z "$REMOTE_USER" ]]; then
        vared -p "SSH user: " REMOTE_USER
        [[ -z "$REMOTE_USER" ]] && error "SSH user is required"
    fi

    if [[ -z "$HOST" ]]; then
        vared -p "SSH host: " HOST
        [[ -z "$HOST" ]] && error "SSH host is required"
    fi

    if [[ -z "$HOST_DIR" ]]; then
        vared -p "Remote directory: " HOST_DIR
        [[ -z "$HOST_DIR" ]] && error "Remote directory is required"
    fi

    if [[ -z "$LOG_DIR" ]]; then
        LOG_DIR="$DEFAULT_LOG_DIR"
        vared -p "Log directory: " LOG_DIR
    fi

    if [[ ${#DIRS[@]} -eq 0 ]]; then
        echo ""
        echo "Directories to backup:"
        while true; do
            local menu_opts=()
            for d in "${DIRS[@]}"; do
                menu_opts+=("${RED}✕${NC} $d")
            done
            menu_opts+=("${GREEN}+${NC} Add directory")
            menu_opts+=("${CYAN}✓${NC} Done")

            menu "${menu_opts[@]}"
            local choice=$?

            if [[ $choice -lt ${#DIRS[@]} ]]; then
                # Remove selected directory
                DIRS=("${DIRS[@]:0:$choice}" "${DIRS[@]:$((choice+1))}")
            elif [[ $choice -eq ${#DIRS[@]} ]]; then
                # Add new directory
                local new_dir=""
                vared -p "  New directory: " new_dir
                [[ -n "$new_dir" ]] && DIRS+=("$new_dir")
            else
                # Done
                break
            fi
        done
        [[ ${#DIRS[@]} -eq 0 ]] && error "At least one directory is required"
    fi

    echo ""
    echo "Excludes (optional):"
    while true; do
        local menu_opts=()
        for e in "${EXCLUDES[@]}"; do
            menu_opts+=("${RED}✕${NC} $e")
        done
        menu_opts+=("${GREEN}+${NC} Add exclude")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        if [[ $choice -lt ${#EXCLUDES[@]} ]]; then
            # Remove selected exclude
            EXCLUDES=("${EXCLUDES[@]:0:$choice}" "${EXCLUDES[@]:$((choice+1))}")
        elif [[ $choice -eq ${#EXCLUDES[@]} ]]; then
            # Add new exclude
            local new_exc=""
            vared -p "  New exclude: " new_exc
            [[ -n "$new_exc" ]] && EXCLUDES+=("$new_exc")
        else
            # Done
            break
        fi
    done

    # Time prompt - accept HH:MM format
    if [[ -z "$HOUR" ]] && [[ -z "$MINUTE" ]]; then
        TIME="02:00"
        vared -p "Schedule time (HH:MM): " TIME
        if [[ -z "$TIME" ]]; then
            HOUR=2
            MINUTE=0
        elif [[ "$TIME" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
            HOUR="${match[1]}"
            MINUTE="${match[2]}"
        else
            error "Invalid time format. Use HH:MM"
        fi
    fi

    # Default hour/minute if only one provided
    [[ -z "$HOUR" ]] && HOUR=2
    [[ -z "$MINUTE" ]] && MINUTE=0

    # Convert to integers (removes leading zeros)
    HOUR=$((10#$HOUR))
    MINUTE=$((10#$MINUTE))

    # Validate hour/minute
    [[ $HOUR -lt 0 ]] || [[ $HOUR -gt 23 ]] && error "Hour must be 0-23"
    [[ $MINUTE -lt 0 ]] || [[ $MINUTE -gt 59 ]] && error "Minute must be 0-59"

    # Expand paths to absolute
    LOG_DIR="${LOG_DIR:A}"
    local expanded_dirs=()
    for dir in "${DIRS[@]}"; do
        expanded_dirs+=("${dir:A}")
    done
    DIRS=("${expanded_dirs[@]}")

    local expanded_excludes=()
    for exc in "${EXCLUDES[@]}"; do
        expanded_excludes+=("${exc:A}")
    done
    EXCLUDES=("${expanded_excludes[@]}")

    # Check if borg repository exists, offer to create if not
    local REPO="$REMOTE_USER@$HOST:$HOST_DIR"
    export BORG_PASSPHRASE=$(cat "$PASS_FILE")

    echo ""
    info "Checking repository..."

    local borg_info_output
    if borg_info_output=$(/opt/homebrew/bin/borg info "$REPO" 2>&1); then
        success "Repository exists and passphrase is correct"
    else
        # Try to initialize - this will tell us if the repo exists or not
        local borg_init_output
        borg_init_output=$(/opt/homebrew/bin/borg init --encryption=repokey-blake2 "$REPO" 2>&1)
        local init_status=$?

        if [[ $init_status -eq 0 ]]; then
            success "Repository created"
        elif echo "$borg_init_output" | grep -q "already exists"; then
            # Repo exists but borg info failed - wrong passphrase
            error "Repository exists but passphrase is incorrect. Run 'bkup setup' to update passphrase."
        elif echo "$borg_init_output" | grep -qi "does not exist\|no such file\|not found"; then
            # Parent directory doesn't exist
            echo "Remote directory does not exist: $HOST_DIR"
            read -q "create_dir?Create it? [y/N] "
            echo ""
            if [[ "$create_dir" == "y" ]]; then
                info "Creating remote directory..."
                if ! ssh "$REMOTE_USER@$HOST" "mkdir -p '$HOST_DIR'"; then
                    error "Failed to create remote directory"
                fi
                # Retry init
                info "Initializing repository..."
                if ! /opt/homebrew/bin/borg init --encryption=repokey-blake2 "$REPO" 2>&1; then
                    error "Failed to initialize repository"
                fi
                success "Repository created"
            else
                error "Remote directory must exist"
            fi
        else
            # Some other error
            echo "$borg_init_output"
            error "Failed to access or create repository"
        fi
    fi

    # Create config directory
    mkdir -p "$BACKUPS_DIR"

    # Build JSON
    local excludes_json="[]"
    if [[ ${#EXCLUDES[@]} -gt 0 ]]; then
        excludes_json=$(printf '%s\n' "${EXCLUDES[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin]))")
    fi
    local dirs_json=$(printf '%s\n' "${DIRS[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin]))")

    local config_file="$(config_path "$NAME")"
    python3 -c "
import json
config = {
    'user': '$REMOTE_USER',
    'host': '$HOST',
    'dest': '$HOST_DIR',
    'log_dir': '$LOG_DIR',
    'excludes': $excludes_json,
    'dirs': $dirs_json,
    'hour': $HOUR,
    'minute': $MINUTE
}
with open('$config_file', 'w') as f:
    json.dump(config, f, indent=2)
"
    chmod 600 "$config_file"

    # Create launchd service
    local label="$(plist_label "$NAME")"

    # Check for existing plist
    if zu_service_exists "$label"; then
        echo ""
        echo "Existing schedule found for '$NAME'"
        read -q "replace_schedule?Replace it? [y/N] "
        echo ""
        [[ "$replace_schedule" != "y" ]] && exit 0
        zu_service_unload "$label"
    fi

    zu_service_create "$label" "$SCRIPT_PATH" \
        --args "run" "$NAME" \
        --type "calendar:${HOUR}:${MINUTE}" \
        --log "/tmp/bkup-$NAME.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$label"

    echo ""
    success "Added backup '$NAME'"
    echo "  Host: $REMOTE_USER@$HOST:$HOST_DIR"
    echo "  Dirs: ${DIRS[*]}"
    echo "  Schedule: $(printf '%02d:%02d' $HOUR $MINUTE) daily"
}

cmd_run() {
    check_setup

    local NAME="$1"

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup run <name>"
    fi

    load_config "$NAME"

    # Load passphrase
    export BORG_PASSPHRASE=$(cat "$PASS_FILE")

    # Set up date variables
    local MONTH=$(date +%Y-%m)
    local DAY=$(date +%d)

    # Create log directory
    local LOG_PATH="$LOG_DIR/$MONTH"
    mkdir -p "$LOG_PATH"

    # Build backup destination
    local BACKUP_DEST="$REMOTE_USER@$HOST:$HOST_DIR::{now:%Y-%m-%d}"

    # Build exclude arguments
    local EXCLUDE_ARGS=()
    for exclude in "${EXCLUDES[@]}"; do
        EXCLUDE_ARGS+=(--exclude "$exclude")
    done

    # Run backup
    info "Running backup '$NAME' to $REMOTE_USER@$HOST:$HOST_DIR"

    /opt/homebrew/bin/borg create --stats --progress \
        "$BACKUP_DEST" \
        "${EXCLUDE_ARGS[@]}" \
        "${DIRS[@]}" \
        >"$LOG_PATH/borg-$DAY.log" \
        2>&1

    local RESULT=$?
    local STATUS_DIR="$CONFIG_DIR/status"
    mkdir -p "$STATUS_DIR"

    # Record status
    local status_file="$STATUS_DIR/$NAME.json"
    local now=$(date +%s)
    local status_text="success"
    [[ $RESULT -ne 0 ]] && status_text="failed"

    python3 -c "
import json
status = {
    'timestamp': $now,
    'status': '$status_text',
    'exit_code': $RESULT,
    'log': '$LOG_PATH/borg-$DAY.log'
}
with open('$status_file', 'w') as f:
    json.dump(status, f)
"

    if [[ $RESULT -eq 0 ]]; then
        success "Backup completed successfully"
    else
        echo "${RED}Backup failed with exit code $RESULT${NC}" >&2
    fi

    # Delete logs older than one year
    local CUTOFF=$(date -v -1y +%Y-%m)
    for dir in "$LOG_DIR"/*; do
        if [[ -d "$dir" && "$(basename "$dir")" < "$CUTOFF" ]]; then
            rm -rf "$dir"
        fi
    done

    return $RESULT
}

cmd_status() {
    if [[ ! -d "$BACKUPS_DIR" ]] || [[ -z "$(ls -A "$BACKUPS_DIR" 2>/dev/null)" ]]; then
        echo "No backup configurations found."
        return
    fi

    # Load passphrase for borg info
    if [[ -f "$PASS_FILE" ]]; then
        export BORG_PASSPHRASE=$(<"$PASS_FILE")
    fi

    local STATUS_DIR="$CONFIG_DIR/status"
    local now=$(date +%s)
    local has_failures=false

    echo ""
    printf "  ${BOLD}%-15s %-14s %-12s %-18s %s${NC}\n" "BACKUP" "DAEMON" "STATUS" "LAST RUN" "SIZE (DEDUP)"
    echo "  ───────────────────────────────────────────────────────────────────────────"

    for config_file in "$BACKUPS_DIR"/*.json; do
        [[ ! -f "$config_file" ]] && continue
        local name=$(basename "$config_file" .json)
        local display_name="$name"
        # Truncate long names to 14 chars + ellipsis
        if [[ ${#name} -gt 15 ]]; then
            display_name="${name:0:14}…"
        fi
        local status_file="$STATUS_DIR/$name.json"
        local label="$(plist_label "$name")"

        # Check daemon status (pad to 15 chars to match header)
        local daemon_status="${YELLOW}✗ missing${NC}      "
        if zu_service_exists "$label"; then
            daemon_status="${GREEN}✓ installed${NC}    "
        fi

        # Get repo size
        local user=$(python3 -c "import json; print(json.load(open('$config_file'))['user'])")
        local host=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
        local dest=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
        local repo="$user@$host:$dest"
        local repo_size="-"
        local info_tmpfile=$(mktemp)
        /opt/homebrew/bin/borg info "$repo" >"$info_tmpfile" 2>/dev/null
        if [[ $? -eq 0 ]]; then
            repo_size=$(grep "All archives:" "$info_tmpfile" | awk '{print $(NF-1), $NF}')
            [[ -z "$repo_size" ]] && repo_size="-"
        fi
        rm -f "$info_tmpfile"

        if [[ -f "$status_file" ]]; then
            local run_status=$(python3 -c "import json; print(json.load(open('$status_file'))['status'])")
            local timestamp=$(python3 -c "import json; print(json.load(open('$status_file'))['timestamp'])")
            local log=$(python3 -c "import json; print(json.load(open('$status_file'))['log'])")

            # Calculate relative time
            local diff=$((now - timestamp))
            local time_ago=""
            if [[ $diff -lt 60 ]]; then
                time_ago="just now"
            elif [[ $diff -lt 3600 ]]; then
                time_ago="$((diff / 60)) minutes ago"
            elif [[ $diff -lt 86400 ]]; then
                time_ago="$((diff / 3600)) hours ago"
            else
                time_ago="$((diff / 86400)) days ago"
            fi

            if [[ "$run_status" == "success" ]]; then
                printf "  %-15s " "$display_name"; print -n "$daemon_status"; printf "${GREEN}%-12s${NC} %-18s %s\n" "✓ success" "$time_ago" "$repo_size"
            else
                printf "  %-15s " "$display_name"; print -n "$daemon_status"; printf "${RED}%-12s${NC} %-18s %s\n" "✗ failed" "$time_ago" "$repo_size"
                printf "  ${GREY}%-15s log: %s${NC}\n" "" "$log"
                has_failures=true
            fi
        else
            printf "  %-15s " "$display_name"; print -n "$daemon_status"; printf "${YELLOW}%-12s${NC} %-18s %s\n" "? unknown" "never run" "$repo_size"
        fi
    done
    echo ""

    if $has_failures; then
        return 1
    fi
    return 0
}

cmd_list() {
    if [[ ! -d "$BACKUPS_DIR" ]] || [[ -z "$(ls -A "$BACKUPS_DIR" 2>/dev/null)" ]]; then
        echo "No backup configurations found."
        echo "Use 'bkup add <name> ...' to create one."
        return
    fi

    echo ""
    echo "${BOLD}Backup Configurations${NC}"
    echo "─────────────────────────────────────────"

    for config_file in "$BACKUPS_DIR"/*.json; do
        [[ ! -f "$config_file" ]] && continue
        local name=$(basename "$config_file" .json)
        local host=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
        local dest=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
        local hour=$(python3 -c "import json; print(json.load(open('$config_file')).get('hour', 2))")
        local minute=$(python3 -c "import json; print(json.load(open('$config_file')).get('minute', 0))")
        local dirs=$(python3 -c "import json; print(', '.join(json.load(open('$config_file'))['dirs']))")
        local excludes=$(python3 -c "import json; print(', '.join(json.load(open('$config_file')).get('excludes', [])))")

        printf "  ${CYAN}%-15s${NC} %s:%s  ${YELLOW}@%02d:%02d${NC}\n" "$name" "$host" "$dest" "$hour" "$minute"
        printf "                  ${GREY}%s${NC}\n" "$dirs"
        [[ -n "$excludes" ]] && printf "                  ${RED}excludes: %s${NC}\n" "$excludes"
    done
    echo ""
}

cmd_edit() {
    check_setup

    local NAME="$1"

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup edit <name>"
    fi

    if ! config_exists "$NAME"; then
        error "Backup '$NAME' not found."
    fi

    local config_file="$(config_path "$NAME")"

    # Load current values
    local REMOTE_USER=$(python3 -c "import json; print(json.load(open('$config_file'))['user'])")
    local HOST=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
    local HOST_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
    local LOG_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['log_dir'])")
    local HOUR=$(python3 -c "import json; print(json.load(open('$config_file')).get('hour', 2))")
    local MINUTE=$(python3 -c "import json; print(json.load(open('$config_file')).get('minute', 0))")
    local DIRS=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file'))['dirs']))")}")
    local EXCLUDES=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file')).get('excludes', [])))")}")

    echo ""
    info "Edit backup '$NAME'"
    echo "─────────────────────────────────────────"
    echo "${GREY}(Press Enter to keep current value)${NC}"
    echo ""

    # Reset terminal settings and keybindings for vared
    stty sane 2>/dev/null
    bindkey '^?' backward-delete-char 2>/dev/null
    bindkey '^H' backward-delete-char 2>/dev/null

    # Edit each field with current value pre-filled
    vared -p "SSH user: " REMOTE_USER
    vared -p "SSH host: " HOST
    vared -p "Remote directory: " HOST_DIR
    vared -p "Log directory: " LOG_DIR

    # Format time for editing
    local TIME=$(printf "%02d:%02d" $HOUR $MINUTE)
    vared -p "Schedule time (HH:MM): " TIME
    if [[ "$TIME" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
        HOUR=$((10#${match[1]}))
        MINUTE=$((10#${match[2]}))
    else
        error "Invalid time format. Use HH:MM"
    fi

    # Edit directories with menu
    echo ""
    echo "Directories:"
    while true; do
        local menu_opts=()
        for d in "${DIRS[@]}"; do
            menu_opts+=("${RED}✕${NC} $d")
        done
        menu_opts+=("${GREEN}+${NC} Add directory")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        if [[ $choice -lt ${#DIRS[@]} ]]; then
            # Remove selected directory
            DIRS=("${DIRS[@]:0:$choice}" "${DIRS[@]:$((choice+1))}")
        elif [[ $choice -eq ${#DIRS[@]} ]]; then
            # Add new directory
            local new_dir=""
            vared -p "  New directory: " new_dir
            [[ -n "$new_dir" ]] && DIRS+=("$new_dir")
        else
            # Done
            break
        fi
    done
    [[ ${#DIRS[@]} -eq 0 ]] && error "At least one directory is required"

    # Edit excludes with menu
    echo ""
    echo "Excludes:"
    # Filter out empty excludes
    local filtered_excludes=()
    for e in "${EXCLUDES[@]}"; do
        [[ -n "$e" ]] && filtered_excludes+=("$e")
    done
    EXCLUDES=("${filtered_excludes[@]}")

    while true; do
        local menu_opts=()
        for e in "${EXCLUDES[@]}"; do
            menu_opts+=("${RED}✕${NC} $e")
        done
        menu_opts+=("${GREEN}+${NC} Add exclude")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        if [[ $choice -lt ${#EXCLUDES[@]} ]]; then
            # Remove selected exclude
            EXCLUDES=("${EXCLUDES[@]:0:$choice}" "${EXCLUDES[@]:$((choice+1))}")
        elif [[ $choice -eq ${#EXCLUDES[@]} ]]; then
            # Add new exclude
            local new_exc=""
            vared -p "  New exclude: " new_exc
            [[ -n "$new_exc" ]] && EXCLUDES+=("$new_exc")
        else
            # Done
            break
        fi
    done

    # Expand paths to absolute
    LOG_DIR="${LOG_DIR:A}"
    local expanded_dirs=()
    for dir in "${DIRS[@]}"; do
        expanded_dirs+=("${dir:A}")
    done
    DIRS=("${expanded_dirs[@]}")

    local expanded_excludes=()
    for exc in "${EXCLUDES[@]}"; do
        [[ -n "$exc" ]] && expanded_excludes+=("${exc:A}")
    done
    EXCLUDES=("${expanded_excludes[@]}")

    # Build JSON
    local excludes_json="[]"
    if [[ ${#EXCLUDES[@]} -gt 0 ]]; then
        excludes_json=$(printf '%s\n' "${EXCLUDES[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")
    fi
    local dirs_json=$(printf '%s\n' "${DIRS[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin]))")

    python3 -c "
import json
config = {
    'user': '$REMOTE_USER',
    'host': '$HOST',
    'dest': '$HOST_DIR',
    'log_dir': '$LOG_DIR',
    'excludes': $excludes_json,
    'dirs': $dirs_json,
    'hour': $HOUR,
    'minute': $MINUTE
}
with open('$config_file', 'w') as f:
    json.dump(config, f, indent=2)
"
    chmod 600 "$config_file"

    # Update plist
    local label="$(plist_label "$NAME")"
    zu_service_unload "$label"
    zu_service_create "$label" "$SCRIPT_PATH" \
        --args "run" "$NAME" \
        --type "calendar:${HOUR}:${MINUTE}" \
        --log "/tmp/bkup-$NAME.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$label"

    echo ""
    success "Updated backup '$NAME'"
    echo "  Host: $REMOTE_USER@$HOST:$HOST_DIR"
    echo "  Dirs: ${DIRS[*]}"
    echo "  Schedule: $(printf '%02d:%02d' $HOUR $MINUTE) daily"
}

cmd_copy() {
    check_setup

    local SOURCE="$1"

    if [[ -z "$SOURCE" ]]; then
        error "Usage: bkup copy <source>"
    fi

    if ! config_exists "$SOURCE"; then
        error "Backup '$SOURCE' not found."
    fi

    local config_file="$(config_path "$SOURCE")"

    # Load current values
    local REMOTE_USER=$(python3 -c "import json; print(json.load(open('$config_file'))['user'])")
    local HOST=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
    local HOST_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
    local LOG_DIR=$(python3 -c "import json; print(json.load(open('$config_file'))['log_dir'])")
    local HOUR=$(python3 -c "import json; print(json.load(open('$config_file')).get('hour', 2))")
    local MINUTE=$(python3 -c "import json; print(json.load(open('$config_file')).get('minute', 0))")
    local DIRS=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file'))['dirs']))")}")
    local EXCLUDES=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file')).get('excludes', [])))")}")

    echo ""
    info "Copy backup '$SOURCE'"
    echo "─────────────────────────────────────────"
    echo "${GREY}(Press Enter to keep current value)${NC}"
    echo ""

    # Reset terminal settings and keybindings for vared
    stty sane 2>/dev/null
    bindkey '^?' backward-delete-char 2>/dev/null
    bindkey '^H' backward-delete-char 2>/dev/null

    # Prompt for new name
    local NAME=""
    vared -p "New name: " NAME
    [[ -z "$NAME" ]] && error "Name is required"

    if config_exists "$NAME"; then
        read -q "confirm?Backup '$NAME' already exists. Overwrite? [y/N] "
        echo ""
        [[ "$confirm" != "y" ]] && exit 0
        zu_service_unload "$(plist_label "$NAME")"
    fi

    # Edit each field with current value pre-filled
    vared -p "SSH user: " REMOTE_USER
    vared -p "SSH host: " HOST
    vared -p "Remote directory: " HOST_DIR
    vared -p "Log directory: " LOG_DIR

    # Format time for editing
    local TIME=$(printf "%02d:%02d" $HOUR $MINUTE)
    vared -p "Schedule time (HH:MM): " TIME
    if [[ "$TIME" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
        HOUR=$((10#${match[1]}))
        MINUTE=$((10#${match[2]}))
    else
        error "Invalid time format. Use HH:MM"
    fi

    # Edit directories with menu
    echo ""
    echo "Directories:"
    while true; do
        local menu_opts=()
        for d in "${DIRS[@]}"; do
            menu_opts+=("${RED}✕${NC} $d")
        done
        menu_opts+=("${GREEN}+${NC} Add directory")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        if [[ $choice -lt ${#DIRS[@]} ]]; then
            DIRS=("${DIRS[@]:0:$choice}" "${DIRS[@]:$((choice+1))}")
        elif [[ $choice -eq ${#DIRS[@]} ]]; then
            local new_dir=""
            vared -p "  New directory: " new_dir
            [[ -n "$new_dir" ]] && DIRS+=("$new_dir")
        else
            break
        fi
    done
    [[ ${#DIRS[@]} -eq 0 ]] && error "At least one directory is required"

    # Edit excludes with menu
    echo ""
    echo "Excludes:"
    local filtered_excludes=()
    for e in "${EXCLUDES[@]}"; do
        [[ -n "$e" ]] && filtered_excludes+=("$e")
    done
    EXCLUDES=("${filtered_excludes[@]}")

    while true; do
        local menu_opts=()
        for e in "${EXCLUDES[@]}"; do
            menu_opts+=("${RED}✕${NC} $e")
        done
        menu_opts+=("${GREEN}+${NC} Add exclude")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        if [[ $choice -lt ${#EXCLUDES[@]} ]]; then
            EXCLUDES=("${EXCLUDES[@]:0:$choice}" "${EXCLUDES[@]:$((choice+1))}")
        elif [[ $choice -eq ${#EXCLUDES[@]} ]]; then
            local new_exc=""
            vared -p "  New exclude: " new_exc
            [[ -n "$new_exc" ]] && EXCLUDES+=("$new_exc")
        else
            break
        fi
    done

    # Expand paths to absolute
    LOG_DIR="${LOG_DIR:A}"
    local expanded_dirs=()
    for dir in "${DIRS[@]}"; do
        expanded_dirs+=("${dir:A}")
    done
    DIRS=("${expanded_dirs[@]}")

    local expanded_excludes=()
    for exc in "${EXCLUDES[@]}"; do
        [[ -n "$exc" ]] && expanded_excludes+=("${exc:A}")
    done
    EXCLUDES=("${expanded_excludes[@]}")

    # Check/create repository
    local REPO="$REMOTE_USER@$HOST:$HOST_DIR"
    export BORG_PASSPHRASE=$(cat "$PASS_FILE")

    echo ""
    info "Checking repository..."

    local borg_info_output
    if borg_info_output=$(/opt/homebrew/bin/borg info "$REPO" 2>&1); then
        success "Repository exists and passphrase is correct"
    else
        local borg_init_output
        borg_init_output=$(/opt/homebrew/bin/borg init --encryption=repokey-blake2 "$REPO" 2>&1)
        local init_status=$?

        if [[ $init_status -eq 0 ]]; then
            success "Repository created"
        elif echo "$borg_init_output" | grep -q "already exists"; then
            error "Repository exists but passphrase is incorrect. Run 'bkup setup' to update passphrase."
        elif echo "$borg_init_output" | grep -qi "does not exist\|no such file\|not found"; then
            echo "Remote directory does not exist: $HOST_DIR"
            read -q "create_dir?Create it? [y/N] "
            echo ""
            if [[ "$create_dir" == "y" ]]; then
                info "Creating remote directory..."
                if ! ssh "$REMOTE_USER@$HOST" "mkdir -p '$HOST_DIR'"; then
                    error "Failed to create remote directory"
                fi
                info "Initializing repository..."
                if ! /opt/homebrew/bin/borg init --encryption=repokey-blake2 "$REPO" 2>&1; then
                    error "Failed to initialize repository"
                fi
                success "Repository created"
            else
                error "Remote directory must exist"
            fi
        else
            echo "$borg_init_output"
            error "Failed to access or create repository"
        fi
    fi

    # Create config directory
    mkdir -p "$BACKUPS_DIR"

    # Build JSON
    local excludes_json="[]"
    if [[ ${#EXCLUDES[@]} -gt 0 ]]; then
        excludes_json=$(printf '%s\n' "${EXCLUDES[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")
    fi
    local dirs_json=$(printf '%s\n' "${DIRS[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin]))")

    local new_config_file="$(config_path "$NAME")"
    python3 -c "
import json
config = {
    'user': '$REMOTE_USER',
    'host': '$HOST',
    'dest': '$HOST_DIR',
    'log_dir': '$LOG_DIR',
    'excludes': $excludes_json,
    'dirs': $dirs_json,
    'hour': $HOUR,
    'minute': $MINUTE
}
with open('$new_config_file', 'w') as f:
    json.dump(config, f, indent=2)
"
    chmod 600 "$new_config_file"

    # Create plist
    local label="$(plist_label "$NAME")"
    zu_service_unload "$label"
    zu_service_create "$label" "$SCRIPT_PATH" \
        --args "run" "$NAME" \
        --type "calendar:${HOUR}:${MINUTE}" \
        --log "/tmp/bkup-$NAME.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$label"

    echo ""
    success "Created backup '$NAME' (copied from '$SOURCE')"
    echo "  Host: $REMOTE_USER@$HOST:$HOST_DIR"
    echo "  Dirs: ${DIRS[*]}"
    echo "  Schedule: $(printf '%02d:%02d' $HOUR $MINUTE) daily"
}

cmd_archives() {
    check_setup

    local NAME="$1"

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup archives <name>"
    fi

    load_config "$NAME"

    export BORG_PASSPHRASE=$(<"$PASS_FILE")
    local REPO="$REMOTE_USER@$HOST:$HOST_DIR"

    echo ""
    info "Archives for '$NAME'"
    echo "─────────────────────────────────────────"

    /opt/homebrew/bin/borg list --format '{archive:<20} {time:%Y-%m-%d %H:%M}  {size:>10}{NL}' "$REPO" 2>/dev/null

    if [[ $? -ne 0 ]]; then
        error "Failed to list archives"
    fi
    echo ""
}

cmd_files() {
    check_setup

    local NAME=""
    local ARCHIVE=""
    local PATH_FILTER=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--path)
                PATH_FILTER="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$NAME" ]]; then
                    NAME="$1"
                elif [[ -z "$ARCHIVE" ]]; then
                    ARCHIVE="$1"
                else
                    error "Too many arguments"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup files <name> [archive] [-p|--path <path>]"
    fi

    load_config "$NAME"

    export BORG_PASSPHRASE=$(<"$PASS_FILE")
    local REPO="$REMOTE_USER@$HOST:$HOST_DIR"

    # If no archive specified, use latest
    if [[ -z "$ARCHIVE" ]]; then
        ARCHIVE=$(/opt/homebrew/bin/borg list --last 1 --format '{archive}' "$REPO" 2>/dev/null)
        if [[ -z "$ARCHIVE" ]]; then
            error "No archives found in repository"
        fi
    fi

    echo ""
    info "Files in '$NAME::$ARCHIVE'"
    echo "─────────────────────────────────────────"

    local borg_args=()
    if [[ -n "$PATH_FILTER" ]]; then
        borg_args+=(--pattern "$PATH_FILTER")
    fi

    /opt/homebrew/bin/borg list "${borg_args[@]}" "$REPO::$ARCHIVE" 2>/dev/null

    if [[ $? -ne 0 ]]; then
        error "Failed to list files (archive '$ARCHIVE' may not exist)"
    fi
    echo ""
}

cmd_test() {
    check_setup

    local NAME="$1"
    local configs=()

    if [[ -n "$NAME" ]]; then
        if ! config_exists "$NAME"; then
            error "Backup '$NAME' not found."
        fi
        configs=("$(config_path "$NAME")")
    else
        # Test all backups
        if [[ ! -d "$BACKUPS_DIR" ]] || [[ -z "$(ls -A "$BACKUPS_DIR" 2>/dev/null)" ]]; then
            echo "No backup configurations found."
            return
        fi
        configs=("$BACKUPS_DIR"/*.json)
    fi

    export BORG_PASSPHRASE=$(cat "$PASS_FILE")
    local all_ok=true

    echo ""
    for config_file in "${configs[@]}"; do
        [[ ! -f "$config_file" ]] && continue
        local name=$(basename "$config_file" .json)
        local user=$(python3 -c "import json; print(json.load(open('$config_file'))['user'])")
        local host=$(python3 -c "import json; print(json.load(open('$config_file'))['host'])")
        local dest=$(python3 -c "import json; print(json.load(open('$config_file'))['dest'])")
        local dirs=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file'))['dirs']))")}")

        echo "${BOLD}Testing '$name'${NC}"
        echo "─────────────────────────────────────────"

        local ok=true

        # Test SSH connection
        printf "  SSH connection to %s@%s... " "$user" "$host"
        if ssh -o BatchMode=yes -o ConnectTimeout=5 "$user@$host" "true" 2>/dev/null; then
            echo "${GREEN}OK${NC}"
        else
            echo "${RED}FAILED${NC}"
            ok=false
        fi

        # Test repository access
        printf "  Repository %s... " "$dest"
        local repo="$user@$host:$dest"
        local repo_tmpfile=$(mktemp)
        /opt/homebrew/bin/borg info "$repo" >"$repo_tmpfile" 2>&1
        local repo_status=$?
        local repo_output=$(<"$repo_tmpfile")
        rm -f "$repo_tmpfile"
        if [[ $repo_status -eq 0 ]]; then
            echo "${GREEN}OK${NC}"
        else
            if echo "$repo_output" | grep -qi "passphrase\|wrong key\|decryption\|invalid key"; then
                echo "${RED}WRONG PASSPHRASE${NC}"
            elif echo "$repo_output" | grep -qi "does not exist\|not found\|no such file"; then
                echo "${RED}NOT FOUND${NC} (repository doesn't exist at this path)"
            elif echo "$repo_output" | grep -qi "not a valid repository\|invalid repository"; then
                echo "${RED}INVALID${NC} (path exists but is not a borg repository)"
            elif echo "$repo_output" | grep -qi "permission denied"; then
                echo "${RED}PERMISSION DENIED${NC}"
            elif echo "$repo_output" | grep -qi "lock"; then
                if pgrep -f "borg.*$dest" >/dev/null 2>&1; then
                    echo "${YELLOW}BACKUP IN PROGRESS${NC}"
                else
                    echo "${RED}STALE LOCK${NC} (run: borg break-lock $repo)"
                fi
            else
                echo "${RED}FAILED${NC}"
                echo "$repo_output" | head -3 | sed 's/^/    /'
            fi
            ok=false
        fi

        # Check repository health
        if $ok; then
            printf "  Repository health... "
            local check_tmpfile=$(mktemp)
            /opt/homebrew/bin/borg check "$repo" >"$check_tmpfile" 2>&1
            local check_status=$?
            local check_output=$(<"$check_tmpfile")
            rm -f "$check_tmpfile"
            if [[ $check_status -eq 0 ]]; then
                echo "${GREEN}OK${NC}"
            elif [[ $check_status -eq 1 ]]; then
                echo "${YELLOW}WARNINGS${NC}"
                echo "$check_output" | sed 's/^/    /'
            else
                echo "${RED}ERRORS${NC}"
                echo "$check_output" | sed 's/^/    /'
                ok=false
            fi
        fi

        # Check for repo lock (would block next backup)
        if $ok; then
            printf "  Repository lock... "
            if /opt/homebrew/bin/borg info "$repo" 2>&1 | grep -q "lock"; then
                if pgrep -f "borg.*$dest" >/dev/null 2>&1; then
                    echo "${YELLOW}BACKUP IN PROGRESS${NC} (skipping remaining checks)"
                    echo ""
                    continue
                else
                    echo "${RED}STALE LOCK${NC} (run: borg break-lock $repo)"
                    ok=false
                fi
            else
                echo "${GREEN}OK${NC}"
            fi
        fi

        # Test source directories
        for dir in "${dirs[@]}"; do
            printf "  Source %s... " "$dir"
            if [[ -d "$dir" ]]; then
                echo "${GREEN}OK${NC}"
            elif [[ -e "$dir" ]]; then
                echo "${YELLOW}exists (not a directory)${NC}"
            else
                echo "${RED}NOT FOUND${NC}"
                ok=false
            fi
        done

        # Test schedule plist
        local label="$(plist_label "$name")"
        local plist_file="$(zu_service_path "$label")"
        local bkup_path="$SCRIPT_PATH"
        printf "  Schedule plist... "
        if ! zu_service_exists "$label"; then
            echo "${RED}NOT FOUND${NC}"
            ok=false
        elif ! grep -q "<string>$bkup_path</string>" "$plist_file"; then
            echo "${RED}WRONG PATH${NC} (run 'bkup edit $name' to fix)"
            ok=false
        else
            echo "${GREEN}OK${NC}"
        fi

        # Test launchd status
        printf "  Launchd job... "
        local launchd_status=$(launchctl list "$label" 2>&1)
        if [[ $? -ne 0 ]]; then
            echo "${RED}NOT LOADED${NC} (run: launchctl load \"$plist_file\")"
            ok=false
        elif echo "$launchd_status" | grep -q '"LastExitStatus" = 127'; then
            echo "${RED}LAST RUN FAILED${NC} (command not found)"
            ok=false
        elif echo "$launchd_status" | grep -q '"LastExitStatus" = [^0]'; then
            echo "${YELLOW}LAST RUN HAD ERRORS${NC}"
        else
            echo "${GREEN}OK${NC}"
        fi

        # Dry run
        if $ok; then
            printf "  Dry run... "
            local excludes=("${(@f)$(python3 -c "import json; print('\n'.join(json.load(open('$config_file')).get('excludes', [])))")}")
            local exclude_args=()
            for exc in "${excludes[@]}"; do
                [[ -n "$exc" ]] && exclude_args+=(--exclude "$exc")
            done

            if /opt/homebrew/bin/borg create --dry-run "$repo::{now:%Y-%m-%d}" "${exclude_args[@]}" "${dirs[@]}" 2>/dev/null; then
                echo "${GREEN}OK${NC}"
            else
                echo "${RED}FAILED${NC}"
                ok=false
            fi
        fi

        if $ok; then
            echo "  ${GREEN}✓ All checks passed${NC}"
        else
            echo "  ${RED}✗ Some checks failed${NC}"
            all_ok=false
        fi
        echo ""
    done

    if $all_ok; then
        success "All backups OK"
        return 0
    else
        echo "${RED}Some backups have issues${NC}"
        return 1
    fi
}

cmd_remove() {
    local NAME="$1"

    if [[ -z "$NAME" ]]; then
        error "Usage: bkup remove <name>"
    fi

    if ! config_exists "$NAME"; then
        error "Backup '$NAME' not found."
    fi

    # Unload and remove plist
    zu_service_remove "$(plist_label "$NAME")"

    # Remove config
    rm -f "$(config_path "$NAME")"

    success "Removed backup '$NAME'"
}

cmd_uninstall() {
    echo ""
    echo "${YELLOW}This will remove:${NC}"
    echo "  - All backup configurations"
    echo "  - All scheduled backup jobs"
    echo "  - Stored passphrase"
    echo ""
    echo "${GREY}(Remote repositories will not be affected)${NC}"
    echo ""
    read -q "confirm?Are you sure? [y/N] "
    echo ""
    [[ "$confirm" != "y" ]] && exit 0

    info "Uninstalling bkup..."

    # Remove all backup schedules
    if [[ -d "$BACKUPS_DIR" ]]; then
        for config_file in "$BACKUPS_DIR"/*.json; do
            [[ -f "$config_file" ]] || continue
            local name=$(basename "$config_file" .json)
            zu_service_remove "$(plist_label "$name")"
        done
    fi
    success "Removed scheduled jobs"

    # Remove config directory (configs + passphrase)
    if [[ -d "$CONFIG_DIR" ]]; then
        rm -rf "$CONFIG_DIR"
        success "Removed configurations and passphrase"
    fi

    echo ""
    success "Uninstall complete."
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
    setup)
        cmd_setup
        ;;
    add)
        shift
        cmd_add "$@"
        ;;
    edit)
        cmd_edit "$2"
        ;;
    copy)
        cmd_copy "$2"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    test)
        cmd_test "$2"
        ;;
    archives)
        cmd_archives "$2"
        ;;
    files)
        shift
        cmd_files "$@"
        ;;
    status)
        cmd_status
        ;;
    list)
        cmd_list
        ;;
    remove)
        cmd_remove "$2"
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h)
        usage
        ;;
    "")
        usage
        ;;
    *)
        error "Unknown command: $1. Run 'bkup help' for usage."
        ;;
esac
