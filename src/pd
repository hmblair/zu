#!/usr/bin/env zsh

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/common"

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    echo "Usage: ${0:t} [FILES]"
    echo "Print full paths of files, or current directory if no files given"
    exit 0
fi

if [[ $# -eq 0 ]]; then
    # No arguments: print full path of current directory
    pwd
else
    # Arguments provided: print full path of each file
    for file in "$@"; do
        if [[ ! -e "$file" ]]; then
            error "File not found: $file"
        fi
        # Get absolute path using zsh's :A modifier
        echo "${file:A}"
    done
fi
