#!/usr/bin/env zsh

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/common"

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    echo "Usage: ${0:t} [-r] [FILES]"
    echo "Print full paths of files, or current directory if no files given"
    echo ""
    echo "Options:"
    echo "  -r  Resolve symlinks"
    exit 0
fi

resolve=false
if [[ "$1" == "-r" ]]; then
    resolve=true
    shift
fi

if [[ $# -eq 0 ]]; then
    # No arguments: print full path of current directory
    if $resolve; then
        result=$(pwd -P)
    else
        result=$(pwd)
    fi
    if [[ "$result" == *" "* ]]; then
        echo "\"$result\""
    else
        echo "$result"
    fi
else
    # Arguments provided: print full path of each file
    for file in "$@"; do
        if [[ ! -e "$file" ]]; then
            error "File not found: $file"
        fi
        if $resolve; then
            result="${file:A}"
        else
            result="${file:a}"
        fi
        if [[ "$result" == *" "* ]]; then
            echo "\"$result\""
        else
            echo "$result"
        fi
    done
fi
