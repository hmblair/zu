#!/usr/bin/env zsh

# buzz - Keep your Mac awake
# Uses caffeinate to prevent system sleep

SCRIPT_DIR="${0:A:h}"
SCRIPT_PATH="${0:A}"
source "$SCRIPT_DIR/../common"

PID_FILE="$HOME/.buzz.pid"
PLIST_LABEL="com.zu.buzz"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: buzz <command>

Keep your Mac awake by preventing system sleep.

Commands:
  on        Start keeping the computer awake
  off       Allow the computer to sleep again
  status    Show current status
  install   Start automatically on login
  uninstall Remove automatic startup

EOF
}

is_running() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

buzz_on() {
    if ! command -v caffeinate >/dev/null 2>&1; then
        error "caffeinate not found. This tool requires macOS."
    fi

    if is_running; then
        warn "Already running."
        return 0
    fi

    nohup caffeinate -di >/dev/null 2>&1 &
    disown
    echo $! > "$PID_FILE"
    success "Buzz on - computer will stay awake."
}

buzz_off() {
    if ! is_running; then
        warn "Not running."
        rm -f "$PID_FILE"
        return 0
    fi

    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    success "Buzz off - computer can sleep again."
}

buzz_status() {
    if is_running; then
        echo "Buzz is ${GREEN}on${NC} (PID: $(cat "$PID_FILE"))"
    else
        echo "Buzz is ${RED}off${NC}"
        rm -f "$PID_FILE"  # Clean up stale PID file
    fi

    if zu_service_exists "$PLIST_LABEL"; then
        echo "Auto-start: ${GREEN}enabled${NC}"
    else
        echo "Auto-start: ${RED}disabled${NC}"
    fi
}

buzz_install() {
    if zu_service_exists "$PLIST_LABEL"; then
        warn "Already installed."
        return 0
    fi

    zu_service_create "$PLIST_LABEL" "$SCRIPT_PATH" --args "on"
    zu_service_load "$PLIST_LABEL"
    success "Installed - buzz will start on login."
}

buzz_uninstall() {
    if ! zu_service_exists "$PLIST_LABEL"; then
        warn "Not installed."
        return 0
    fi

    zu_service_remove "$PLIST_LABEL"
    success "Uninstalled - buzz will no longer start on login."
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    case "$1" in
        on)
            buzz_on
            ;;
        off)
            buzz_off
            ;;
        status|"")
            buzz_status
            ;;
        install)
            buzz_install
            ;;
        uninstall)
            buzz_uninstall
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            error "Unknown command: $1"
            ;;
    esac
}

main "$@"
