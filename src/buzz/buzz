#!/usr/bin/env zsh

# buzz - Keep your Mac awake
# Uses caffeinate to prevent system sleep

SCRIPT_DIR="${0:A:h}"
SCRIPT_PATH="${0:A}"
source "$SCRIPT_DIR/../common"

PID_FILE="$HOME/.buzz.pid"
NOSLEEP_FILE="$HOME/.buzz.nosleep"
PLIST_LABEL="com.zu.buzz"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: buzz <command>

Keep your Mac awake by preventing system sleep.

Commands:
  on        Start keeping the computer awake
  max       Prevent all sleep, including lid close (requires sudo)
  off       Allow the computer to sleep again
  status    Show current status
  install   Start automatically on login
  uninstall Remove automatic startup

EOF
}

is_running() {
    # Check PID file first (manual start)
    if [[ -f "$PID_FILE" ]]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" -o comm= 2>/dev/null | grep -q caffeinate; then
            return 0
        fi
        rm -f "$PID_FILE"  # Clean up stale PID file
    fi
    # Check for launchd-managed caffeinate
    pgrep -qf "caffeinate -di" 2>/dev/null
}

is_nosleep() {
    [[ -f "$NOSLEEP_FILE" ]]
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

buzz_on() {
    if ! command -v caffeinate >/dev/null 2>&1; then
        error "caffeinate not found. This tool requires macOS."
    fi

    if is_running; then
        warn "Already running."
        return 0
    fi

    # If installed via launchd, load the service
    if zu_service_exists "$PLIST_LABEL"; then
        launchctl load "$(zu_service_path "$PLIST_LABEL")" 2>/dev/null
        success "Buzz on - computer will stay awake."
        return 0
    fi

    # Manual start
    nohup caffeinate -di >/dev/null 2>&1 &
    disown
    echo $! > "$PID_FILE"
    success "Buzz on - computer will stay awake."
}

buzz_max() {
    if is_nosleep; then
        warn "Already in max mode."
        return 0
    fi

    # Enable buzz normally first if not already running
    if ! is_running; then
        buzz_on
    fi

    # Disable all sleep including lid close
    sudo pmset -a disablesleep 1
    touch "$NOSLEEP_FILE"
    success "Buzz max - all sleep disabled, including lid close."
}

buzz_off() {
    # Re-enable sleep if max mode was active
    if is_nosleep; then
        sudo pmset -a disablesleep 0
        rm -f "$NOSLEEP_FILE"
    fi

    if ! is_running; then
        warn "Not running."
        rm -f "$PID_FILE"
        return 0
    fi

    # If installed via launchd, unload the service (but keep it installed)
    if zu_service_exists "$PLIST_LABEL"; then
        launchctl unload "$(zu_service_path "$PLIST_LABEL")" 2>/dev/null
        success "Buzz off - computer can sleep again."
        return 0
    fi

    # Manual stop
    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    success "Buzz off - computer can sleep again."
}

buzz_status() {
    if is_running; then
        local pid=$(pgrep -f "caffeinate -di" 2>/dev/null | head -1)
        if is_nosleep; then
            echo "Buzz is ${GREEN}max${NC} (PID: $pid, all sleep disabled)"
        else
            echo "Buzz is ${GREEN}on${NC} (PID: $pid)"
        fi
    else
        echo "Buzz is ${RED}off${NC}"
    fi

    if zu_service_exists "$PLIST_LABEL"; then
        echo "Auto-start: ${GREEN}enabled${NC}"
    else
        echo "Auto-start: ${RED}disabled${NC}"
    fi
}

buzz_install() {
    if zu_service_exists "$PLIST_LABEL"; then
        warn "Already installed."
        return 0
    fi

    # Run caffeinate directly with KeepAlive so launchd manages it
    zu_service_create "$PLIST_LABEL" "/usr/bin/caffeinate" --type "keep_alive" -- "-di"
    zu_service_load "$PLIST_LABEL"

    # Kill any manually-started caffeinate
    if [[ -f "$PID_FILE" ]]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
    fi

    success "Installed - buzz will start on login."
}

buzz_uninstall() {
    if ! zu_service_exists "$PLIST_LABEL"; then
        warn "Not installed."
        return 0
    fi

    zu_service_remove "$PLIST_LABEL"
    success "Uninstalled - buzz will no longer start on login."
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    case "$1" in
        on)
            buzz_on
            ;;
        max)
            buzz_max
            ;;
        off)
            buzz_off
            ;;
        status|"")
            buzz_status
            ;;
        install)
            buzz_install
            ;;
        uninstall)
            buzz_uninstall
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            error "Unknown command: $1"
            ;;
    esac
}

main "$@"
