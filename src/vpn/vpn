#!/usr/bin/env zsh

# vpn - Connect to Stanford VPN
# Uses Cisco Secure Client with credentials from Keychain

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

VPN_BIN="/opt/cisco/secureclient/bin/vpn"
VPN_HOST="su-vpn.stanford.edu"
VPN_GROUP="Stanford"
VPN_USER="hmblair"
KEYCHAIN_SERVICE="stanford-vpn"
DEBUG=0

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: vpn <command>

Connect to Stanford VPN.

Commands:
  on         Connect to VPN (sends Duo push)
  off        Disconnect from VPN
  status     Show connection status
  configure  Store password in Keychain

Options:
  --debug    Show VPN client output

EOF
}

get_password() {
    security find-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null
}

password_exists() {
    security find-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1
}

is_connected() {
    "$VPN_BIN" state 2>/dev/null | grep -q "state: Connected"
}

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

vpn_on() {
    if [[ ! -x "$VPN_BIN" ]]; then
        error "Cisco Secure Client not found at $VPN_BIN"
    fi

    if is_connected; then
        warn "Already connected."
        return 0
    fi

    local password
    password=$(get_password)
    if [[ -z "$password" ]]; then
        error "Password not found in Keychain. Run: vpn configure"
    fi

    echo "Connecting to $VPN_HOST (check phone for Duo push)..."

    # Empty string accepts defaults [Stanford] and [hmblair], then password, then Duo push (1)
    if (( DEBUG )); then
        printf '%s\n' "" "" "$password" "1" | "$VPN_BIN" -s connect "$VPN_HOST"
    else
        printf '%s\n' "" "" "$password" "1" | "$VPN_BIN" -s connect "$VPN_HOST" >/dev/null 2>&1
    fi

    if is_connected; then
        success "Connected to VPN."
    else
        error "Failed to connect. Try running manually:\n  $VPN_BIN connect $VPN_HOST"
    fi
}

vpn_off() {
    if [[ ! -x "$VPN_BIN" ]]; then
        error "Cisco Secure Client not found at $VPN_BIN"
    fi

    if ! is_connected; then
        warn "Not connected."
        return 0
    fi

    "$VPN_BIN" disconnect >/dev/null 2>&1
    success "Disconnected from VPN."
}

vpn_status() {
    if [[ ! -x "$VPN_BIN" ]]; then
        error "Cisco Secure Client not found at $VPN_BIN"
    fi

    if is_connected; then
        echo "VPN is ${GREEN}connected${NC}"
    else
        echo "VPN is ${RED}disconnected${NC}"
    fi
}

vpn_configure() {
    if password_exists; then
        printf "Password already exists. Overwrite? [y/N] "
        read -r reply
        if [[ ! "$reply" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            return 0
        fi
        security delete-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1
    fi

    printf "Enter VPN password: "
    read -rs password
    echo

    if [[ -z "$password" ]]; then
        error "Password cannot be empty."
    fi

    security add-generic-password -a "$VPN_USER" -s "$KEYCHAIN_SERVICE" -T "" -w "$password"
    success "Password stored in Keychain."
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    # Parse options from anywhere in args
    local cmd=""
    for arg in "$@"; do
        case "$arg" in
            --debug) DEBUG=1 ;;
            --help) usage; return 0 ;;
            --*) error "Unknown option: $arg" ;;
            *) [[ -z "$cmd" ]] && cmd="$arg" ;;
        esac
    done

    case "$cmd" in
        on)
            vpn_on
            ;;
        off)
            vpn_off
            ;;
        status|"")
            vpn_status
            ;;
        configure)
            vpn_configure
            ;;
        -h|help)
            usage
            ;;
        *)
            error "Unknown command: $1"
            ;;
    esac
}

main "$@"
