#!/usr/bin/env zsh

# l - Enhanced directory listing with tree view
# Displays directories in a tree format with icons and colors

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
DEPTH=1
HIDDEN=0
SIZES=0
COUNT_LINES=0
EXPAND_ALL=0
CLEAR_SCREEN=0
LIST_MODE=0
SORT_BY=""       # "", "size", "time", "name"
SORT_REVERSE=0
DIRECTORIES=()
NO_EXPAND=('^\.git$')
MAX_TREE_DEPTH=50

# Associative arrays
typeset -A ICONS
typeset -A GITIGNORE_CACHE
typeset -A SIZE_CACHE
typeset -A LINECOUNT_CACHE
typeset -A MTIME_CACHE

# Disable colors if not a tty
if [[ ! -t 1 ]]; then
    RED="" GREEN="" YELLOW="" BLUE="" CYAN="" WHITE="" GREY="" NC=""
    YELLOW_B="" BOLD="" ITALIC=""
fi

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: l [OPTIONS] [FILE ...]"
    echo ""
    echo "Options:"
    echo "  -a              Show hidden files"
    echo "  -c              Clear screen before displaying"
    echo "  -s              Show file/directory sizes"
    echo "  -l              Show line counts for files"
    echo "  -t, --tree      Show full tree (depth $MAX_TREE_DEPTH)"
    echo "  --depth INT     Limit tree depth"
    echo "  --expand-all    Expand all directories (ignore NO_EXPAND list)"
    echo "  --list          Flat list output (no tree structure)"
    echo ""
    echo "Sorting:"
    echo "  -S              Sort by size (largest first)"
    echo "  -T              Sort by modification time (newest first)"
    echo "  -N              Sort by name (alphabetical)"
    echo "  -r              Reverse sort order"
    echo ""
    echo "  -h, --help      Show this help message"
}


# Load icons from TOML file
load_icons() {
    local toml_file="$SCRIPT_DIR/icons.toml"
    [[ ! -f "$toml_file" ]] && return

    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        # Parse key = "value"
        if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"(.*)\"$ ]]; then
            ICONS[${match[1]}]="${match[2]}"
        fi
    done < "$toml_file"
}

is_ignored() {
    local path="$1"
    (( ${+GITIGNORE_CACHE[$path]} ))
}

# Build all caches in parallel for a directory
build_caches() {
    local abs_dir="$1"
    local depth="$2"
    local hidden="$3"
    local need_git="$4"
    local need_size="$5"
    local need_lines="$6"
    local need_mtime="$7"

    # Base find arguments (reused by all cache builders)
    local -a base_args=(-maxdepth "$depth" -not -path '*/.git/*')
    (( ! hidden )) && base_args+=(-not -path '*/.*')

    # Create temp files only for needed caches
    local git_tmp="" size_tmp="" line_tmp="" mtime_tmp=""
    (( need_git )) && git_tmp=$(/usr/bin/mktemp)
    (( need_size )) && size_tmp=$(/usr/bin/mktemp)
    (( need_lines )) && line_tmp=$(/usr/bin/mktemp)
    (( need_mtime )) && mtime_tmp=$(/usr/bin/mktemp)

    # Run cache builders in parallel
    [[ -n "$git_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" 2>/dev/null | /usr/bin/git check-ignore --stdin 2>/dev/null > "$git_tmp"
    } &
    [[ -n "$size_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" -exec /usr/bin/du -sh {} + 2>/dev/null > "$size_tmp"
    } &
    [[ -n "$line_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" -type f -exec /usr/bin/wc -l {} + 2>/dev/null > "$line_tmp"
    } &
    [[ -n "$mtime_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" -exec /usr/bin/stat -f '%m %N' {} + 2>/dev/null > "$mtime_tmp"
    } &
    wait

    # Load results into caches
    [[ -n "$git_tmp" ]] && {
        while IFS= read -r path; do
            [[ -n "$path" ]] && GITIGNORE_CACHE[$path]=1
        done < "$git_tmp"
        /bin/rm -f "$git_tmp"
    }
    [[ -n "$size_tmp" ]] && {
        while IFS=$'\t' read -r size path; do
            [[ -n "$path" ]] && SIZE_CACHE[$path]="${size#"${size%%[! ]*}"}"
        done < "$size_tmp"
        /bin/rm -f "$size_tmp"
    }
    [[ -n "$line_tmp" ]] && {
        while read -r count path; do
            [[ -n "$path" && "$path" != "total" ]] && LINECOUNT_CACHE[$path]="$count"
        done < "$line_tmp"
        /bin/rm -f "$line_tmp"
    }
    [[ -n "$mtime_tmp" ]] && {
        while read -r mtime path; do
            [[ -n "$path" ]] && MTIME_CACHE[$path]="$mtime"
        done < "$mtime_tmp"
        /bin/rm -f "$mtime_tmp"
    }
}

should_skip() {
    local name="$1"
    local path="$2"

    for pattern in "${NO_EXPAND[@]}"; do
        if [[ $name =~ $pattern ]]; then
            return 0
        fi
    done

    is_ignored "$path"
}

# Sort files array based on SORT_BY and SORT_REVERSE
sort_files() {
    local -a input=("$@")
    local -a sorted=()

    case "$SORT_BY" in
        size)
            # Sort by size (largest first by default) - use cache if available
            sorted=($(for f in "${input[@]}"; do
                local size=0
                if [[ -n "${SIZE_CACHE[$f]}" ]]; then
                    size="${SIZE_CACHE[$f]}"
                elif [[ -e "$f" ]]; then
                    size=$(/usr/bin/du -sk "$f" 2>/dev/null | /usr/bin/cut -f1)
                    size=${size:-0}
                fi
                printf '%s\t%s\n' "$size" "$f"
            done | /usr/bin/sort -t$'\t' -k1 -n -r | /usr/bin/cut -f2-))
            ;;
        time)
            # Sort by mtime (newest first by default) - use cache if available
            sorted=($(for f in "${input[@]}"; do
                local mtime=0
                if [[ -n "${MTIME_CACHE[$f]}" ]]; then
                    mtime="${MTIME_CACHE[$f]}"
                elif [[ -e "$f" ]]; then
                    mtime=$(/usr/bin/stat -f '%m' "$f" 2>/dev/null || /usr/bin/stat -c '%Y' "$f" 2>/dev/null || echo 0)
                fi
                printf '%s\t%s\n' "$mtime" "$f"
            done | /usr/bin/sort -t$'\t' -k1 -n -r | /usr/bin/cut -f2-))
            ;;
        name)
            # Sort alphabetically
            sorted=($(printf '%s\n' "${input[@]}" | /usr/bin/sort))
            ;;
        *)
            # No sorting
            sorted=("${input[@]}")
            ;;
    esac

    if (( SORT_REVERSE )); then
        sorted=("${(Oa)sorted[@]}")
    fi

    printf '%s\n' "${sorted[@]}"
}

# Apply sorting to an array, returns sorted array via stdout
apply_sorting() {
    local -a items=("$@")
    if [[ -n "$SORT_BY" ]] || (( SORT_REVERSE )); then
        local -a sorted=()
        while IFS= read -r f; do
            [[ -n "$f" ]] && sorted+=("$f")
        done < <(sort_files "${items[@]}")
        printf '%s\n' "${sorted[@]}"
    else
        printf '%s\n' "${items[@]}"
    fi
}

print_line() {
    local line="$1"
    local depth="$2"
    local arr="$3"

    local ix
    local target=""
    local icon="${ICONS[default]}"
    local colour="$WHITE"

    if [[ -L $line ]]; then
        target=${line:A}
        if [[ ! -e $target ]]; then
            # Broken symlink
            icon="${ICONS[symlink_broken]:-${ICONS[file]}}"
            colour=$RED
        elif [[ -d $target ]]; then
            icon="${ICONS[symlink_dir]}"
            colour=$CYAN
        elif [[ -x $target ]]; then
            icon="${ICONS[symlink_exec]}"
            colour=$GREEN
        elif [[ -f $target ]]; then
            icon="${ICONS[symlink_file]}"
            colour=$WHITE
        fi
    elif [[ -d $line ]]; then
        icon="${ICONS[directory]}"
        colour=$BLUE
    elif [[ -x $line ]]; then
        icon="${ICONS[executable]}"
        colour=$GREEN
    elif [[ -f $line ]]; then
        icon="${ICONS[file]}"
        colour=$WHITE
    fi

    if [[ ${line:A} == ${PWD} ]]; then
        colour=$YELLOW_B
    fi

    # Color ignored items red (gitignore + .git)
    if is_ignored "$line" || [[ "${line:t}" =~ '^\.git$' ]]; then
        colour=$RED
    fi

    local char="${GREY}"
    for ((ix=1; ix<depth; ix++)); do
        if (( arr[$ix] )); then
            char+="│  "
        else
            char+="   "
        fi
    done
    if [[ $depth -gt 0 ]]; then
        if (( $arr[$depth] )); then
            char+="├─ "
        else
            char+="└─ "
        fi
    fi
    char+="${NC}"

    # Apply italic to hidden files
    local style=""
    [[ "${line:t}" == .* ]] && style="${ITALIC}"

    local out="${char}${colour}${style}${icon} ${line:t}${NC}"
    if [[ $SIZES -gt 0 ]]; then
        local size="${SIZE_CACHE[$line]:-?}"
        out+=" ${GREY}(${size})${NC}"
    fi
    if [[ $COUNT_LINES -gt 0 ]] && [[ -f $line ]]; then
        local linecount="${LINECOUNT_CACHE[$line]:-0}"
        out+=" ${GREY}(${linecount} lines)${NC}"
    fi

    if [[ -z $target ]]; then
        echo "${out}"
    else
        echo "${out}  ${colour}${target/#$HOME/~}${NC}"
    fi
}

print_dir() {
    local file="$1"
    local depth="$2"
    local maxdepth="$3"
    local hidden="$4"
    local arr="$5"

    local ix
    local files
    local skip_expand=0

    if [[ -d $file ]] && [[ $depth -lt $maxdepth ]] && (( ! EXPAND_ALL )) && should_skip "${file:t}" "$file"; then
        skip_expand=1
    fi

    print_line "$file" "$depth" "$arr"

    if [[ ! -d $file ]] || [[ $depth -ge $maxdepth ]] || (( skip_expand )); then
        return
    fi

    # Skip unreadable directories
    if [[ ! -r $file ]]; then
        return
    fi

    setopt local_options nullglob
    if (( hidden )); then
        files=("$file"/.* "$file"/*)
        files=("${files[@]:#*/.}")
        files=("${files[@]:#*/..}")
    else
        files=("$file"/*)
    fi

    # Apply sorting
    local -a sorted_files=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && sorted_files+=("$f")
    done < <(apply_sorting "${files[@]}")
    files=("${sorted_files[@]}")

    for ((ix=1; ix<=${#files[@]}; ix++)); do
        local current="${files[$ix]}"
        if (( ix == ${#files[@]} )); then
            arr[$((depth + 1))]=0
        else
            arr[$((depth + 1))]=1
        fi
        print_dir "$current" $((depth + 1)) "$maxdepth" "$hidden" "$arr"
    done
}

# Print flat list (no tree structure)
print_list() {
    local dir="$1"
    local maxdepth="$2"
    local hidden="$3"

    local -a find_args=(-maxdepth "$maxdepth")
    (( ! hidden )) && find_args+=(-not -path '*/.*')

    local -a items=()
    while IFS= read -r item; do
        [[ -n "$item" ]] && items+=("$item")
    done < <(/usr/bin/find "${dir:A}" "${find_args[@]}" 2>/dev/null | /usr/bin/tail -n +2 | /usr/bin/sort)

    # Apply sorting
    local -a sorted_items=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && sorted_items+=("$f")
    done < <(apply_sorting "${items[@]}")

    for item in "${sorted_items[@]}"; do
        print_line "$item" 0 ""
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

# Check if current directory exists
if ! /bin/pwd &>/dev/null; then
    error "Current directory no longer exists"
fi

# Load icons from TOML
load_icons

# Parse arguments
while [[ $# -gt 0 ]]; do
    if [[ $1 =~ ^-[a-zA-Z]{2,}$ ]]; then
        flags="${1#-}"
        shift
        for ((i=${#flags}; i>0; i--)); do
            set -- "-${flags:$((i-1)):1}" "$@"
        done
    fi
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --depth)
            if [[ -z "$2" ]] || [[ "$2" =~ ^- ]]; then
                error "--depth requires a numeric argument"
            fi
            if ! [[ "$2" =~ ^[0-9]+$ ]]; then
                error "--depth requires a numeric argument, got '$2'"
            fi
            DEPTH="$2"
            shift 2
            ;;
        --depth=*)
            val="${1#--depth=}"
            if ! [[ "$val" =~ ^[0-9]+$ ]]; then
                error "--depth requires a numeric argument, got '$val'"
            fi
            DEPTH="$val"
            shift
            ;;
        -t|--tree)
            DEPTH=$MAX_TREE_DEPTH
            shift
            ;;
        -s)
            SIZES=1
            shift
            ;;
        -l)
            COUNT_LINES=1
            shift
            ;;
        -a)
            HIDDEN=1
            shift
            ;;
        -c)
            CLEAR_SCREEN=1
            shift
            ;;
        --expand-all)
            EXPAND_ALL=1
            shift
            ;;
        --list)
            LIST_MODE=1
            shift
            ;;
        -S)
            SORT_BY="size"
            shift
            ;;
        -T)
            SORT_BY="time"
            shift
            ;;
        -N)
            SORT_BY="name"
            shift
            ;;
        -r)
            SORT_REVERSE=1
            shift
            ;;
        -*)
            error "Unknown option: $1"
            ;;
        *)
            if [[ -e $1 ]]; then
                DIRECTORIES+=("$1")
            else
                error "'$1' does not exist"
            fi
            shift
            ;;
    esac
done

# Default to current directory
if [[ ${#DIRECTORIES[@]} -eq 0 ]]; then
    DIRECTORIES=(".")
fi

# Build caches
for dir in "${DIRECTORIES[@]}"; do
    in_git=0
    /usr/bin/git rev-parse --is-inside-work-tree &>/dev/null && in_git=1
    need_mtime=$([[ "$SORT_BY" == "time" ]] && echo 1 || echo 0)

    build_caches "${dir:A}" "$DEPTH" "$HIDDEN" "$in_git" "$SIZES" "$COUNT_LINES" "$need_mtime"
done

# Clear screen if requested
if (( CLEAR_SCREEN )); then
    /usr/bin/clear
    /usr/bin/clear
fi

# Print output
for dir in "${DIRECTORIES[@]}"; do
    if (( LIST_MODE )); then
        print_list "$dir" "$DEPTH" "$HIDDEN"
    else
        arr=()
        for ((i=1; i<=DEPTH; i++)); do
            arr+=1
        done
        print_dir "${dir:A}" 0 "$DEPTH" "$HIDDEN" "$arr"
    fi
done

# Print line count summary
if (( COUNT_LINES )) && (( ${#LINECOUNT_CACHE[@]} > 0 )); then
    total=0
    for path count in "${(@kv)LINECOUNT_CACHE}"; do
        is_ignored "$path" && continue
        [[ "$path" == */.git/* ]] && continue
        (( total += count ))
    done
    echo ""
    echo "${GREY}Total: ${total} lines${NC}"
fi
