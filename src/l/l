#!/usr/bin/env zsh

# l - Enhanced directory listing with tree view
# Displays directories in a tree format with icons and colors

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
DEPTH=1
HIDDEN=0
SIZES=0
COUNT_LINES=0
EXPAND_ALL=0
CLEAR_SCREEN=0
LIST_MODE=0
NO_ICONS=0
SORT_BY=""       # "", "size", "time", "name"
SORT_REVERSE=0
DIRECTORIES=()
NO_EXPAND=('^\.git$')
MAX_TREE_DEPTH=50

# Associative arrays
typeset -A ICONS
typeset -A GITIGNORE_CACHE
typeset -A SIZE_CACHE
typeset -A LINECOUNT_CACHE
typeset -A MTIME_CACHE
typeset -A GIT_STATUS_CACHE
typeset -A FILE_TYPE_CACHE
typeset -a UNTRACKED_DIRS
typeset -a TEMP_FILES

# Cleanup temp files on exit/interrupt
cleanup() {
    for f in "${TEMP_FILES[@]}"; do
        [[ -f "$f" ]] && /bin/rm -f "$f"
    done
}
trap cleanup EXIT INT TERM

# Disable colors if not a tty
if [[ ! -t 1 ]]; then
    RED="" GREEN="" YELLOW="" BLUE="" CYAN="" WHITE="" GREY="" NC=""
    YELLOW_B="" BOLD="" ITALIC=""
fi

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: l [OPTIONS] [FILE ...]"
    echo ""
    echo "Options:"
    echo "  -a              Show hidden files"
    echo "  -c              Clear screen before displaying"
    echo "  -s              Show file/directory sizes"
    echo "  -l              Show line counts for files"
    echo "  -t, --tree      Show full tree (depth $MAX_TREE_DEPTH)"
    echo "  --depth INT     Limit tree depth"
    echo "  --expand-all    Expand all directories (ignore NO_EXPAND list)"
    echo "  --list          Flat list output (no tree structure)"
    echo "  --no-icons      Hide file/folder/git icons"
    echo ""
    echo "Sorting:"
    echo "  -S              Sort by size (largest first)"
    echo "  -T              Sort by modification time (newest first)"
    echo "  -N              Sort by name (alphabetical)"
    echo "  -r              Reverse sort order"
    echo ""
    echo "  -h, --help      Show this help message"
}


# Load icons from TOML file
load_icons() {
    local toml_file="$SCRIPT_DIR/icons.toml"
    [[ ! -f "$toml_file" ]] && return

    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        # Parse key = "value"
        if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"(.*)\"$ ]]; then
            ICONS[${match[1]}]="${match[2]}"
        fi
    done < "$toml_file"
}

is_ignored() {
    local path="$1"
    (( ${+GITIGNORE_CACHE[$path]} ))
}

# Get git status indicator for a path
# Sets GIT_INDICATOR variable directly (avoids subshell)
get_git_status_indicator() {
    GIT_INDICATOR=""
    local path="$1"
    (( NO_ICONS )) && return

    local git_st="${GIT_STATUS_CACHE[$path]}"

    [[ -z "$git_st" ]] && return

    local index="${git_st:0:1}"
    local worktree="${git_st:1:1}"

    # Untracked files
    if [[ "$git_st" == "??" ]]; then
        GIT_INDICATOR="${RED}${ICONS[git_untracked]:-?}${NC} "
        return
    fi

    # Ignored files
    if [[ "$git_st" == "!!" ]]; then
        return
    fi

    # Staged changes (index has changes)
    if [[ "$index" != " " && "$index" != "?" ]]; then
        GIT_INDICATOR="${YELLOW}${ICONS[git_staged]:-+}${NC} "
        return
    fi

    # Unstaged modifications
    if [[ "$worktree" == "M" ]]; then
        GIT_INDICATOR="${RED}${ICONS[git_modified]:-M}${NC} "
        return
    fi

    # Unstaged deletions
    if [[ "$worktree" == "D" ]]; then
        GIT_INDICATOR="${RED}${ICONS[git_deleted]:-D}${NC} "
        return
    fi
}

# Build all caches in parallel for a directory
build_caches() {
    local abs_dir="$1"
    local depth="$2"
    local hidden="$3"
    local need_git="$4"
    local need_size="$5"
    local need_lines="$6"
    local need_mtime="$7"
    local need_git_status="$8"

    # Base find arguments (reused by all cache builders)
    # Note: Don't filter hidden paths here - we need to cache all files that might
    # be encountered. The hidden filtering happens in print_dir via glob patterns.
    local -a base_args=(-maxdepth "$depth" -not -path '*/.git/*')

    # Create temp files only for needed caches
    local git_tmp="" size_tmp="" line_tmp="" mtime_tmp="" git_status_tmp="" ftype_tmp=""
    if (( need_git )); then git_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$git_tmp"); fi
    if (( need_size )); then size_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$size_tmp"); fi
    if (( need_lines )); then line_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$line_tmp"); fi
    if (( need_mtime )); then mtime_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$mtime_tmp"); fi
    if (( need_git_status )); then git_status_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$git_status_tmp"); fi
    ftype_tmp=$(/usr/bin/mktemp); TEMP_FILES+=("$ftype_tmp")

    # Run cache builders in parallel
    # Git ignore check: handle nested repos by finding all .git dirs and checking each repo separately
    [[ -n "$git_tmp" ]] && {
        # Find all git repos (including nested ones)
        local -a git_repos=()
        while IFS= read -r gitdir; do
            [[ -n "$gitdir" ]] && git_repos+=("${gitdir:h}")  # :h gets parent dir
        done < <(/usr/bin/find "$abs_dir" "${base_args[@]}" -name .git -type d 2>/dev/null)
        # Also check if abs_dir itself is in a repo
        local top_repo
        top_repo=$(/usr/bin/git -C "$abs_dir" rev-parse --show-toplevel 2>/dev/null)
        [[ -n "$top_repo" ]] && git_repos=("$top_repo" "${git_repos[@]}")
        # For each repo, check which files are ignored
        for repo in "${git_repos[@]}"; do
            /usr/bin/find "$abs_dir" "${base_args[@]}" 2>/dev/null | \
                while IFS= read -r fpath; do
                    # Only check files that are under this repo
                    [[ "$fpath" == "$repo"/* || "$fpath" == "$repo" ]] || continue
                    # Skip if file is in a deeper nested repo
                    local dominated=0
                    for other in "${git_repos[@]}"; do
                        [[ "$other" == "$repo" ]] && continue
                        [[ "$other" == "$repo"/* && "$fpath" == "$other"/* ]] && dominated=1 && break
                    done
                    (( dominated )) && continue
                    printf '%s\n' "$fpath"
                done | /usr/bin/git -C "$repo" check-ignore --stdin 2>/dev/null
        done > "$git_tmp"
    } &
    [[ -n "$size_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" -exec /usr/bin/du -sh {} + 2>/dev/null > "$size_tmp"
    } &
    [[ -n "$line_tmp" ]] && {
        /usr/bin/find "$abs_dir" "${base_args[@]}" -type f -exec /usr/bin/wc -l {} + 2>/dev/null > "$line_tmp"
    } &
    [[ -n "$mtime_tmp" ]] && {
        if (( ZU_IS_MACOS )); then
            /usr/bin/find "$abs_dir" "${base_args[@]}" -exec /usr/bin/stat -f '%m %N' {} + 2>/dev/null > "$mtime_tmp"
        else
            /usr/bin/find "$abs_dir" "${base_args[@]}" -exec stat -c '%Y %n' {} + 2>/dev/null > "$mtime_tmp"
        fi
    } &
    [[ -n "$git_status_tmp" ]] && {
        /usr/bin/git -C "$abs_dir" status --porcelain 2>/dev/null > "$git_status_tmp"
    } &
    # File type cache: "Type|perms|path"
    # macOS: stat -f '%HT|%Sp|%N' -> "Directory|drwxr-xr-x|/path"
    # Linux: stat -c '%F|%A|%n'   -> "directory|drwxr-xr-x|/path"
    if (( ZU_IS_MACOS )); then
        /usr/bin/find "$abs_dir" "${base_args[@]}" -exec /usr/bin/stat -f '%HT|%Sp|%N' {} + 2>/dev/null > "$ftype_tmp" &
    else
        /usr/bin/find "$abs_dir" "${base_args[@]}" -exec stat -c '%F|%A|%n' {} + 2>/dev/null > "$ftype_tmp" &
    fi
    wait

    # Load results into caches
    [[ -n "$git_tmp" ]] && {
        while IFS= read -r path; do
            [[ -n "$path" ]] && GITIGNORE_CACHE[$path]=1
        done < "$git_tmp"
        /bin/rm -f "$git_tmp"
    }
    [[ -n "$size_tmp" ]] && {
        while IFS=$'\t' read -r size path; do
            [[ -n "$path" ]] && SIZE_CACHE[$path]="${size#"${size%%[! ]*}"}"
        done < "$size_tmp"
        /bin/rm -f "$size_tmp"
    }
    [[ -n "$line_tmp" ]] && {
        while read -r count path; do
            [[ -n "$path" && "$path" != "total" ]] && LINECOUNT_CACHE[$path]="$count"
        done < "$line_tmp"
        /bin/rm -f "$line_tmp"
    }
    [[ -n "$mtime_tmp" ]] && {
        while read -r mtime path; do
            [[ -n "$path" ]] && MTIME_CACHE[$path]="$mtime"
        done < "$mtime_tmp"
        /bin/rm -f "$mtime_tmp"
    }
    [[ -n "$git_status_tmp" ]] && {
        local git_root
        git_root=$(/usr/bin/git -C "$abs_dir" rev-parse --show-toplevel 2>/dev/null)
        while IFS= read -r git_line; do
            [[ -z "$git_line" ]] && continue
            local git_st="${git_line:0:2}"
            local git_file="${git_line:3}"
            # Handle renamed files (format: "R  old -> new")
            if [[ "$git_file" == *" -> "* ]]; then
                git_file="${git_file##* -> }"
            fi
            # Track untracked directories (end with /)
            if [[ "$git_st" == "??" && "$git_file" == */ ]]; then
                UNTRACKED_DIRS+=("${git_root}/${git_file}")
            fi
            # Strip trailing slash from directories
            git_file="${git_file%/}"
            local full_path="${git_root}/${git_file}"
            GIT_STATUS_CACHE[$full_path]="$git_st"
        done < "$git_status_tmp"
        /bin/rm -f "$git_status_tmp"
    }
    # Load file type cache: "Type|perms|path" -> single char code
    # macOS: "Symbolic Link", "Directory", "Regular File"
    # Linux: "symbolic link", "directory", "regular file"
    while IFS='|' read -r ftype perms fpath; do
        [[ -z "$fpath" ]] && continue
        local code=""
        case "${ftype:l}" in  # :l converts to lowercase
            symbolic\ link) code="l" ;;
            directory) code="d" ;;
            *) [[ "${perms:3:1}" == "x" ]] && code="x" || code="f" ;;
        esac
        FILE_TYPE_CACHE[$fpath]="$code"
    done < "$ftype_tmp"
    /bin/rm -f "$ftype_tmp"
}

should_skip() {
    local name="$1"
    local path="$2"

    for pattern in "${NO_EXPAND[@]}"; do
        if [[ $name =~ $pattern ]]; then
            return 0
        fi
    done

    is_ignored "$path"
}

# Sort files array based on SORT_BY and SORT_REVERSE
sort_files() {
    local -a input=("$@")
    local -a sorted=()

    case "$SORT_BY" in
        size)
            # Sort by size (largest first by default) - use cache if available
            while IFS= read -r f; do
                [[ -n "$f" ]] && sorted+=("$f")
            done < <(for f in "${input[@]}"; do
                local size=0
                if [[ -n "${SIZE_CACHE[$f]}" ]]; then
                    size="${SIZE_CACHE[$f]}"
                elif [[ -e "$f" ]]; then
                    size=$(/usr/bin/du -sk "$f" 2>/dev/null | /usr/bin/cut -f1)
                    size=${size:-0}
                fi
                printf '%s\t%s\n' "$size" "$f"
            done | /usr/bin/sort -t$'\t' -k1 -n -r | /usr/bin/cut -f2-)
            ;;
        time)
            # Sort by mtime (newest first by default) - use cache if available
            while IFS= read -r f; do
                [[ -n "$f" ]] && sorted+=("$f")
            done < <(for f in "${input[@]}"; do
                local mtime=0
                if [[ -n "${MTIME_CACHE[$f]}" ]]; then
                    mtime="${MTIME_CACHE[$f]}"
                elif [[ -e "$f" ]]; then
                    if (( ZU_IS_MACOS )); then
                        mtime=$(/usr/bin/stat -f '%m' "$f" 2>/dev/null || echo 0)
                    else
                        mtime=$(stat -c '%Y' "$f" 2>/dev/null || echo 0)
                    fi
                fi
                printf '%s\t%s\n' "$mtime" "$f"
            done | /usr/bin/sort -t$'\t' -k1 -n -r | /usr/bin/cut -f2-)
            ;;
        name)
            # Sort alphabetically
            while IFS= read -r f; do
                [[ -n "$f" ]] && sorted+=("$f")
            done < <(printf '%s\n' "${input[@]}" | /usr/bin/sort)
            ;;
        *)
            # No sorting
            sorted=("${input[@]}")
            ;;
    esac

    if (( SORT_REVERSE )); then
        sorted=("${(Oa)sorted[@]}")
    fi

    printf '%s\n' "${sorted[@]}"
}

# Apply sorting to an array, returns sorted array via stdout
apply_sorting() {
    local -a items=("$@")
    if [[ -n "$SORT_BY" ]] || (( SORT_REVERSE )); then
        local -a sorted=()
        while IFS= read -r f; do
            [[ -n "$f" ]] && sorted+=("$f")
        done < <(sort_files "${items[@]}")
        printf '%s\n' "${sorted[@]}"
    else
        printf '%s\n' "${items[@]}"
    fi
}

print_line() {
    local line="$1"
    local depth="$2"
    local arr="$3"

    local ix
    local target=""
    local icon=""
    local colour="$WHITE"
    local ftype="${FILE_TYPE_CACHE[$line]}"

    # Fallback if not in cache (e.g., stat failed due to permissions)
    if [[ -z "$ftype" ]]; then
        if [[ -L "$line" ]]; then ftype="l"
        elif [[ -d "$line" ]]; then ftype="d"
        elif [[ -x "$line" ]]; then ftype="x"
        elif [[ -e "$line" ]]; then ftype="f"
        fi
    fi

    if (( ! NO_ICONS )); then
        icon="${ICONS[default]}"
        case "$ftype" in
            l)  # Symlink - check target type
                target=${line:A}
                local target_type="${FILE_TYPE_CACHE[$target]}"
                # Fallback to direct check if target not in cache
                if [[ -z "$target_type" ]]; then
                    if [[ -d "$target" ]]; then target_type="d"
                    elif [[ -x "$target" ]]; then target_type="x"
                    elif [[ -e "$target" ]]; then target_type="f"
                    fi
                fi
                case "$target_type" in
                    d) icon="${ICONS[symlink_dir]}"; colour=$CYAN ;;
                    x) icon="${ICONS[symlink_exec]}"; colour=$GREEN ;;
                    f) icon="${ICONS[symlink_file]}"; colour=$WHITE ;;
                    *) icon="${ICONS[symlink_broken]:-${ICONS[file]}}"; colour=$RED ;;
                esac
                ;;
            d)
                # Use current_dir icon if this is the current directory
                if [[ ${line:A} == ${PWD} ]]; then
                    icon="${ICONS[current_dir]:-${ICONS[directory]}}"
                else
                    icon="${ICONS[directory]}"
                fi
                colour=$BLUE
                ;;
            x) icon="${ICONS[executable]}"; colour=$GREEN ;;
            f) icon="${ICONS[file]}"; colour=$WHITE ;;
        esac
    else
        # When no icons, still determine file type for color
        case "$ftype" in
            l)
                target=${line:A}
                local target_type="${FILE_TYPE_CACHE[$target]}"
                if [[ -z "$target_type" ]]; then
                    if [[ -d "$target" ]]; then target_type="d"
                    elif [[ -x "$target" ]]; then target_type="x"
                    elif [[ -e "$target" ]]; then target_type="f"
                    fi
                fi
                case "$target_type" in
                    d) colour=$CYAN ;;
                    x) colour=$GREEN ;;
                    f) colour=$WHITE ;;
                    *) colour=$RED ;;
                esac
                ;;
            d) colour=$BLUE ;;
            x) colour=$GREEN ;;
            f) colour=$WHITE ;;
        esac
    fi

    if [[ ${line:A} == ${PWD} ]]; then
        colour=$YELLOW_B
    fi

    # Color ignored items grey (gitignore + .git)
    if (( ${+GITIGNORE_CACHE[$line]} )) || [[ "${line:t}" == ".git" ]]; then
        colour=$GREY
    fi

    local char="${GREY}"
    for ((ix=1; ix<depth; ix++)); do
        if (( arr[$ix] )); then
            char+="│  "
        else
            char+="   "
        fi
    done
    if [[ $depth -gt 0 ]]; then
        if (( $arr[$depth] )); then
            char+="├─ "
        else
            char+="└─ "
        fi
    fi
    char+="${NC}"

    # Apply italic to hidden files
    local style=""
    [[ "${line:t}" == .* ]] && style="${ITALIC}"

    # Git status indicator (only call function if file has status)
    local git_indicator=""
    if (( ${+GIT_STATUS_CACHE[$line]} )); then
        get_git_status_indicator "$line"
        git_indicator="$GIT_INDICATOR"
    elif (( ${#UNTRACKED_DIRS[@]} )); then
        # Check if inside an untracked directory
        for udir in "${UNTRACKED_DIRS[@]}"; do
            if [[ "$line" == ${udir}* ]]; then
                git_indicator="${RED}${ICONS[git_untracked]:-?}${NC} "
                break
            fi
        done
    fi

    local out="${char}${git_indicator}${colour}${style}"
    if (( ! NO_ICONS )); then
        out+="${icon} "
    fi
    out+="${line:t}${NC}"
    if [[ $SIZES -gt 0 ]]; then
        local size="${SIZE_CACHE[$line]:-?}"
        out+=" ${GREY}(${size})${NC}"
    fi
    if [[ $COUNT_LINES -gt 0 ]] && [[ -f $line ]]; then
        local linecount="${LINECOUNT_CACHE[$line]:-0}"
        out+=" ${GREY}(${linecount} lines)${NC}"
    fi

    if [[ -z $target ]]; then
        echo "${out}"
    else
        echo "${out}  ${colour}${target/#$HOME/~}${NC}"
    fi
}

print_dir() {
    local file="$1"
    local depth="$2"
    local maxdepth="$3"
    local hidden="$4"
    local arr="$5"

    local ix
    local files
    local skip_expand=0

    if [[ -d $file ]] && [[ $depth -lt $maxdepth ]] && (( ! EXPAND_ALL )) && (( depth > 0 )) && should_skip "${file:t}" "$file"; then
        skip_expand=1
    fi

    print_line "$file" "$depth" "$arr"

    if [[ ! -d $file ]] || [[ $depth -ge $maxdepth ]] || (( skip_expand )); then
        return
    fi

    # Skip unreadable directories
    if [[ ! -r $file ]]; then
        return
    fi

    setopt local_options nullglob
    if (( hidden )); then
        files=("$file"/.* "$file"/*)
        files=("${files[@]:#*/.}")
        files=("${files[@]:#*/..}")
    else
        files=("$file"/*)
    fi

    # Apply sorting
    local -a sorted_files=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && sorted_files+=("$f")
    done < <(apply_sorting "${files[@]}")
    files=("${sorted_files[@]}")

    for ((ix=1; ix<=${#files[@]}; ix++)); do
        local current="${files[$ix]}"
        if (( ix == ${#files[@]} )); then
            arr[$((depth + 1))]=0
        else
            arr[$((depth + 1))]=1
        fi
        print_dir "$current" $((depth + 1)) "$maxdepth" "$hidden" "$arr"
    done
}

# Print flat list (no tree structure)
print_list() {
    local dir="$1"
    local maxdepth="$2"
    local hidden="$3"

    local -a find_args=(-maxdepth "$maxdepth" -not -path '*/.git/*')

    local -a items=()
    while IFS= read -r item; do
        [[ -n "$item" ]] && items+=("$item")
    done < <(/usr/bin/find "${dir:A}" "${find_args[@]}" 2>/dev/null | /usr/bin/tail -n +2 | /usr/bin/sort)

    # Apply sorting
    local -a sorted_items=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && sorted_items+=("$f")
    done < <(apply_sorting "${items[@]}")

    for item in "${sorted_items[@]}"; do
        print_line "$item" 0 ""
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

# Check if current directory exists
if ! /bin/pwd &>/dev/null; then
    error "Current directory no longer exists"
fi

# Load icons from TOML
load_icons

# Parse arguments
while [[ $# -gt 0 ]]; do
    if [[ $1 =~ ^-[a-zA-Z]{2,}$ ]]; then
        flags="${1#-}"
        shift
        for ((i=${#flags}; i>0; i--)); do
            set -- "-${flags:$((i-1)):1}" "$@"
        done
    fi
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --depth)
            if [[ -z "$2" ]] || [[ "$2" =~ ^- ]]; then
                error "--depth requires a numeric argument"
            fi
            if ! [[ "$2" =~ ^[0-9]+$ ]]; then
                error "--depth requires a numeric argument, got '$2'"
            fi
            DEPTH="$2"
            shift 2
            ;;
        --depth=*)
            val="${1#--depth=}"
            if ! [[ "$val" =~ ^[0-9]+$ ]]; then
                error "--depth requires a numeric argument, got '$val'"
            fi
            DEPTH="$val"
            shift
            ;;
        -t|--tree)
            DEPTH=$MAX_TREE_DEPTH
            shift
            ;;
        -s)
            SIZES=1
            shift
            ;;
        -l)
            COUNT_LINES=1
            shift
            ;;
        -a)
            HIDDEN=1
            shift
            ;;
        -c)
            CLEAR_SCREEN=1
            shift
            ;;
        --expand-all)
            EXPAND_ALL=1
            shift
            ;;
        --list)
            LIST_MODE=1
            shift
            ;;
        --no-icons)
            NO_ICONS=1
            shift
            ;;
        -S)
            SORT_BY="size"
            shift
            ;;
        -T)
            SORT_BY="time"
            shift
            ;;
        -N)
            SORT_BY="name"
            shift
            ;;
        -r)
            SORT_REVERSE=1
            shift
            ;;
        -*)
            error "Unknown option: $1"
            ;;
        *)
            if [[ -e $1 ]]; then
                DIRECTORIES+=("$1")
            else
                error "'$1' does not exist"
            fi
            shift
            ;;
    esac
done

# Default to current directory
if [[ ${#DIRECTORIES[@]} -eq 0 ]]; then
    DIRECTORIES=(".")
fi

# Build caches
for dir in "${DIRECTORIES[@]}"; do
    in_git=0
    /usr/bin/git -C "${dir:A}" rev-parse --is-inside-work-tree &>/dev/null && in_git=1
    need_mtime=$([[ "$SORT_BY" == "time" ]] && echo 1 || echo 0)
    need_git_status=$in_git
    # Always check gitignore - there might be nested repos even if top dir isn't a repo
    need_git=1

    build_caches "${dir:A}" "$DEPTH" "$HIDDEN" "$need_git" "$SIZES" "$COUNT_LINES" "$need_mtime" "$need_git_status"
done

# Clear screen if requested
if (( CLEAR_SCREEN )); then
    /usr/bin/clear
    /usr/bin/clear
fi

# Print output
for dir in "${DIRECTORIES[@]}"; do
    if (( LIST_MODE )); then
        print_list "$dir" "$DEPTH" "$HIDDEN"
    else
        arr=()
        for ((i=1; i<=DEPTH; i++)); do
            arr+=1
        done
        print_dir "${dir:A}" 0 "$DEPTH" "$HIDDEN" "$arr"
    fi
done

# Print line count summary
if (( COUNT_LINES )) && (( ${#LINECOUNT_CACHE[@]} > 0 )); then
    total=0
    for path count in "${(@kv)LINECOUNT_CACHE}"; do
        is_ignored "$path" && continue
        [[ "$path" == */.git/* ]] && continue
        (( total += count ))
    done
    echo ""
    echo "${GREY}Total: ${total} lines${NC}"
fi
