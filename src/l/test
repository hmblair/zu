#!/usr/bin/env zsh

# Simple test script for l utility
# Run with: ./test

SCRIPT_DIR="${0:A:h}"
L="$SCRIPT_DIR/l"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

PASSED=0
FAILED=0

pass() { echo "${GREEN}✓ PASS:${NC} $1"; ((++PASSED)); }
fail() { echo "${RED}✗ FAIL:${NC} $1"; ((++FAILED)); }
info() { echo "${YELLOW}► $1${NC}"; }

# ─────────────────────────────────────────────────────────────────────────────
# Setup test directory
# ─────────────────────────────────────────────────────────────────────────────

TEST_DIR=$(/usr/bin/mktemp -d)
trap "/bin/rm -rf '$TEST_DIR'" EXIT

# Create test structure
mkdir -p "$TEST_DIR/dir_a"
mkdir -p "$TEST_DIR/dir_b"
mkdir -p "$TEST_DIR/dir_a/nested"
mkdir -p "$TEST_DIR/.hidden_dir"

echo "line 1" > "$TEST_DIR/file1.txt"
echo -e "line 1\nline 2\nline 3" > "$TEST_DIR/file2.txt"
echo "content" > "$TEST_DIR/dir_a/file_a.txt"
echo "nested content" > "$TEST_DIR/dir_a/nested/deep.txt"
echo "hidden" > "$TEST_DIR/.hidden_file"
echo "in hidden" > "$TEST_DIR/.hidden_dir/inside.txt"

# Create executable
echo '#!/bin/sh' > "$TEST_DIR/script.sh"
chmod +x "$TEST_DIR/script.sh"

# Create symlink
ln -s "$TEST_DIR/file1.txt" "$TEST_DIR/link_to_file"

# ─────────────────────────────────────────────────────────────────────────────
# Syntax check
# ─────────────────────────────────────────────────────────────────────────────

info "Checking syntax..."

zsh -n "$L" 2>/dev/null && pass "l script syntax" || fail "l script syntax"

# ─────────────────────────────────────────────────────────────────────────────
# Help command
# ─────────────────────────────────────────────────────────────────────────────

info "Testing help..."

output=$("$L" --help 2>&1)
[[ "$output" == *"Usage: l"* ]] && pass "help shows usage" || fail "help shows usage"
[[ "$output" == *"-a"* ]] && pass "help shows -a option" || fail "help shows -a option"
[[ "$output" == *"-s"* ]] && pass "help shows -s option" || fail "help shows -s option"
[[ "$output" == *"-S"* ]] && pass "help shows -S option" || fail "help shows -S option"
[[ "$output" == *"-T"* ]] && pass "help shows -T option" || fail "help shows -T option"

# ─────────────────────────────────────────────────────────────────────────────
# Basic listing
# ─────────────────────────────────────────────────────────────────────────────

info "Testing basic listing..."

output=$("$L" "$TEST_DIR" 2>&1)
[[ "$output" == *"dir_a"* ]] && pass "shows directory" || fail "shows directory"
[[ "$output" == *"file1.txt"* ]] && pass "shows file" || fail "shows file"
[[ "$output" == *"script.sh"* ]] && pass "shows executable" || fail "shows executable"
[[ "$output" == *"link_to_file"* ]] && pass "shows symlink" || fail "shows symlink"
[[ "$output" != *".hidden_file"* ]] && pass "hides hidden files by default" || fail "hides hidden files by default"

# ─────────────────────────────────────────────────────────────────────────────
# Hidden files
# ─────────────────────────────────────────────────────────────────────────────

info "Testing hidden files (-a)..."

output=$("$L" -a "$TEST_DIR" 2>&1)
[[ "$output" == *".hidden_file"* ]] && pass "-a shows hidden files" || fail "-a shows hidden files"
[[ "$output" == *".hidden_dir"* ]] && pass "-a shows hidden directories" || fail "-a shows hidden directories"

# ─────────────────────────────────────────────────────────────────────────────
# Size display
# ─────────────────────────────────────────────────────────────────────────────

info "Testing size display (-s)..."

output=$("$L" -s "$TEST_DIR" 2>&1)
# Size output includes parentheses with size like (4.0K)
[[ "$output" =~ \([0-9.]+[KMGTP]?\) ]] && pass "-s shows sizes" || fail "-s shows sizes"

# ─────────────────────────────────────────────────────────────────────────────
# Line count display
# ─────────────────────────────────────────────────────────────────────────────

info "Testing line count (-l)..."

output=$("$L" -l "$TEST_DIR" 2>&1)
[[ "$output" == *"lines"* ]] && pass "-l shows line counts" || fail "-l shows line counts"
[[ "$output" == *"3 lines"* ]] && pass "-l shows correct count for file2.txt" || fail "-l shows correct count for file2.txt"

# ─────────────────────────────────────────────────────────────────────────────
# Sorting
# ─────────────────────────────────────────────────────────────────────────────

info "Testing sorting options..."

# Size sort - larger items first
output=$("$L" -S "$TEST_DIR" 2>&1)
[[ -n "$output" ]] && pass "-S size sort runs" || fail "-S size sort runs"

# Time sort - newer items first
output=$("$L" -T "$TEST_DIR" 2>&1)
[[ -n "$output" ]] && pass "-T time sort runs" || fail "-T time sort runs"

# Name sort - alphabetical
output=$("$L" -N "$TEST_DIR" 2>&1)
[[ -n "$output" ]] && pass "-N name sort runs" || fail "-N name sort runs"

# Reverse sort
output=$("$L" -r "$TEST_DIR" 2>&1)
[[ -n "$output" ]] && pass "-r reverse sort runs" || fail "-r reverse sort runs"

# ─────────────────────────────────────────────────────────────────────────────
# Depth control
# ─────────────────────────────────────────────────────────────────────────────

info "Testing depth control..."

# Default depth 1 - should not show nested content
output=$("$L" "$TEST_DIR/dir_a" 2>&1)
[[ "$output" != *"deep.txt"* ]] && pass "default depth=1 hides nested" || fail "default depth=1 hides nested"

# Depth 2 - should show nested content
output=$("$L" --depth 2 "$TEST_DIR/dir_a" 2>&1)
[[ "$output" == *"deep.txt"* ]] && pass "--depth 2 shows nested" || fail "--depth 2 shows nested"

# Tree mode - full depth
output=$("$L" --tree "$TEST_DIR/dir_a" 2>&1)
[[ "$output" == *"deep.txt"* ]] && pass "--tree shows full depth" || fail "--tree shows full depth"

# Short tree flag
output=$("$L" -t "$TEST_DIR/dir_a" 2>&1)
[[ "$output" == *"deep.txt"* ]] && pass "-t shows full depth" || fail "-t shows full depth"

# ─────────────────────────────────────────────────────────────────────────────
# List mode
# ─────────────────────────────────────────────────────────────────────────────

info "Testing list mode..."

output=$("$L" --list "$TEST_DIR" 2>&1)
# List mode should not have tree characters
[[ "$output" != *"├─"* ]] && pass "--list has no tree chars" || fail "--list has no tree chars"
[[ "$output" != *"└─"* ]] && pass "--list has no branch chars" || fail "--list has no branch chars"

# ─────────────────────────────────────────────────────────────────────────────
# Combined options
# ─────────────────────────────────────────────────────────────────────────────

info "Testing combined options..."

output=$("$L" -as "$TEST_DIR" 2>&1)
[[ "$output" == *".hidden_file"* ]] && pass "-as shows hidden" || fail "-as shows hidden"
[[ "$output" =~ \([0-9.]+[KMGTP]?\) ]] && pass "-as shows sizes" || fail "-as shows sizes"

output=$("$L" -sl "$TEST_DIR" 2>&1)
[[ "$output" =~ \([0-9.]+[KMGTP]?\) ]] && pass "-sl shows sizes" || fail "-sl shows sizes"
[[ "$output" == *"lines"* ]] && pass "-sl shows lines" || fail "-sl shows lines"

# ─────────────────────────────────────────────────────────────────────────────
# Error handling
# ─────────────────────────────────────────────────────────────────────────────

info "Testing error handling..."

output=$("$L" /nonexistent/path 2>&1)
[[ "$output" == *"does not exist"* ]] && pass "rejects non-existent path" || fail "rejects non-existent path"

output=$("$L" --depth abc "$TEST_DIR" 2>&1)
[[ "$output" == *"numeric"* ]] && pass "rejects non-numeric depth" || fail "rejects non-numeric depth"

output=$("$L" --badoption "$TEST_DIR" 2>&1)
[[ "$output" == *"Unknown option"* ]] && pass "rejects unknown option" || fail "rejects unknown option"

# ─────────────────────────────────────────────────────────────────────────────
# Tree structure
# ─────────────────────────────────────────────────────────────────────────────

info "Testing tree structure..."

output=$("$L" "$TEST_DIR" 2>&1)
# Should have tree characters
[[ "$output" == *"├─"* ]] || [[ "$output" == *"└─"* ]] && pass "shows tree structure" || fail "shows tree structure"

# ─────────────────────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────────────────────

echo ""
if (( FAILED == 0 )); then
    echo "${GREEN}All $PASSED tests passed!${NC}"
else
    echo "${RED}$FAILED tests failed${NC}, $PASSED passed"
    exit 1
fi
