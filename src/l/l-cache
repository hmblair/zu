#!/usr/bin/env zsh

# l-cache - Size caching daemon manager for l
# Manages the l-cached daemon that watches for filesystem changes
# and maintains a cache of directory sizes.

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

PLIST_LABEL="com.zu.l-cached"
DAEMON_PATH="$SCRIPT_DIR/../../bin/l-cached"
LOG_FILE="/tmp/l-cached.log"
CACHE_DIR="$HOME/.cache/l"

usage() {
    echo "Usage: l-cache <command>"
    echo ""
    echo "Commands:"
    echo "  install     Install and start the size caching daemon"
    echo "  uninstall   Stop and remove the daemon"
    echo "  status      Show daemon status and cache info"
    echo "  clear       Clear the cache file"
    echo ""
    echo "The daemon scans / and ~/ for large directories (>=2500 files),"
    echo "watches ~/ for changes, and updates the cache every 5 minutes."
}

cmd_install() {
    if zu_service_exists "$PLIST_LABEL"; then
        echo "Daemon already installed"
        echo "Run ${CYAN}l-cache status${NC} to check status"
        return 1
    fi

    mkdir -p "$CACHE_DIR"

    zu_service_create "$PLIST_LABEL" "$DAEMON_PATH" \
        --args "/" "$HOME" \
        --type "keep_alive" \
        --log "$LOG_FILE" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$PLIST_LABEL"

    success "Daemon installed and started"
    echo "Scanning: / and $HOME (initial scan may be slow)"
    echo "Watching: $HOME"
    echo "Log: $LOG_FILE"
}

cmd_uninstall() {
    if ! zu_service_exists "$PLIST_LABEL"; then
        echo "Daemon not installed"
        return 1
    fi

    zu_service_remove "$PLIST_LABEL"
    success "Daemon uninstalled"
}

cmd_status() {
    echo "${BOLD}l-cache status${NC}"
    echo ""

    # Daemon status
    if zu_service_exists "$PLIST_LABEL"; then
        if zu_service_healthy "$PLIST_LABEL"; then
            echo "Daemon: ${GREEN}running${NC}"
        else
            echo "Daemon: ${YELLOW}installed but not running${NC}"
        fi
    else
        echo "Daemon: ${GREY}not installed${NC}"
        echo ""
        echo "Run ${CYAN}l-cache install${NC} to install"
        return
    fi

    # Cache info
    local cache_file="$CACHE_DIR/sizes.bin"
    if [[ -f "$cache_file" ]]; then
        local mtime=$(stat -f %Sm -t "%Y-%m-%d %H:%M" "$cache_file")
        # Read header: magic(4) version(4) count(4) capacity(4)
        local header=$(xxd -l 16 -p "$cache_file" 2>/dev/null)
        if [[ -n "$header" ]]; then
            # Parse little-endian uint32 values (bytes 8-11 = count, 12-15 = capacity)
            local count_hex="${header:22:2}${header:20:2}${header:18:2}${header:16:2}"
            local cap_hex="${header:30:2}${header:28:2}${header:26:2}${header:24:2}"
            local count=$((16#$count_hex))
            local capacity=$((16#$cap_hex))
            local pct=$((count * 100 / capacity))

            if (( pct >= 95 )); then
                echo "Cache: ${RED}$count/$capacity entries ($pct% full)${NC} - ${RED}NEARLY FULL${NC}"
            elif (( pct >= 80 )); then
                echo "Cache: ${YELLOW}$count/$capacity entries ($pct% full)${NC}"
            else
                echo "Cache: ${GREEN}$count/$capacity entries ($pct% full)${NC}"
            fi
            echo "       updated $mtime"
        else
            local size=$(du -h "$cache_file" | cut -f1)
            echo "Cache: ${GREEN}$size${NC} (updated $mtime)"
        fi
    else
        echo "Cache: ${GREY}not created yet${NC}"
    fi

    # Log info
    if [[ -f "$LOG_FILE" ]]; then
        local lines=$(wc -l < "$LOG_FILE" | tr -d ' ')
        echo "Log: $LOG_FILE ($lines lines)"
        echo ""
        echo "${GREY}Recent log:${NC}"
        tail -5 "$LOG_FILE" | sed 's/^/  /'
    fi
}

cmd_clear() {
    local cache_file="$CACHE_DIR/sizes.bin"
    if [[ -f "$cache_file" ]]; then
        rm "$cache_file"
        success "Cache cleared"
    else
        echo "No cache file found"
    fi
}

case "${1:-}" in
    install)
        cmd_install
        ;;
    uninstall)
        cmd_uninstall
        ;;
    status)
        cmd_status
        ;;
    clear)
        cmd_clear
        ;;
    help|--help|-h)
        usage
        ;;
    "")
        usage
        ;;
    *)
        error "Unknown command: $1. Run 'l-cache help' for usage."
        ;;
esac
