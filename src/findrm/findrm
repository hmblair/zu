#!/usr/bin/env zsh

# findrm - Recursively remove files and directories by name
# Finds and removes all files/directories matching a pattern throughout the tree

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: findrm [options] <name>...

Recursively find and remove all files/directories matching the given name(s).

Options:
  -D, --no-dirs    Skip directories (files only)
  -F, --no-files   Skip files (directories only)
  -n, --dry-run    Show what would be deleted without deleting
  -f, --force      Skip confirmation prompt
  -h, --help       Show this help message

Examples:
  findrm node_modules              # Remove all node_modules files and directories
  findrm __pycache__ .pytest_cache # Remove multiple patterns
  findrm -n build                  # Preview what would be deleted
  findrm -f dist                   # Delete without confirmation
  findrm -F .DS_Store              # Remove all .DS_Store files only
  findrm -D "*.pyc"                # Remove all .pyc directories only
EOF
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    local dry_run=false
    local force=false
    local include_dirs=true
    local include_files=true
    local names=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -D|--no-dirs)
                include_dirs=false
                shift
                ;;
            -F|--no-files)
                include_files=false
                shift
                ;;
            -n|--dry-run)
                dry_run=true
                shift
                ;;
            -f|--force)
                force=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                names+=("$1")
                shift
                ;;
        esac
    done

    if ! $include_dirs && ! $include_files; then
        error "Cannot use both --no-dirs and --no-files"
    fi

    if [[ ${#names[@]} -eq 0 ]]; then
        usage
        exit 1
    fi

    # Build find command for all patterns
    local find_args=()
    for name in "${names[@]}"; do
        [[ ${#find_args[@]} -gt 0 ]] && find_args+=("-o")
        if $include_dirs && $include_files; then
            find_args+=("-name" "$name")
        elif $include_dirs; then
            find_args+=("-type" "d" "-name" "$name")
        else
            find_args+=("-type" "f" "-name" "$name")
        fi
    done

    # Find all matching items
    local items=()
    while IFS= read -r item; do
        [[ -n "$item" ]] && items+=("$item")
    done < <(/usr/bin/find . \( "${find_args[@]}" \) 2>/dev/null | /usr/bin/sort)

    if [[ ${#items[@]} -eq 0 ]]; then
        echo "No matches found."
        exit 0
    fi

    # Show what will be deleted with sizes
    local count=${#items[@]}
    local item_word="item"
    [[ $count -ne 1 ]] && item_word="items"

    # Get sizes for all items
    local -A sizes
    local total_bytes=0
    for item in "${items[@]}"; do
        local bytes=$(/usr/bin/du -sk "$item" 2>/dev/null | /usr/bin/cut -f1)
        bytes=${bytes:-0}
        sizes[$item]=$(/usr/bin/du -sh "$item" 2>/dev/null | /usr/bin/cut -f1)
        ((total_bytes += bytes))
    done

    # Convert total KB to human readable
    local total_human
    if (( total_bytes >= 1048576 )); then
        total_human="$(/usr/bin/awk "BEGIN {printf \"%.1fG\", $total_bytes / 1048576}")"
    elif (( total_bytes >= 1024 )); then
        total_human="$(/usr/bin/awk "BEGIN {printf \"%.1fM\", $total_bytes / 1024}")"
    else
        total_human="${total_bytes}K"
    fi

    echo ""
    echo "${BOLD}Found $count $item_word ($total_human total):${NC}"
    for item in "${items[@]}"; do
        local size="${sizes[$item]:-?}"
        if [[ -d "$item" ]]; then
            printf "  ${RED}%-6s${NC} ${RED}%s/${NC}\n" "$size" "$item"
        else
            printf "  ${RED}%-6s${NC} ${RED}%s${NC}\n" "$size" "$item"
        fi
    done
    echo ""

    # Dry run - just show and exit
    if $dry_run; then
        echo "${YELLOW}Dry run - nothing deleted.${NC}"
        exit 0
    fi

    # Confirm unless forced
    if ! $force; then
        echo -n "Delete all? [y/N] "
        read -r confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    # Delete items (deepest first to avoid issues with directories)
    local deleted=0
    for item in $(printf '%s\n' "${items[@]}" | /usr/bin/awk -F/ '{print NF, $0}' | /usr/bin/sort -rn | /usr/bin/cut -d' ' -f2-); do
        if [[ -e "$item" ]]; then
            /bin/rm -rf "$item"
            ((deleted++))
        fi
    done

    item_word="item"
    [[ $deleted -ne 1 ]] && item_word="items"
    success "Deleted $deleted $item_word ($total_human)."
}

main "$@"
