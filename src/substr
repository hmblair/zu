#!/usr/bin/env zsh

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/common"

if [ $# -ne 3 ]; then
  echo "Usage: ${0:t} STR START END"
  exit 1
fi

string="$1"
start="$2"
end="$3"

# Validate that start and end are integers
[[ "$start" =~ ^-?[0-9]+$ ]] || error "START must be an integer, got '$start'"
[[ "$end" =~ ^-?[0-9]+$ ]] || error "END must be an integer, got '$end'"

str_len=${#string}

if [ "$start" -lt 0 ]; then
  start=$((str_len + start))
fi

if [ "$end" -lt 0 ]; then
  end=$((str_len + end))
fi

if [ "$start" -lt 0 ] || [ "$end" -lt 0 ] || [ "$start" -gt "$end" ] || [ "$start" -ge "$str_len" ]; then
  error "Invalid position values"
fi

length=$((end - start))
result="${string:$start:$length}"
echo "$result"
