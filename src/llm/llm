#!/usr/bin/env zsh
# Simple wrapper around llama-cli

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/llm"
PROMPTS_FILE="$CONFIG_DIR/prompts.json"
SELECTED_PROMPT_FILE="$CONFIG_DIR/selected_prompt"
SELECTED_MODEL_FILE="$CONFIG_DIR/selected_model"
SELECTED_TEMP_FILE="$CONFIG_DIR/temperature"
SELECTED_TEMPLATE_FILE="$CONFIG_DIR/template"
TEMPLATES_DIR="$SCRIPT_DIR/templates"
THEME_FILE="$SCRIPT_DIR/theme.json"
PID_FILE="$CONFIG_DIR/server.pid"
CACHE_DIR="$HOME/Library/Caches/llama.cpp"
SERVER_PORT=8787
DEFAULT_MODEL="bartowski/Llama-3.2-3B-Instruct-GGUF:Q4_K_M"
DEFAULT_TEMP=0.8
CONTEXT_SIZE=32768
VERBOSE=false
CONVERSATION=false
FORMAT=true

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Load selected model (validate it exists in cache)
model_in_cache() {
    local model="$1"
    # Convert model ID to manifest filename: owner/repo:quant -> manifest=owner=repo=quant.json
    local manifest="${model//\//=}"  # / -> =
    manifest="${manifest//:/=}"       # : -> =
    [[ -f "$CACHE_DIR/manifest=${manifest}.json" ]]
}

if [[ -f "$SELECTED_MODEL_FILE" ]]; then
    MODEL=$(<"$SELECTED_MODEL_FILE")
    if ! model_in_cache "$MODEL"; then
        MODEL="$DEFAULT_MODEL"
        rm -f "$SELECTED_MODEL_FILE"
    fi
else
    MODEL="$DEFAULT_MODEL"
fi

# Load temperature
if [[ -f "$SELECTED_TEMP_FILE" ]]; then
    TEMPERATURE=$(<"$SELECTED_TEMP_FILE")
else
    TEMPERATURE="$DEFAULT_TEMP"
fi

# Load chat template (empty = use model default)
if [[ -f "$SELECTED_TEMPLATE_FILE" ]]; then
    CHAT_TEMPLATE=$(<"$SELECTED_TEMPLATE_FILE")
else
    CHAT_TEMPLATE=""
fi

# Initialize default prompts if none exist
if [[ ! -f "$PROMPTS_FILE" ]]; then
    cat > "$PROMPTS_FILE" <<'EOF'
{
  "concise": "Be concise and direct. Give short answers without unnecessary explanation.",
  "detailed": "Provide thorough, detailed explanations with examples.",
  "code": "You are a coding assistant. Provide clean, working code with brief explanations."
}
EOF
    echo "concise" > "$SELECTED_PROMPT_FILE"
fi

# JSON prompt helpers
prompt_get() {
    local name="$1"
    python3 -c "
import json
with open('$PROMPTS_FILE') as f:
    prompts = json.load(f)
print(prompts.get('$name', ''))
" 2>/dev/null
}

prompt_list() {
    python3 -c "
import json
with open('$PROMPTS_FILE') as f:
    prompts = json.load(f)
for name in prompts:
    print(name)
" 2>/dev/null
}

prompt_exists() {
    local name="$1"
    python3 -c "
import json
with open('$PROMPTS_FILE') as f:
    prompts = json.load(f)
exit(0 if '$name' in prompts else 1)
" 2>/dev/null
}

prompt_set() {
    local name="$1"
    local text="$2"
    python3 -c "
import json
with open('$PROMPTS_FILE') as f:
    prompts = json.load(f)
prompts['''$name'''] = '''$text'''
with open('$PROMPTS_FILE', 'w') as f:
    json.dump(prompts, f, indent=2)
" 2>/dev/null
}

prompt_remove() {
    local name="$1"
    python3 -c "
import json
with open('$PROMPTS_FILE') as f:
    prompts = json.load(f)
prompts.pop('$name', None)
with open('$PROMPTS_FILE', 'w') as f:
    json.dump(prompts, f, indent=2)
" 2>/dev/null
}

# Get current system prompt
get_system_prompt() {
    local selected
    if [[ -f "$SELECTED_PROMPT_FILE" ]]; then
        selected=$(<"$SELECTED_PROMPT_FILE")
        prompt_get "$selected"
    fi
}

# Server management
server_running() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid=$(cat "$PID_FILE")
    ps -p "$pid" -o comm= 2>/dev/null | grep -q llama-server || return 1
    # Also check API is responsive
    curl -s --max-time 2 "http://localhost:$SERVER_PORT/health" >/dev/null 2>&1
}

cmd_serve() {
    # Parse serve options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --context)
                CONTEXT_SIZE="$2"
                shift 2
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done

    if server_running; then
        warn "Server already running (PID: $(cat "$PID_FILE"))"
        return 0
    fi

    info "Starting llama server (context: $CONTEXT_SIZE)..."

    local -a SERVER_ARGS=(
        --hf-repo "$MODEL"
        --ctx-size "$CONTEXT_SIZE"
        --port "$SERVER_PORT"
    )

    if [[ -n "$CHAT_TEMPLATE" ]]; then
        if [[ -f "$CHAT_TEMPLATE" ]]; then
            SERVER_ARGS+=(--jinja --chat-template-file "$CHAT_TEMPLATE")
        else
            SERVER_ARGS+=(--chat-template "$CHAT_TEMPLATE")
        fi
    fi

    llama-server "${SERVER_ARGS[@]}" >/dev/null 2>&1 &

    local pid=$!
    disown  # Detach from shell so it survives script exit
    echo "$pid" > "$PID_FILE"

    # Wait for server to be ready
    local attempts=0
    while ! curl -s "http://localhost:$SERVER_PORT/health" >/dev/null 2>&1; do
        sleep 0.5
        ((attempts++))
        if [[ $attempts -gt 120 ]]; then
            error "Server failed to start (timeout)"
        fi
        # Check if process died
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            error "Server process died"
        fi
    done

    # Wait for model to finish loading (poll /v1/models until it returns data)
    info "Loading model..."
    while true; do
        # Check if server died
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            error "Server crashed during model load (try smaller --context)"
        fi

        # Check if model is loaded (returns model list)
        local models=$(curl -s --max-time 2 "http://localhost:$SERVER_PORT/v1/models" 2>/dev/null)
        if echo "$models" | python3 -c "import sys,json; d=json.load(sys.stdin); assert len(d.get('data',[])) > 0" 2>/dev/null; then
            break
        fi

        sleep 1
    done

    success "Server running on port $SERVER_PORT (PID: $pid)"
}

cmd_stop() {
    if ! server_running; then
        warn "Server not running"
        rm -f "$PID_FILE"
        return 0
    fi

    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    success "Server stopped"
}

cmd_status() {
    local pid=""
    [[ -f "$PID_FILE" ]] && pid=$(cat "$PID_FILE")

    if server_running; then
        echo "Server: ${GREEN}running${NC} (PID: $pid, port: $SERVER_PORT)"

        # Get model from server
        local model=$(curl -s "http://localhost:$SERVER_PORT/v1/models" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get('data', [{}])[0].get('id', 'unknown'))
except:
    print('unknown')
" 2>/dev/null)
        echo "Model:  ${CYAN}${model}${NC}"

        # Get memory usage (RSS in human-readable format)
        local mem_kb=$(ps -p "$pid" -o rss= 2>/dev/null | tr -d ' ')
        if [[ -n "$mem_kb" ]]; then
            local mem_mb=$((mem_kb / 1024))
            if [[ $mem_mb -ge 1024 ]]; then
                local mem_gb_int=$((mem_mb / 1024))
                local mem_gb_frac=$(((mem_mb % 1024) * 10 / 1024))
                echo "Memory: ${CYAN}${mem_gb_int}.${mem_gb_frac}G${NC}"
            else
                echo "Memory: ${CYAN}${mem_mb}M${NC}"
            fi
        fi
    else
        echo "Server: ${RED}stopped${NC}"
        echo "Model:  ${CYAN}${MODEL}${NC}"
        rm -f "$PID_FILE"
    fi

    local selected=""
    [[ -f "$SELECTED_PROMPT_FILE" ]] && selected=$(<"$SELECTED_PROMPT_FILE")
    echo "Prompt: ${CYAN}${selected:-none}${NC}"
    echo "Temp:   ${CYAN}${TEMPERATURE}${NC}"
    echo "Template: ${CYAN}${CHAT_TEMPLATE:-auto}${NC}"
}

# Wait for model to be ready (handles 503 during model load)
wait_for_model() {
    while true; do
        local http_code=$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:$SERVER_PORT/v1/models")
        [[ "$http_code" == "200" ]] && return 0
        [[ "$http_code" == "503" ]] && { echo "${GREY}Model loading...${NC}"; sleep 2; continue; }
        return 1  # Other error
    done
}

# Query the server (raw output)
query_server() {
    local prompt="$1"
    local system_prompt="$2"

    wait_for_model || return 1

    # Build JSON payload with proper escaping
    local payload
    if [[ -n "$system_prompt" ]]; then
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [
        {'role': 'system', 'content': '''$system_prompt'''},
        {'role': 'user', 'content': '''$prompt'''}
    ],
    'stream': True,
    'temperature': $TEMPERATURE
}))
")
    else
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [{'role': 'user', 'content': '''$prompt'''}],
    'stream': True,
    'temperature': $TEMPERATURE
}))
")
    fi

    curl -sN "http://localhost:$SERVER_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$payload" | python3 -u -c "
import sys
import json

for line in sys.stdin:
    line = line.strip()
    if line.startswith('data: '):
        data = line[6:]
        if data == '[DONE]':
            break
        try:
            obj = json.loads(data)
            content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
            if content:
                print(content, end='', flush=True)
        except:
            pass
print()  # Final newline
"
}

# Query server with streaming markdown via rich
query_server_formatted() {
    local prompt="$1"
    local system_prompt="$2"
    local theme_file="$3"

    wait_for_model || return 1

    local payload
    if [[ -n "$system_prompt" ]]; then
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [
        {'role': 'system', 'content': '''$system_prompt'''},
        {'role': 'user', 'content': '''$prompt'''}
    ],
    'stream': True,
    'temperature': $TEMPERATURE
}))
")
    else
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [{'role': 'user', 'content': '''$prompt'''}],
    'stream': True,
    'temperature': $TEMPERATURE
}))
")
    fi

    curl -sN "http://localhost:$SERVER_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$payload" | python3 -u -c "
import sys
import json
from rich.console import Console
from rich.markdown import Markdown
from rich.live import Live
from pygments.style import Style
from pygments.token import Token, Keyword, Name, String, Number, Comment, Operator, Punctuation

# Load theme
with open('$theme_file') as f:
    theme = json.load(f)
code = theme.get('code', {})

# Create custom Pygments style
class CustomStyle(Style):
    background_color = None
    styles = {
        Token: code.get('text', '#eff0eb'),
        Keyword: code.get('keyword', '#ff6ac1'),
        Name: code.get('text', '#eff0eb'),
        Name.Function: code.get('function', '#57c7ff'),
        Name.Class: code.get('function', '#57c7ff'),
        Name.Builtin: code.get('function', '#57c7ff'),
        String: code.get('string', '#5af78e'),
        Number: code.get('number', '#f3f99d'),
        Comment: code.get('comment', '#686868'),
        Operator: code.get('operator', '#9aedfe'),
        Punctuation: code.get('punctuation', '#9aedfe'),
    }

console = Console()
buffer = ''

with Live(console=console, auto_refresh=False, transient=False) as live:
    for line in sys.stdin:
        line = line.strip()
        if line.startswith('data: '):
            data = line[6:]
            if data == '[DONE]':
                break
            try:
                obj = json.loads(data)
                content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                if content:
                    buffer += content
                    live.update(Markdown(buffer, code_theme=CustomStyle), refresh=True)
            except:
                pass
"
}

# Conversation loop for server mode
conversation_loop() {
    local initial_prompt="$1"
    local system_prompt="$2"
    local theme_file="$3"
    local format="$4"

    python3 -u -c "
import sys
import json
import urllib.request
import urllib.error
import readline  # Enable line editing (Ctrl-A, Ctrl-K, etc.)

SERVER_URL = 'http://localhost:$SERVER_PORT/v1/chat/completions'
system_prompt = '''$system_prompt'''
theme_file = '''$theme_file'''
use_format = '$format' == 'true'
temperature = $TEMPERATURE

# Build initial messages
messages = []
if system_prompt:
    messages.append({'role': 'system', 'content': system_prompt})
initial = '''$initial_prompt'''
if initial:
    messages.append({'role': 'user', 'content': initial})

# Setup for formatted output
if use_format:
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.live import Live
    from pygments.style import Style
    from pygments.token import Token, Keyword, Name, String, Number, Comment, Operator, Punctuation

    with open(theme_file) as f:
        theme = json.load(f)
    code = theme.get('code', {})

    class CustomStyle(Style):
        background_color = None
        styles = {
            Token: code.get('text', '#eff0eb'),
            Keyword: code.get('keyword', '#ff6ac1'),
            Name: code.get('text', '#eff0eb'),
            Name.Function: code.get('function', '#57c7ff'),
            Name.Class: code.get('function', '#57c7ff'),
            Name.Builtin: code.get('function', '#57c7ff'),
            String: code.get('string', '#5af78e'),
            Number: code.get('number', '#f3f99d'),
            Comment: code.get('comment', '#686868'),
            Operator: code.get('operator', '#9aedfe'),
            Punctuation: code.get('punctuation', '#9aedfe'),
        }
    console = Console()

# ANSI colors
YELLOW = '\033[33m'
GREY = '\033[90m'
NC = '\033[0m'

def query(msgs):
    import time
    payload = json.dumps({'messages': msgs, 'stream': True, 'temperature': temperature}).encode()
    req = urllib.request.Request(SERVER_URL, data=payload, headers={'Content-Type': 'application/json'})
    buffer = ''

    # Retry loop for 503 (model loading)
    while True:
        try:
            resp = urllib.request.urlopen(req)
            break
        except urllib.error.HTTPError as e:
            if e.code == 503:
                print(f'{GREY}Model loading...{NC}', flush=True)
                time.sleep(2)
                continue
            raise

    with resp:
        if use_format:
            with Live(console=console, auto_refresh=False, transient=False) as live:
                for line in resp:
                    line = line.decode().strip()
                    if line.startswith('data: '):
                        data = line[6:]
                        if data == '[DONE]':
                            break
                        try:
                            obj = json.loads(data)
                            content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                            if content:
                                buffer += content
                                live.update(Markdown(buffer, code_theme=CustomStyle), refresh=True)
                        except:
                            pass
        else:
            for line in resp:
                line = line.decode().strip()
                if line.startswith('data: '):
                    data = line[6:]
                    if data == '[DONE]':
                        break
                    try:
                        obj = json.loads(data)
                        content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                        if content:
                            buffer += content
                            print(content, end='', flush=True)
                    except:
                        pass
            print()
    return buffer

# Main conversation loop
first = True
while True:
    # Skip first query if no initial prompt
    if first and not initial:
        first = False
    else:
        response = query(messages)
        if response:
            messages.append({'role': 'assistant', 'content': response})
        first = False

    # Get next input
    try:
        print()
        print(f'{GREY}───────────────────────────────────────{NC}')
        user_input = input(f'{YELLOW}❯ {NC}')
        if not user_input.strip():
            break
        messages.append({'role': 'user', 'content': user_input})
        print()
    except (EOFError, KeyboardInterrupt):
        print()
        break
"
}

# Interactive prompt selection menu
cmd_prompts() {
    local selected=""
    [[ -f "$SELECTED_PROMPT_FILE" ]] && selected=$(<"$SELECTED_PROMPT_FILE")

    echo ""
    info "System Prompts"
    echo "─────────────────────────────────────────"

    local -a menu_opts
    local -a prompt_names

    while true; do
        # Build menu options
        menu_opts=()
        prompt_names=()

        while read -r name; do
            [[ -z "$name" ]] && continue
            prompt_names+=("$name")
            local prompt=$(prompt_get "$name")
            # Truncate prompt for display (first line, max 40 chars)
            local short_prompt="${prompt%%$'\n'*}"
            short_prompt="${short_prompt:0:40}"
            [[ ${#prompt} -gt 40 ]] && short_prompt+="…"
            if [[ "$name" == "$selected" ]]; then
                menu_opts+=("${GREEN}●${NC} $name ${GREY}- $short_prompt${NC}")
            else
                menu_opts+=("  $name ${GREY}- $short_prompt${NC}")
            fi
        done < <(prompt_list)

        menu_opts+=("${GREEN}+${NC} Add new prompt")
        menu_opts+=("${YELLOW}✎${NC} Edit prompt")
        menu_opts+=("${RED}−${NC} Remove prompt")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        local num_prompts=${#prompt_names[@]}

        if [[ $choice -lt $num_prompts ]]; then
            # Select this prompt and exit (zsh arrays are 1-indexed)
            selected="${prompt_names[$((choice + 1))]}"
            echo "$selected" > "$SELECTED_PROMPT_FILE"
            break
        elif [[ $choice -eq $num_prompts ]]; then
            # Add new prompt
            echo ""
            local new_name=""
            vared -p "  Name: " new_name
            [[ -z "$new_name" ]] && continue
            if prompt_exists "$new_name"; then
                echo "  ${RED}Name already exists${NC}"
                continue
            fi

            # Open editor for prompt text
            local tmpfile=$(mktemp)
            ${EDITOR:-vim} "$tmpfile"
            local new_prompt=$(<"$tmpfile")
            rm -f "$tmpfile"

            [[ -z "$new_prompt" ]] && continue
            prompt_set "$new_name" "$new_prompt"
            # Auto-select new prompt and exit
            selected="$new_name"
            echo "$selected" > "$SELECTED_PROMPT_FILE"
            break
        elif [[ $choice -eq $((num_prompts + 1)) ]]; then
            # Edit prompt submenu
            echo ""
            echo "  Select prompt to edit:"
            local -a edit_opts=()
            for name in "${prompt_names[@]}"; do
                edit_opts+=("${YELLOW}✎${NC} $name")
            done
            edit_opts+=("${CYAN}←${NC} Back")

            menu "${edit_opts[@]}"
            local edit_choice=$?

            if [[ $edit_choice -lt $num_prompts ]]; then
                local edit_name="${prompt_names[$((edit_choice + 1))]}"
                local old_prompt=$(prompt_get "$edit_name")

                # Write to temp file and open in editor
                local tmpfile=$(mktemp)
                printf '%s' "$old_prompt" > "$tmpfile"
                ${EDITOR:-vim} "$tmpfile"

                # Read back and update
                local new_prompt=$(<"$tmpfile")
                rm -f "$tmpfile"

                if [[ -n "$new_prompt" && "$new_prompt" != "$old_prompt" ]]; then
                    prompt_set "$edit_name" "$new_prompt"
                    echo "  ${GREEN}Updated '$edit_name'${NC}"
                fi
            fi
        elif [[ $choice -eq $((num_prompts + 2)) ]]; then
            # Remove prompt submenu
            echo ""
            echo "  Select prompt to remove:"
            local -a rm_opts=()
            for name in "${prompt_names[@]}"; do
                rm_opts+=("${RED}✕${NC} $name")
            done
            rm_opts+=("${CYAN}←${NC} Back")

            menu "${rm_opts[@]}"
            local rm_choice=$?

            if [[ $rm_choice -lt $num_prompts ]]; then
                local rm_name="${prompt_names[$((rm_choice + 1))]}"
                prompt_remove "$rm_name"
                echo "  ${GREEN}Removed '$rm_name'${NC}"
                # If we removed the selected prompt, clear selection
                if [[ "$rm_name" == "$selected" ]]; then
                    selected=""
                    rm -f "$SELECTED_PROMPT_FILE"
                fi
            fi
        else
            # Done
            break
        fi
    done

    echo ""
    if [[ -n "$selected" ]]; then
        success "Using prompt: $selected"
    else
        echo "No prompt selected"
    fi
}

# Apply model change - restart server if running
apply_model_change() {
    echo "$MODEL" > "$SELECTED_MODEL_FILE"

    if server_running; then
        info "Restarting server with new model..."
        cmd_stop
        cmd_serve
    fi
}

# Interactive model selection menu
cmd_models() {
    local prev_model="$MODEL"
    local changed=false

    echo ""
    info "Models"
    echo "─────────────────────────────────────────"

    while true; do
        local -a menu_opts=()
        local -a model_ids=()

        # Parse manifest files to get model IDs
        for manifest in "$CACHE_DIR"/manifest=*.json; do
            [[ ! -f "$manifest" ]] && continue
            # Extract model ID from manifest filename: manifest=owner=repo=quant.json -> owner/repo:quant
            local basename="${manifest:t:r}"  # remove path and .json
            basename="${basename#manifest=}"   # remove manifest= prefix
            local owner="${basename%%=*}"
            basename="${basename#*=}"
            local repo="${basename%%=*}"
            local quant="${basename#*=}"
            local model_id="$owner/$repo:$quant"
            model_ids+=("$model_id")
            if [[ "$model_id" == "$MODEL" ]]; then
                menu_opts+=("${GREEN}●${NC} $model_id")
            else
                menu_opts+=("  $model_id")
            fi
        done

        menu_opts+=("${GREEN}+${NC} Add new model")
        menu_opts+=("${RED}−${NC} Remove model")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        local num_models=${#model_ids[@]}

        if [[ $choice -lt $num_models ]]; then
            # Select this model
            MODEL="${model_ids[$((choice + 1))]}"
            if [[ "$MODEL" != "$prev_model" ]]; then
                apply_model_change
                changed=true
            fi
            break
        elif [[ $choice -eq $num_models ]]; then
            # Add new model - download it now
            echo ""
            local new_model=""
            vared -p "  Model (owner/repo:quant): " new_model
            [[ -z "$new_model" ]] && continue

            # Parse model ID for manifest check
            local owner="${new_model%%/*}"
            local rest="${new_model#*/}"
            local repo="${rest%%:*}"
            local quant="${rest#*:}"
            local manifest_path="$CACHE_DIR/manifest=${owner}=${repo}=${quant}.json"

            # Download and test the model
            local needs_download=true
            [[ -f "$manifest_path" ]] && needs_download=false

            info "Downloading model..."
            if $needs_download; then
                # Show stderr for download progress
                llama-cli --hf-repo "$new_model" --prompt "test" --n-predict 1 >/dev/null
            else
                # Already cached, suppress all output
                llama-cli --hf-repo "$new_model" --prompt "test" --n-predict 1 >/dev/null 2>&1
            fi
            local exit_code=$?

            # Check if manifest exists (download succeeded)
            if [[ ! -f "$manifest_path" ]]; then
                echo "  ${RED}Failed to download model${NC}"
                continue
            fi

            # Warn if inference failed but download succeeded
            if [[ $exit_code -ne 0 ]]; then
                warn "Model downloaded but inference test failed (may need more memory)"
            fi

            MODEL="$new_model"
            apply_model_change
            changed=true
            break
        elif [[ $choice -eq $((num_models + 1)) ]]; then
            # Remove model submenu
            echo ""
            echo "  Select model to remove:"
            local -a rm_opts=()
            for id in "${model_ids[@]}"; do
                rm_opts+=("${RED}✕${NC} $id")
            done
            rm_opts+=("${CYAN}←${NC} Back")

            menu "${rm_opts[@]}"
            local rm_choice=$?

            if [[ $rm_choice -lt $num_models ]]; then
                local rm_id="${model_ids[$((rm_choice + 1))]}"

                # Parse model ID to get manifest path
                local owner="${rm_id%%/*}"
                local rest="${rm_id#*/}"
                local repo="${rest%%:*}"
                local quant="${rest#*:}"
                local manifest_path="$CACHE_DIR/manifest=${owner}=${repo}=${quant}.json"

                # Get GGUF filename from manifest
                local gguf_name=$(python3 -c "
import json
with open('$manifest_path') as f:
    data = json.load(f)
    print(data.get('ggufFile', {}).get('rfilename', ''))
" 2>/dev/null)

                # Delete files
                rm -f "$manifest_path"
                if [[ -n "$gguf_name" ]]; then
                    rm -f "$CACHE_DIR/${owner}_${repo}_${gguf_name}"
                    rm -f "$CACHE_DIR/${owner}_${repo}_${gguf_name}.etag"
                fi

                echo "  ${GREEN}Removed '$rm_id'${NC}"

                # If we removed the selected model, reset to default
                if [[ "$rm_id" == "$MODEL" ]]; then
                    MODEL="$DEFAULT_MODEL"
                    rm -f "$SELECTED_MODEL_FILE"
                fi
            fi
        else
            # Done
            break
        fi
    done

    echo ""
    if $changed; then
        success "Using model: $MODEL"
    fi
}

# Temperature setting
cmd_temperature() {
    echo ""
    local new_temp=""
    vared -p "  Temperature (0.0-2.0, current: $TEMPERATURE): " new_temp

    # Validate input
    if [[ -z "$new_temp" ]]; then
        return
    fi

    # Check if valid number in range
    if ! python3 -c "t = float('$new_temp'); assert 0 <= t <= 2" 2>/dev/null; then
        echo "  ${RED}Invalid temperature (must be 0.0-2.0)${NC}"
        return
    fi

    TEMPERATURE="$new_temp"
    echo "$TEMPERATURE" > "$SELECTED_TEMP_FILE"
    success "Temperature set to $TEMPERATURE"
}

# Chat template setting
cmd_template() {
    echo ""
    info "Chat Templates"
    echo "─────────────────────────────────────────"

    local -a menu_opts=()
    local -a template_values=()

    # Auto option (use model default)
    if [[ -z "$CHAT_TEMPLATE" ]]; then
        menu_opts+=("${GREEN}●${NC} auto ${GREY}(use model default)${NC}")
    else
        menu_opts+=("  auto ${GREY}(use model default)${NC}")
    fi
    template_values+=("")

    # Custom templates from templates dir
    if [[ -d "$TEMPLATES_DIR" ]]; then
        for tpl in "$TEMPLATES_DIR"/*.jinja; do
            [[ ! -f "$tpl" ]] && continue
            local name="${tpl:t:r}"  # basename without extension
            if [[ "$CHAT_TEMPLATE" == "$tpl" ]]; then
                menu_opts+=("${GREEN}●${NC} $name")
            else
                menu_opts+=("  $name")
            fi
            template_values+=("$tpl")
        done
    fi

    # Common built-in templates
    local -a builtins=(mistral-v1 mistral-v3 mistral-v7 llama2 llama3 chatml)
    for name in "${builtins[@]}"; do
        if [[ "$CHAT_TEMPLATE" == "$name" ]]; then
            menu_opts+=("${GREEN}●${NC} $name ${GREY}(built-in)${NC}")
        else
            menu_opts+=("  $name ${GREY}(built-in)${NC}")
        fi
        template_values+=("$name")
    done

    menu_opts+=("${CYAN}✓${NC} Done")

    menu "${menu_opts[@]}"
    local choice=$?

    if [[ $choice -lt ${#template_values[@]} ]]; then
        CHAT_TEMPLATE="${template_values[$((choice + 1))]}"
        if [[ -z "$CHAT_TEMPLATE" ]]; then
            rm -f "$SELECTED_TEMPLATE_FILE"
            success "Using model default template"
        else
            echo "$CHAT_TEMPLATE" > "$SELECTED_TEMPLATE_FILE"
            success "Template set to ${CHAT_TEMPLATE:t}"
        fi
    fi
}

# Config menu
cmd_config() {
    echo ""
    info "Configuration"
    echo "─────────────────────────────────────────"

    local -a menu_opts=(
        "  Prompts"
        "  Models"
        "  Temperature ${GREY}($TEMPERATURE)${NC}"
        "  Template ${GREY}(${CHAT_TEMPLATE:-auto})${NC}"
        "${CYAN}✓${NC} Done"
    )

    menu "${menu_opts[@]}"
    local choice=$?

    case $choice in
        0) cmd_prompts ;;
        1) cmd_models ;;
        2) cmd_temperature ;;
        3) cmd_template ;;
    esac
}

usage() {
    cat <<EOF
Usage: llm [options] [file]
       echo "prompt" | llm [options]
       llm <command>

Commands:
    config               Configure prompts, models, and temperature
    serve [--context N]  Start server (keeps model in memory)
    stop                 Stop server
    status               Show server and prompt status

Options:
    -p, --prompt TEXT    Prompt to prepend to file/stdin content
    -m, --model MODEL    HuggingFace model (default: $MODEL)
    -t, --temp N         Temperature (default: $TEMPERATURE)
    -T, --template NAME  Chat template (built-in name or .jinja file path)
    -s, --system NAME    Use named system prompt for this query
    -r, --raw            Disable markdown formatting
    -v, --verbose        Show llama-cli output (downloads, loading, etc.)
    -h, --help           Show this help

Examples:
    llm serve                            # Start server (32K context)
    llm serve --context 65536            # Start with 64K context
    llm file.txt                         # Send file contents to LLM
    llm -p "summarize this" file.txt     # Ask about a file
    echo "Hello" | llm                   # Pipe input to LLM
    llm                                  # Interactive conversation mode
    llm stop                             # Stop server when done
EOF
    exit 0
}

run_llm() {
    SYSTEM_PROMPT=$(get_system_prompt)

    local user_prompt=""
    local input_file=""

    # Parse arguments (options can appear anywhere)
    while [[ $# -gt 0 ]]; do
        case $1 in
            -m|--model)
                MODEL="$2"
                shift 2
                ;;
            -t|--temp)
                TEMPERATURE="$2"
                shift 2
                ;;
            -T|--template)
                CHAT_TEMPLATE="$2"
                shift 2
                ;;
            -p|--prompt)
                user_prompt="$2"
                shift 2
                ;;
            -s|--system)
                # Use a named prompt
                SYSTEM_PROMPT=$(prompt_get "$2")
                if [[ -z "$SYSTEM_PROMPT" ]]; then
                    error "Prompt '$2' not found"
                fi
                shift 2
                ;;
            -r|--raw)
                FORMAT=false
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                input_file="$1"
                shift
                ;;
        esac
    done

    # Get prompt from file, stdin, or conversation mode
    if [[ -n "$input_file" ]]; then
        local file="$input_file"
        if [[ ! -f "$file" ]]; then
            error "File not found: $file"
        fi
        local file_content=$(<"$file")
        if [[ -n "$user_prompt" ]]; then
            PROMPT="$user_prompt"$'\n\n'"$file_content"
        else
            PROMPT="$file_content"
        fi
    elif [[ ! -t 0 ]]; then
        local stdin_content=$(cat)
        if [[ -n "$user_prompt" ]]; then
            PROMPT="$user_prompt"$'\n\n'"$stdin_content"
        else
            PROMPT="$stdin_content"
        fi
    else
        # No input - enter conversation mode
        CONVERSATION=true
        PROMPT=""
    fi

    # Check if prompt is too large (rough estimate: ~4 chars per token)
    if [[ -n "$PROMPT" ]]; then
        local char_count=${#PROMPT}
        local est_tokens=$((char_count / 4))
        if [[ $est_tokens -gt $CONTEXT_SIZE ]]; then
            error "Input too large (~$est_tokens tokens, max $CONTEXT_SIZE)"
        fi
    fi

    # Use server if running, otherwise fall back to llama-cli
    if server_running; then
        if $CONVERSATION; then
            # Conversation mode
            conversation_loop "$PROMPT" "$SYSTEM_PROMPT" "$THEME_FILE" "$FORMAT"
        else
            # Single response mode
            if $FORMAT; then
                query_server_formatted "$PROMPT" "$SYSTEM_PROMPT" "$THEME_FILE"
            else
                query_server "$PROMPT" "$SYSTEM_PROMPT"
            fi
        fi
        # Check if server died during query
        if ! server_running; then
            echo ""
            error "Server crashed (may have run out of memory - try smaller --context)"
        fi
    else
        # Build llama-cli arguments
        ARGS=(
            --hf-repo "$MODEL"
            --ctx-size "$CONTEXT_SIZE"
            --temp "$TEMPERATURE"
            --prompt "$PROMPT"
            --no-display-prompt
        )

        [[ -n "$SYSTEM_PROMPT" ]] && ARGS+=(--system-prompt "$SYSTEM_PROMPT")
        if [[ -n "$CHAT_TEMPLATE" ]]; then
            if [[ -f "$CHAT_TEMPLATE" ]]; then
                ARGS+=(--jinja --chat-template-file "$CHAT_TEMPLATE")
            else
                ARGS+=(--chat-template "$CHAT_TEMPLATE")
            fi
        fi
        $CONVERSATION || ARGS+=(--single-turn --no-perf)

        # Run llama-cli (formatting only available with server mode)
        if $VERBOSE; then
            exec llama-cli "${ARGS[@]}"
        else
            exec llama-cli "${ARGS[@]}" 2>/dev/null
        fi
    fi
}

# Main
case "${1:-}" in
    config)
        cmd_config
        ;;
    serve)
        shift
        cmd_serve "$@"
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        run_llm "$@"
        ;;
esac
