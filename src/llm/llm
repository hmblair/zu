#!/usr/bin/env zsh
# Simple wrapper around llama-cli

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/llm"
PROMPTS_FILE="$CONFIG_DIR/prompts"
SELECTED_PROMPT_FILE="$CONFIG_DIR/selected_prompt"
SELECTED_MODEL_FILE="$CONFIG_DIR/selected_model"
THEME_FILE="$SCRIPT_DIR/theme.json"
PID_FILE="$CONFIG_DIR/server.pid"
CACHE_DIR="$HOME/Library/Caches/llama.cpp"
SERVER_PORT=8787
DEFAULT_MODEL="bartowski/Llama-3.2-3B-Instruct-GGUF:Q4_K_M"
CONTEXT_SIZE=4096
VERBOSE=false
CONVERSATION=false
FORMAT=true

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Load selected model (validate it exists in cache)
model_in_cache() {
    local model="$1"
    # Convert model ID to manifest filename: owner/repo:quant -> manifest=owner=repo=quant.json
    local manifest="${model//\//=}"  # / -> =
    manifest="${manifest//:/=}"       # : -> =
    [[ -f "$CACHE_DIR/manifest=${manifest}.json" ]]
}

if [[ -f "$SELECTED_MODEL_FILE" ]]; then
    MODEL=$(<"$SELECTED_MODEL_FILE")
    if ! model_in_cache "$MODEL"; then
        MODEL="$DEFAULT_MODEL"
        rm -f "$SELECTED_MODEL_FILE"
    fi
else
    MODEL="$DEFAULT_MODEL"
fi

# Initialize default prompts if none exist
if [[ ! -f "$PROMPTS_FILE" ]]; then
    cat > "$PROMPTS_FILE" <<'EOF'
concise	Be concise and direct. Give short answers without unnecessary explanation.
detailed	Provide thorough, detailed explanations with examples.
code	You are a coding assistant. Provide clean, working code with brief explanations.
EOF
    echo "concise" > "$SELECTED_PROMPT_FILE"
fi

# Get current system prompt
get_system_prompt() {
    local selected
    if [[ -f "$SELECTED_PROMPT_FILE" ]]; then
        selected=$(<"$SELECTED_PROMPT_FILE")
        grep "^$selected	" "$PROMPTS_FILE" | cut -f2-
    fi
}

# Server management
server_running() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid=$(cat "$PID_FILE")
    ps -p "$pid" -o comm= 2>/dev/null | grep -q llama-server
}

cmd_serve() {
    if server_running; then
        warn "Server already running (PID: $(cat "$PID_FILE"))"
        return 0
    fi

    info "Starting llama server..."
    llama-server \
        --hf-repo "$MODEL" \
        --ctx-size "$CONTEXT_SIZE" \
        --port "$SERVER_PORT" \
        >/dev/null 2>&1 &

    local pid=$!
    echo "$pid" > "$PID_FILE"

    # Wait for server to be ready
    local attempts=0
    while ! curl -s "http://localhost:$SERVER_PORT/health" >/dev/null 2>&1; do
        sleep 0.5
        ((attempts++))
        if [[ $attempts -gt 120 ]]; then
            error "Server failed to start (timeout)"
        fi
        # Check if process died
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            error "Server process died"
        fi
    done

    success "Server running on port $SERVER_PORT (PID: $pid)"
}

cmd_stop() {
    if ! server_running; then
        warn "Server not running"
        rm -f "$PID_FILE"
        return 0
    fi

    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    success "Server stopped"
}

cmd_status() {
    if server_running; then
        local pid=$(cat "$PID_FILE")
        echo "Server: ${GREEN}running${NC} (PID: $pid, port: $SERVER_PORT)"

        # Get model from server
        local model=$(curl -s "http://localhost:$SERVER_PORT/v1/models" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get('data', [{}])[0].get('id', 'unknown'))
except:
    print('unknown')
" 2>/dev/null)
        echo "Model:  ${CYAN}${model}${NC}"

        # Get memory usage (RSS in human-readable format)
        local mem_kb=$(ps -p "$pid" -o rss= 2>/dev/null | tr -d ' ')
        if [[ -n "$mem_kb" ]]; then
            local mem_mb=$((mem_kb / 1024))
            if [[ $mem_mb -ge 1024 ]]; then
                local mem_gb_int=$((mem_mb / 1024))
                local mem_gb_frac=$(((mem_mb % 1024) * 10 / 1024))
                echo "Memory: ${CYAN}${mem_gb_int}.${mem_gb_frac}G${NC}"
            else
                echo "Memory: ${CYAN}${mem_mb}M${NC}"
            fi
        fi
    else
        echo "Server: ${RED}stopped${NC}"
        echo "Model:  ${CYAN}${MODEL}${NC}"
        rm -f "$PID_FILE"
    fi

    local selected=""
    [[ -f "$SELECTED_PROMPT_FILE" ]] && selected=$(<"$SELECTED_PROMPT_FILE")
    echo "Prompt: ${CYAN}${selected:-none}${NC}"
}

# Query the server (raw output)
query_server() {
    local prompt="$1"
    local system_prompt="$2"

    # Build JSON payload with proper escaping
    local payload
    if [[ -n "$system_prompt" ]]; then
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [
        {'role': 'system', 'content': '''$system_prompt'''},
        {'role': 'user', 'content': '''$prompt'''}
    ],
    'stream': True
}))
")
    else
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [{'role': 'user', 'content': '''$prompt'''}],
    'stream': True
}))
")
    fi

    curl -sN "http://localhost:$SERVER_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$payload" | python3 -u -c "
import sys
import json

for line in sys.stdin:
    line = line.strip()
    if line.startswith('data: '):
        data = line[6:]
        if data == '[DONE]':
            break
        try:
            obj = json.loads(data)
            content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
            if content:
                print(content, end='', flush=True)
        except:
            pass
print()  # Final newline
"
}

# Query server with streaming markdown via rich
query_server_formatted() {
    local prompt="$1"
    local system_prompt="$2"
    local theme_file="$3"

    local payload
    if [[ -n "$system_prompt" ]]; then
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [
        {'role': 'system', 'content': '''$system_prompt'''},
        {'role': 'user', 'content': '''$prompt'''}
    ],
    'stream': True
}))
")
    else
        payload=$(python3 -c "
import json
print(json.dumps({
    'messages': [{'role': 'user', 'content': '''$prompt'''}],
    'stream': True
}))
")
    fi

    curl -sN "http://localhost:$SERVER_PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "$payload" | python3 -u -c "
import sys
import json
from rich.console import Console
from rich.markdown import Markdown
from rich.live import Live
from pygments.style import Style
from pygments.token import Token, Keyword, Name, String, Number, Comment, Operator, Punctuation

# Load theme
with open('$theme_file') as f:
    theme = json.load(f)
code = theme.get('code', {})

# Create custom Pygments style
class CustomStyle(Style):
    background_color = None
    styles = {
        Token: code.get('text', '#eff0eb'),
        Keyword: code.get('keyword', '#ff6ac1'),
        Name: code.get('text', '#eff0eb'),
        Name.Function: code.get('function', '#57c7ff'),
        Name.Class: code.get('function', '#57c7ff'),
        Name.Builtin: code.get('function', '#57c7ff'),
        String: code.get('string', '#5af78e'),
        Number: code.get('number', '#f3f99d'),
        Comment: code.get('comment', '#686868'),
        Operator: code.get('operator', '#9aedfe'),
        Punctuation: code.get('punctuation', '#9aedfe'),
    }

console = Console()
buffer = ''

with Live(console=console, refresh_per_second=90, vertical_overflow='visible', transient=True) as live:
    for line in sys.stdin:
        line = line.strip()
        if line.startswith('data: '):
            data = line[6:]
            if data == '[DONE]':
                break
            try:
                obj = json.loads(data)
                content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                if content:
                    buffer += content
                    live.update(Markdown(buffer, code_theme=CustomStyle))
            except:
                pass

# Final render outside Live context (so it stays on screen)
if buffer:
    console.print(Markdown(buffer, code_theme=CustomStyle))
"
}

# Conversation loop for server mode
conversation_loop() {
    local initial_prompt="$1"
    local system_prompt="$2"
    local theme_file="$3"
    local format="$4"

    python3 -u -c "
import sys
import json
import urllib.request

SERVER_URL = 'http://localhost:$SERVER_PORT/v1/chat/completions'
system_prompt = '''$system_prompt'''
theme_file = '''$theme_file'''
use_format = '$format' == 'true'

# Build initial messages
messages = []
if system_prompt:
    messages.append({'role': 'system', 'content': system_prompt})
messages.append({'role': 'user', 'content': '''$initial_prompt'''})

# Setup for formatted output
if use_format:
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.live import Live
    from pygments.style import Style
    from pygments.token import Token, Keyword, Name, String, Number, Comment, Operator, Punctuation

    with open(theme_file) as f:
        theme = json.load(f)
    code = theme.get('code', {})

    class CustomStyle(Style):
        background_color = None
        styles = {
            Token: code.get('text', '#eff0eb'),
            Keyword: code.get('keyword', '#ff6ac1'),
            Name: code.get('text', '#eff0eb'),
            Name.Function: code.get('function', '#57c7ff'),
            Name.Class: code.get('function', '#57c7ff'),
            Name.Builtin: code.get('function', '#57c7ff'),
            String: code.get('string', '#5af78e'),
            Number: code.get('number', '#f3f99d'),
            Comment: code.get('comment', '#686868'),
            Operator: code.get('operator', '#9aedfe'),
            Punctuation: code.get('punctuation', '#9aedfe'),
        }
    console = Console()

def query(msgs):
    payload = json.dumps({'messages': msgs, 'stream': True}).encode()
    req = urllib.request.Request(SERVER_URL, data=payload, headers={'Content-Type': 'application/json'})
    buffer = ''
    with urllib.request.urlopen(req) as resp:
        if use_format:
            with Live(console=console, refresh_per_second=90, vertical_overflow='visible', transient=True) as live:
                for line in resp:
                    line = line.decode().strip()
                    if line.startswith('data: '):
                        data = line[6:]
                        if data == '[DONE]':
                            break
                        try:
                            obj = json.loads(data)
                            content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                            if content:
                                buffer += content
                                live.update(Markdown(buffer, code_theme=CustomStyle))
                        except:
                            pass
            if buffer:
                console.print(Markdown(buffer, code_theme=CustomStyle))
        else:
            for line in resp:
                line = line.decode().strip()
                if line.startswith('data: '):
                    data = line[6:]
                    if data == '[DONE]':
                        break
                    try:
                        obj = json.loads(data)
                        content = obj.get('choices', [{}])[0].get('delta', {}).get('content', '')
                        if content:
                            buffer += content
                            print(content, end='', flush=True)
                    except:
                        pass
            print()
    return buffer

# Main conversation loop
while True:
    response = query(messages)
    if response:
        messages.append({'role': 'assistant', 'content': response})

    # Get next input
    try:
        print()
        user_input = input('> ')
        if not user_input.strip():
            break
        messages.append({'role': 'user', 'content': user_input})
    except (EOFError, KeyboardInterrupt):
        print()
        break
"
}

# Interactive prompt selection menu
cmd_prompts() {
    local selected=""
    [[ -f "$SELECTED_PROMPT_FILE" ]] && selected=$(<"$SELECTED_PROMPT_FILE")

    echo ""
    info "System Prompts"
    echo "─────────────────────────────────────────"

    local -a menu_opts
    local -a prompt_names

    while true; do
        # Build menu options
        menu_opts=()
        prompt_names=()

        while IFS=$'\t' read -r name prompt || [[ -n "$name" ]]; do
            [[ -z "$name" ]] && continue
            prompt_names+=("$name")
            # Truncate prompt for display
            local short_prompt="${prompt:0:40}"
            [[ ${#prompt} -gt 40 ]] && short_prompt+="…"
            if [[ "$name" == "$selected" ]]; then
                menu_opts+=("${GREEN}●${NC} $name ${GREY}- $short_prompt${NC}")
            else
                menu_opts+=("  $name ${GREY}- $short_prompt${NC}")
            fi
        done < "$PROMPTS_FILE"

        menu_opts+=("${GREEN}+${NC} Add new prompt")
        menu_opts+=("${RED}−${NC} Remove prompt")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        local num_prompts=${#prompt_names[@]}

        if [[ $choice -lt $num_prompts ]]; then
            # Select this prompt and exit (zsh arrays are 1-indexed)
            selected="${prompt_names[$((choice + 1))]}"
            echo "$selected" > "$SELECTED_PROMPT_FILE"
            break
        elif [[ $choice -eq $num_prompts ]]; then
            # Add new prompt
            echo ""
            local new_name=""
            local new_prompt=""
            vared -p "  Name: " new_name
            [[ -z "$new_name" ]] && continue
            if grep -q "^$new_name	" "$PROMPTS_FILE" 2>/dev/null; then
                echo "  ${RED}Name already exists${NC}"
                continue
            fi
            vared -p "  Prompt: " new_prompt
            [[ -z "$new_prompt" ]] && continue
            printf '%s\t%s\n' "$new_name" "$new_prompt" >> "$PROMPTS_FILE"
            # Auto-select new prompt and exit
            selected="$new_name"
            echo "$selected" > "$SELECTED_PROMPT_FILE"
            break
        elif [[ $choice -eq $((num_prompts + 1)) ]]; then
            # Remove prompt submenu
            echo ""
            echo "  Select prompt to remove:"
            local -a rm_opts=()
            for name in "${prompt_names[@]}"; do
                rm_opts+=("${RED}✕${NC} $name")
            done
            rm_opts+=("${CYAN}←${NC} Back")

            menu "${rm_opts[@]}"
            local rm_choice=$?

            if [[ $rm_choice -lt $num_prompts ]]; then
                local rm_name="${prompt_names[$((rm_choice + 1))]}"
                grep -v "^$rm_name	" "$PROMPTS_FILE" > "$PROMPTS_FILE.tmp"
                mv "$PROMPTS_FILE.tmp" "$PROMPTS_FILE"
                echo "  ${GREEN}Removed '$rm_name'${NC}"
                # If we removed the selected prompt, clear selection
                if [[ "$rm_name" == "$selected" ]]; then
                    selected=""
                    rm -f "$SELECTED_PROMPT_FILE"
                fi
            fi
        else
            # Done
            break
        fi
    done

    echo ""
    if [[ -n "$selected" ]]; then
        success "Using prompt: $selected"
    else
        echo "No prompt selected"
    fi
}

# Apply model change - restart server if running
apply_model_change() {
    echo "$MODEL" > "$SELECTED_MODEL_FILE"

    if server_running; then
        info "Restarting server with new model..."
        cmd_stop
        cmd_serve
    fi
}

# Interactive model selection menu
cmd_models() {
    local prev_model="$MODEL"
    local changed=false

    echo ""
    info "Models"
    echo "─────────────────────────────────────────"

    while true; do
        local -a menu_opts=()
        local -a model_ids=()

        # Parse manifest files to get model IDs
        for manifest in "$CACHE_DIR"/manifest=*.json; do
            [[ ! -f "$manifest" ]] && continue
            # Extract model ID from manifest filename: manifest=owner=repo=quant.json -> owner/repo:quant
            local basename="${manifest:t:r}"  # remove path and .json
            basename="${basename#manifest=}"   # remove manifest= prefix
            local owner="${basename%%=*}"
            basename="${basename#*=}"
            local repo="${basename%%=*}"
            local quant="${basename#*=}"
            local model_id="$owner/$repo:$quant"
            model_ids+=("$model_id")
            if [[ "$model_id" == "$MODEL" ]]; then
                menu_opts+=("${GREEN}●${NC} $model_id")
            else
                menu_opts+=("  $model_id")
            fi
        done

        menu_opts+=("${GREEN}+${NC} Add new model")
        menu_opts+=("${CYAN}✓${NC} Done")

        menu "${menu_opts[@]}"
        local choice=$?

        local num_models=${#model_ids[@]}

        if [[ $choice -lt $num_models ]]; then
            # Select this model
            MODEL="${model_ids[$((choice + 1))]}"
            if [[ "$MODEL" != "$prev_model" ]]; then
                apply_model_change
                changed=true
            fi
            break
        elif [[ $choice -eq $num_models ]]; then
            # Add new model - download it now
            echo ""
            local new_model=""
            vared -p "  Model (owner/repo:quant): " new_model
            [[ -z "$new_model" ]] && continue

            # Try to download/validate the model
            info "Downloading model..."
            if ! llama-cli --hf-repo "$new_model" --prompt "test" --n-predict 1 >/dev/null 2>&1; then
                echo "  ${RED}Failed to download model${NC}"
                continue
            fi

            MODEL="$new_model"
            apply_model_change
            changed=true
            break
        else
            # Done
            break
        fi
    done

    echo ""
    if $changed; then
        success "Using model: $MODEL"
    fi
}

# Config menu
cmd_config() {
    echo ""
    info "Configuration"
    echo "─────────────────────────────────────────"

    local -a menu_opts=(
        "  Prompts"
        "  Models"
        "${CYAN}✓${NC} Done"
    )

    menu "${menu_opts[@]}"
    local choice=$?

    case $choice in
        0) cmd_prompts ;;
        1) cmd_models ;;
    esac
}

usage() {
    cat <<EOF
Usage: llm [options] [prompt]
       echo "prompt" | llm [options]
       llm <command>

Commands:
    config               Configure prompts and models
    serve                Start server (keeps model in memory)
    stop                 Stop server
    status               Show server and prompt status

Options:
    -m, --model MODEL    HuggingFace model (default: $MODEL)
    -s, --system NAME    Use named system prompt for this query
    -c, --conversation   Enable multi-turn conversation mode
    -r, --raw            Disable markdown formatting
    -v, --verbose        Show llama-cli output (downloads, loading, etc.)
    -h, --help           Show this help

Examples:
    llm serve                            # Start server (once)
    llm "What is the capital of France?" # Instant response
    llm prompts                          # Manage system prompts
    llm stop                             # Stop server when done
EOF
    exit 0
}

run_llm() {
    SYSTEM_PROMPT=$(get_system_prompt)

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -m|--model)
                MODEL="$2"
                shift 2
                ;;
            -s|--system)
                # Use a named prompt
                SYSTEM_PROMPT=$(grep "^$2	" "$PROMPTS_FILE" | cut -f2-)
                if [[ -z "$SYSTEM_PROMPT" ]]; then
                    error "Prompt '$2' not found"
                fi
                shift 2
                ;;
            -c|--conversation)
                CONVERSATION=true
                shift
                ;;
            -r|--raw)
                FORMAT=false
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    # Get prompt from argument or stdin
    if [[ $# -gt 0 ]]; then
        PROMPT="$*"
    elif [[ ! -t 0 ]]; then
        PROMPT=$(cat)
    else
        echo "Error: No prompt provided" >&2
        echo "Usage: llm \"your prompt\" or echo \"prompt\" | llm" >&2
        exit 1
    fi

    # Use server if running, otherwise fall back to llama-cli
    if server_running; then
        if $CONVERSATION; then
            # Conversation mode
            conversation_loop "$PROMPT" "$SYSTEM_PROMPT" "$THEME_FILE" "$FORMAT"
        else
            # Single response mode
            if $FORMAT; then
                query_server_formatted "$PROMPT" "$SYSTEM_PROMPT" "$THEME_FILE"
            else
                query_server "$PROMPT" "$SYSTEM_PROMPT"
            fi
        fi
    else
        # Build llama-cli arguments
        ARGS=(
            --hf-repo "$MODEL"
            --ctx-size "$CONTEXT_SIZE"
            --prompt "$PROMPT"
            --no-display-prompt
        )

        [[ -n "$SYSTEM_PROMPT" ]] && ARGS+=(--system-prompt "$SYSTEM_PROMPT")
        $CONVERSATION || ARGS+=(--single-turn --no-perf)

        # Run llama-cli (formatting only available with server mode)
        if $VERBOSE; then
            exec llama-cli "${ARGS[@]}"
        else
            exec llama-cli "${ARGS[@]}" 2>/dev/null
        fi
    fi
}

# Main
case "${1:-}" in
    config)
        cmd_config
        ;;
    serve)
        cmd_serve
        ;;
    stop)
        cmd_stop
        ;;
    status)
        cmd_status
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        run_llm "$@"
        ;;
esac
