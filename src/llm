#!/bin/bash
# Simple wrapper around llama-cli

set -euo pipefail

# Configuration - edit these
MODEL="bartowski/Llama-3.2-3B-Instruct-GGUF:Q4_K_M"
CONTEXT_SIZE=4096
VERBOSE=false
QUICK=false

usage() {
    cat <<EOF
Usage: llm [options] [prompt]
       echo "prompt" | llm [options]

Options:
    -m, --model MODEL    HuggingFace model (default: $MODEL)
    -c, --context SIZE   Context size (default: $CONTEXT_SIZE)
    -q, --quick          Single response, no chat mode
    -v, --verbose        Show llama-cli output (downloads, loading, etc.)
    -h, --help           Show this help

Examples:
    llm "What is the capital of France?"
    echo "Explain recursion" | llm
    llm -m "TheBloke/Mistral-7B-v0.1-GGUF:Q4_K_M" "Hello"
EOF
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -m|--model)
            MODEL="$2"
            shift 2
            ;;
        -c|--context)
            CONTEXT_SIZE="$2"
            shift 2
            ;;
        -q|--quick)
            QUICK=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Get prompt from argument or stdin
if [[ $# -gt 0 ]]; then
    PROMPT="$*"
elif [[ ! -t 0 ]]; then
    PROMPT=$(cat)
else
    echo "Error: No prompt provided" >&2
    echo "Usage: llm \"your prompt\" or echo \"prompt\" | llm" >&2
    exit 1
fi

# Build llama-cli arguments
ARGS=(
    --hf-repo "$MODEL"
    --ctx-size "$CONTEXT_SIZE"
    --prompt "$PROMPT"
    --no-display-prompt
)

$QUICK && ARGS+=(--single-turn)

# Run llama-cli
if $VERBOSE; then
    exec llama-cli "${ARGS[@]}"
else
    exec llama-cli "${ARGS[@]}" 2>/dev/null
fi
