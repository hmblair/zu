#!/usr/bin/env zsh

# merge - Apply a diff from clipboard to files
# Wrapper around patch with preview and confirmation

source "${0:A:h}/common"

FORCE=0
DRY_RUN=0
STRIP_LEVEL=1

usage() {
    cat << EOF
Usage: merge [options]

Apply a unified diff from clipboard to files. The clipboard should contain
output from 'git diff', 'diff -u', or similar.

Options:
    -p<N>           Strip N leading path components (default: 1)
    -y, --yes       Apply without confirmation
    -n, --dry-run   Show what would be changed without applying
    -h, --help      Show this help message

Examples:
    # Copy a git diff, then apply it:
    git diff src/file.py | pbcopy
    merge

    # Apply with confirmation skipped:
    merge -y

    # Preview only:
    merge -n
EOF
}

# Get clipboard content
get_clipboard() {
    if command -v pbpaste >/dev/null 2>&1; then
        pbpaste
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -o
    elif command -v wl-paste >/dev/null 2>&1; then
        wl-paste
    else
        error "No clipboard tool found (pbpaste, xclip, or wl-paste)"
    fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p[0-9]*)
            STRIP_LEVEL="${1#-p}"
            shift
            ;;
        -y|--yes)
            FORCE=1
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            error "Unknown option: $1"
            ;;
        *)
            error "Unexpected argument: $1"
            ;;
    esac
done

# Get diff from clipboard
diff_content=$(get_clipboard)
[[ -z "$diff_content" ]] && error "Clipboard is empty"

# Basic validation - check if it looks like a diff
if ! echo "$diff_content" | grep -q '^@@\|^diff \|^---\|^+++'; then
    error "Clipboard doesn't appear to contain a unified diff"
fi

# Check if patch applies cleanly (silent)
if ! echo "$diff_content" | patch -p"$STRIP_LEVEL" --dry-run >/dev/null 2>&1; then
    echo "${RED}Patch does not apply cleanly:${NC}"
    echo "$diff_content" | patch -p"$STRIP_LEVEL" --dry-run 2>&1
    exit 1
fi

# Show preview (filter out metadata lines for cleaner output)
echo "$diff_content" | grep -v '^diff \|^index \|^---\|^+++\|^@@' | head -50
if [[ $(echo "$diff_content" | grep -v '^diff \|^index \|^---\|^+++\|^@@' | wc -l) -gt 50 ]]; then
    echo "${GREY}... (truncated)${NC}"
fi

# Dry run mode - stop here
if (( DRY_RUN )); then
    exit 0
fi

# Confirm unless --yes
if (( ! FORCE )); then
    echo ""
    echo -n "Apply? [y/N] "
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo "Cancelled"
        exit 1
    fi
fi

# Apply the patch (silent)
if echo "$diff_content" | patch -p"$STRIP_LEVEL" >/dev/null 2>&1; then
    success "Applied"
else
    error "Failed to apply patch"
fi
