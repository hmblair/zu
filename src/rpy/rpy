#!/usr/bin/env zsh
emulate -L zsh

# rpy - Run Python files on remote servers

# Debug mode
if [[ $1 == --debug ]]; then
    shift
    set -x
fi

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

CONFIG="$HOME/.config/rpy"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

# Run a command on remote via SSH (bypasses slow shell rc files)
remote_exec() {
    local target="$1"; shift
    ssh "$target" "bash --norc --noprofile -c '$*'"
}

# Pattern for pgrep that won't match itself (character class trick)
job_pattern() {
    echo "rpy-${1}[.]py"
}

# Find log file path on remote (SLURM uses ~/.rpy, direct SSH uses /tmp)
remote_log_path() {
    local job="$1"
    echo "if [ -f ~/.rpy/rpy-${job}.log ]; then echo ~/.rpy/rpy-${job}.log; elif [ -f /tmp/rpy-${job}.log ]; then echo /tmp/rpy-${job}.log; else echo ''; fi"
}

# Get most recent job ID from remote
get_last_job() {
    local target="$1"
    remote_exec "$target" "ls -t ~/.rpy/rpy-*.log /tmp/rpy-*.log 2>/dev/null | head -1 | sed 's|.*/rpy-||; s|\.log$||'"
}

# Resolve job ID, handling --last
resolve_job() {
    local target="$1"
    local job="$2"
    if [[ $job == "--last" ]]; then
        job=$(get_last_job "$target")
        [[ -z $job ]] && error "No jobs found"
    fi
    echo "$job"
}

# Escape string for JSON output
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    echo "$s"
}

usage() {
    cat << EOF
Usage: rpy <alias|host> [options] [file.py] [args...]
       rpy <alias|host> --jobs|--status|--log|--kill <job>
       rpy <alias|host> --sync [--no-install] [path]

Run Python files on remote servers, with job management for detached runs.

Options:
  -d              Detach: run in background, survive disconnection
  -n/--name <n>   Name for detached job (default: timestamp)
  -p <path>       Python interpreter (default: python3)
  -m <module>     Load module before running (repeatable)

Job management:
  --jobs          List all rpy jobs on remote
  --status <job>  Check if job is running (exit 0=running, 1=done)
  --log <job>     Show job output (use -f to follow)
  --kill <job>    Kill a running job
  --gpus          Show GPU availability and utilization
  --last          Use most recent job (with --status/--log/--kill)
  --json          Output in JSON format (with --jobs/--gpus/--status)

Project sync:
  --sync [path]    Rsync project to remote, pip install -e if pyproject.toml exists
  --no-install     Skip pip install (use with --sync)

SLURM options (for HPC clusters):
  --slurm          Enable SLURM mode (use srun/sbatch)
  --partition <p>  SLURM partition
  --gres <spec>    GPU resources (e.g., gpu:1)
  --time <limit>   Time limit (e.g., 2:00:00)

Aliases: Define in $CONFIG as:
  gpu = user@host -p /path/to/python
  sherlock = user@host --slurm -m python/3.12 --partition gpu --gres gpu:1

Examples:
  rpy gpu train.py                # run and stream output
  rpy gpu -d train.py             # detach, returns job ID
  rpy gpu -d -n exp1 train.py     # detach with custom name
  rpy gpu --jobs                  # list jobs
  rpy gpu --jobs --json           # list jobs as JSON
  rpy gpu --log --last            # view most recent job output
  rpy gpu --kill --last           # kill most recent job
  rpy gpu --gpus --json           # GPU info as JSON
  rpy gpu --sync                  # sync current project to remote
  echo 'print(1)' | rpy gpu
  rpy sherlock -m cuda/12.0 train.py  # SLURM with modules

EOF
}

expand_alias() {
    local name="$1"
    if [[ -f $CONFIG && $name != *@* ]]; then
        local line=$(grep -E "^${name}\s*=" "$CONFIG" 2>/dev/null | head -1)
        if [[ -n $line ]]; then
            local value=${line#*=}
            echo "${value## }"
            return 0
        fi
    fi
    return 1
}

# Extract just the host from target (for job commands, ignore -p flag)
parse_target() {
    local first="$1"
    if [[ $first == *@* ]]; then
        echo "$first"
    else
        echo "$1@$2"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Job management commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_jobs() {
    local target="$1"
    local json="$2"

    local output=$(ssh "$target" 'bash --norc --noprofile -c '\''
        for log in /tmp/rpy-*.log ~/.rpy/rpy-*.log; do
            [ -f "$log" ] || continue
            job=$(basename "$log" .log | sed "s/rpy-//")

            # Use character class trick to prevent pgrep from matching itself
            pattern="rpy-${job}[.]py"
            pid=$(pgrep -f "$pattern" 2>/dev/null | head -1)

            if [ -n "$pid" ]; then
                status="running"
            else
                status="done"
                pid=""
            fi

            # Get first line of script as description
            desc=""
            script_tmp="/tmp/rpy-${job}.py"
            script_home="$HOME/.rpy/rpy-${job}.py"
            if [ -f "$script_tmp" ]; then
                desc=$(head -1 "$script_tmp" | sed "s/^#[[:space:]]*//" | cut -c1-40)
            elif [ -f "$script_home" ]; then
                desc=$(head -1 "$script_home" | sed "s/^#[[:space:]]*//" | cut -c1-40)
            fi

            printf "%s\t%s\t%s\t%s\n" "$job" "$status" "$pid" "$desc"
        done
    '\''' | sort -r)

    if [[ $json == "true" ]]; then
        echo "["
        local first=true
        while IFS=$'\t' read -r job status pid desc; do
            [[ -z $job ]] && continue
            $first || echo ","
            first=false
            desc=$(json_escape "$desc")
            printf '  {"job": "%s", "status": "%s"' "$job" "$status"
            [[ -n $pid ]] && printf ', "pid": %s' "$pid"
            [[ -n $desc ]] && printf ', "description": "%s"' "$desc"
            printf '}'
        done <<< "$output"
        echo $'\n]'
    else
        while IFS=$'\t' read -r job status pid desc; do
            [[ -z $job ]] && continue
            if [[ -n $pid ]]; then
                printf "%-20s %-20s %s\n" "$job" "running (PID $pid)" "$desc"
            else
                printf "%-20s %-20s %s\n" "$job" "done" "$desc"
            fi
        done <<< "$output"
    fi
}

cmd_status() {
    local target="$1"
    local job="$2"
    local json="$3"

    [[ -z $job ]] && error "Usage: rpy <host> --status <job>"

    local pattern=$(job_pattern "$job")
    local pid=$(remote_exec "$target" "pgrep -f '$pattern' | head -1")

    local status="done"
    local exit_code=1
    if [[ -n $pid ]]; then
        status="running"
        exit_code=0
    fi

    if [[ $json == "true" ]]; then
        printf '{"job": "%s", "status": "%s"' "$job" "$status"
        [[ -n $pid ]] && printf ', "pid": %s' "$pid"
        echo '}'
    else
        echo "$status"
    fi
    return $exit_code
}

cmd_log() {
    local target="$1"
    local job="$2"
    local follow="$3"

    [[ -z $job ]] && error "Usage: rpy <host> --log <job> [-f]"

    local log_cmd=$(remote_log_path "$job")
    local cmd="log=\$($log_cmd); [ -n \"\$log\" ] || { echo 'Log not found' >&2; exit 1; }"
    if [[ $follow == "-f" ]]; then
        cmd+="; tail -f \"\$log\""
    else
        cmd+="; cat \"\$log\""
    fi
    remote_exec "$target" "$cmd"
}

cmd_kill() {
    local target="$1"
    local job="$2"

    [[ -z $job ]] && error "Usage: rpy <host> --kill <job>"

    local pattern=$(job_pattern "$job")
    local result=$(remote_exec "$target" "pid=\$(pgrep -f '$pattern' | head -1); if [ -n \"\$pid\" ]; then kill \"\$pid\" 2>/dev/null && echo killed || echo failed; else echo not_running; fi")

    case $result in
        killed) success "Killed job $job" ;;
        not_running) warn "Job $job is not running" ;;
        *) error "Failed to kill job $job" ;;
    esac
}

cmd_gpus() {
    local target="$1"
    local json="$2"

    local output=$(remote_exec "$target" "nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits 2>/dev/null")

    if [[ $json == "true" ]]; then
        echo "["
        local first=true
        while IFS=, read -r idx name mem_used mem_total util; do
            [[ -z $idx ]] && continue
            # Trim whitespace
            idx="${idx## }"; idx="${idx%% }"
            name="${name## }"; name="${name%% }"
            mem_used="${mem_used## }"; mem_used="${mem_used%% }"
            mem_total="${mem_total## }"; mem_total="${mem_total%% }"
            util="${util## }"; util="${util%% }"

            mem_pct=$((mem_used * 100 / mem_total))
            local gpu_status="busy"
            if [[ $util -lt 10 && $mem_pct -lt 10 ]]; then
                gpu_status="free"
            elif [[ $util -lt 50 ]]; then
                gpu_status="partial"
            fi

            $first || echo ","
            first=false
            printf '  {"index": %s, "name": "%s", "memory_used": %s, "memory_total": %s, "memory_percent": %s, "utilization": %s, "status": "%s"}' \
                "$idx" "$name" "$mem_used" "$mem_total" "$mem_pct" "$util" "$gpu_status"
        done <<< "$output"
        echo $'\n]'
    else
        while IFS=, read -r idx name mem_used mem_total util; do
            [[ -z $idx ]] && continue
            # Trim whitespace
            idx="${idx## }"; idx="${idx%% }"
            name="${name## }"; name="${name%% }"
            mem_used="${mem_used## }"; mem_used="${mem_used%% }"
            mem_total="${mem_total## }"; mem_total="${mem_total%% }"
            util="${util## }"; util="${util%% }"

            mem_pct=$((mem_used * 100 / mem_total))
            local gpu_status
            if [[ $util -lt 10 && $mem_pct -lt 10 ]]; then
                gpu_status="${GREEN}free${NC}"
            elif [[ $util -lt 50 ]]; then
                gpu_status="${YELLOW}partial${NC}"
            else
                gpu_status="${RED}busy${NC}"
            fi

            printf "GPU %s: %-20s %5dMB/%5dMB (%d%%)  util: %3d%%  %b\n" \
                "$idx" "$name" "$mem_used" "$mem_total" "$mem_pct" "$util" "$gpu_status"
        done <<< "$output"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# SLURM job management commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_slurm_jobs() {
    local target="$1"
    remote_exec "$target" "squeue -u \$USER -o '%.10i %.20j %.8T %.10M' 2>/dev/null | grep rpy || echo 'No rpy jobs'"
}

cmd_slurm_status() {
    local target="$1"
    local job="$2"

    [[ -z $job ]] && error "Usage: rpy <host> --status <job>"

    local state=$(remote_exec "$target" "squeue -u \$USER -n rpy-$job -h -o %T 2>/dev/null")
    if [[ -n $state ]]; then
        echo "$state"
        return 0
    else
        echo "done"
        return 1
    fi
}

cmd_slurm_kill() {
    local target="$1"
    local job="$2"

    [[ -z $job ]] && error "Usage: rpy <host> --kill <job>"

    if remote_exec "$target" "scancel -n rpy-$job 2>/dev/null"; then
        success "Cancelled job $job"
    else
        error "Failed to cancel job $job"
    fi
}

cmd_slurm_gpus() {
    local target="$1"
    remote_exec "$target" "sinfo -p gpu -o '%P %a %D %G' 2>/dev/null || echo 'No GPU partition info'"
}

# ─────────────────────────────────────────────────────────────────────────────
# Project sync
# ─────────────────────────────────────────────────────────────────────────────

cmd_sync() {
    local target="$1"
    local python="$2"
    local no_install="$3"
    local local_path="$4"

    # Default to current directory
    [[ -z $local_path ]] && local_path="$(pwd)"

    # Resolve to absolute path
    local_path="${local_path:A}"

    # Check path exists
    [[ -d $local_path ]] || error "Directory not found: $local_path"

    # Map local path to remote path
    # /Users/<user>/... → /home/<user>/...
    # /home/<user>/... → /home/<user>/... (unchanged)
    local remote_path
    if [[ $local_path == /Users/* ]]; then
        # macOS: /Users/foo/bar → /home/foo/bar
        remote_path="/home/${local_path#/Users/}"
    else
        remote_path="$local_path"
    fi

    # Rsync exclusions for Python projects
    local -a excludes=(
        '__pycache__'
        '*.pyc'
        '*.pyo'
        '.git'
        '.pytest_cache'
        '*.egg-info'
        'build'
        'dist'
        '.tox'
        '.eggs'
        '.mypy_cache'
        '.ruff_cache'
        '*.so'
        '.venv'
        'venv'
    )

    local exclude_args=""
    for ex in "${excludes[@]}"; do
        exclude_args+=" --exclude=$ex"
    done

    # Create remote directory
    info "Syncing to ${target}:${remote_path}"
    remote_exec "$target" "mkdir -p ${remote_path:h}" || error "Failed to create remote directory"

    # Rsync
    rsync -avz --delete ${=exclude_args} "${local_path}/" "${target}:${remote_path}/" || error "Rsync failed"
    success "Synced $(basename $local_path)"

    # Pip install if pyproject.toml or setup.py exists (and not --no-install)
    if [[ $no_install != "true" ]]; then
        if [[ -f "${local_path}/pyproject.toml" || -f "${local_path}/setup.py" ]]; then
            info "Installing package..."
            remote_exec "$target" "cd ${remote_path} && ${python} -m pip install -e . -q" || warn "pip install failed"
            success "Installed $(basename $local_path)"
        fi
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Run commands
# ─────────────────────────────────────────────────────────────────────────────

run_foreground() {
    local target="$1"
    local python="$2"
    local file="$3"
    shift 3
    local args=("$@")

    if [[ -z $file && -t 0 ]]; then
        error "No input file and stdin is a terminal. Provide a file or pipe input."
    fi

    [[ -n $file ]] && exec < "$file"
    # Use bash --norc to bypass slow/buggy shell rc files
    ssh -T "$target" "bash --norc --noprofile -c '$python - ${(q)args[@]}'"
}

run_detached() {
    local target="$1"
    local python="$2"
    local file="$3"
    local job_name="$4"
    shift 4
    local args=("$@")

    if [[ -z $file ]]; then
        error "-d requires a file (cannot detach piped input)"
    fi

    local job="${job_name:-$(date +%Y%m%d-%H%M%S)}"
    local remote_script="/tmp/rpy-${job}.py"
    local remote_log="/tmp/rpy-${job}.log"

    scp -q "$file" "${target}:${remote_script}" || error "Failed to copy script"

    local pid=$(remote_exec "$target" "nohup $python $remote_script ${(q)args[@]} > $remote_log 2>&1 & echo \$!")

    success "Detached: $job (PID $pid)"
    echo "Status: rpy ${target} --status $job"
    echo "Log:    rpy ${target} --log $job"
    echo "Kill:   rpy ${target} --kill $job"
}

# ─────────────────────────────────────────────────────────────────────────────
# SLURM run commands
# ─────────────────────────────────────────────────────────────────────────────

# Build SLURM resource options string
build_slurm_opts() {
    local partition="$1" gres="$2" time_limit="$3"
    local opts=""
    [[ -n $partition ]] && opts+=" --partition=$partition"
    [[ -n $gres ]] && opts+=" --gres=$gres"
    [[ -n $time_limit ]] && opts+=" --time=$time_limit"
    echo "$opts"
}

# Parse --module pairs from args, sets 'modules' and 'args' arrays
parse_module_args() {
    modules=()
    while [[ $1 == --module ]]; do
        shift; modules+=("$1"); shift
    done
    args=("$@")
}

run_slurm_foreground() {
    local target="$1"
    local python="$2"
    local file="$3"
    local partition="$4"
    local gres="$5"
    local time_limit="$6"
    shift 6

    local -a modules args
    parse_module_args "$@"

    if [[ -z $file && -t 0 ]]; then
        error "No input file and stdin is a terminal. Provide a file or pipe input."
    fi

    [[ -n $file ]] && exec < "$file"

    local slurm_opts=$(build_slurm_opts "$partition" "$gres" "$time_limit")

    # Build the inner command that runs on the compute node
    # Use login shell (-l) to get module system initialized
    local inner_cmd=""
    [[ ${#modules[@]} -gt 0 ]] && inner_cmd="module load ${modules[*]} && "
    inner_cmd+="$python - ${(q)args[@]}"

    ssh -T "$target" "bash --norc --noprofile -c 'srun$slurm_opts bash -l -c \"$inner_cmd\"'"
}

run_slurm_detached() {
    local target="$1"
    local python="$2"
    local file="$3"
    local partition="$4"
    local gres="$5"
    local time_limit="$6"
    local job_name="$7"
    shift 7

    local -a modules args
    parse_module_args "$@"

    [[ -z $file ]] && error "-d requires a file (cannot detach piped input)"

    local job="${job_name:-$(date +%Y%m%d-%H%M%S)}"
    # Get absolute home path (needed for SLURM --output which doesn't expand ~)
    local remote_home=$(remote_exec "$target" "echo \$HOME")
    local remote_dir="${remote_home}/.rpy"
    local remote_script="${remote_dir}/rpy-${job}.py"
    local remote_sbatch="${remote_dir}/rpy-${job}.sbatch"
    local remote_log="${remote_dir}/rpy-${job}.log"

    # Create directory and copy script
    remote_exec "$target" "mkdir -p ~/.rpy" || error "Failed to create remote directory"
    scp -q "$file" "${target}:${remote_script}" || error "Failed to copy script"

    # Build sbatch script (use login shell to get module system)
    local sbatch_content="#!/bin/bash -l
#SBATCH --job-name=rpy-${job}
#SBATCH --output=${remote_log}"
    [[ -n $partition ]] && sbatch_content+=$'\n'"#SBATCH --partition=$partition"
    [[ -n $gres ]] && sbatch_content+=$'\n'"#SBATCH --gres=$gres"
    [[ -n $time_limit ]] && sbatch_content+=$'\n'"#SBATCH --time=$time_limit"
    sbatch_content+=$'\n'
    for mod in "${modules[@]}"; do
        sbatch_content+="module load $mod"$'\n'
    done
    sbatch_content+="$python $remote_script ${(q)args[@]}"

    # Write sbatch script to remote
    remote_exec "$target" "cat > $remote_sbatch" <<< "$sbatch_content"

    # Submit and get SLURM job ID
    local slurm_id=$(remote_exec "$target" "sbatch --parsable $remote_sbatch 2>/dev/null")

    success "Submitted: $job (SLURM $slurm_id)"
    echo "Status: rpy ${target} --slurm --status $job"
    echo "Log:    rpy ${target} --log $job"
    echo "Kill:   rpy ${target} --slurm --kill $job"
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    if [[ $# -lt 1 || $1 == -h || $1 == --help || $1 == help ]]; then
        usage
        exit 0
    fi

    # Expand alias if present
    local alias_value
    if alias_value=$(expand_alias "$1"); then
        shift
        set -- ${=alias_value} "$@"
    fi

    # Parse target (user@host or user host)
    local target
    if [[ $1 == *@* ]]; then
        target=$1
        shift
    else
        if [[ $# -lt 2 ]]; then
            error "Missing hostname"
        fi
        target="$1@$2"
        shift 2
    fi

    # Parse all flags (short and long, in any order)
    local detach=false
    local python=python3
    local -a modules=()
    local slurm=false
    local partition=""
    local gres=""
    local time_limit=""
    local no_install=false
    local job_name=""
    local json=false
    while [[ $1 == -* ]]; do
        case $1 in
            # Short flags
            -d) detach=true; shift ;;
            -n) shift; job_name=$1; shift ;;
            -p) shift; python=$1; shift ;;
            -m) shift; modules+=("$1"); shift ;;
            # Long options
            --name) shift; job_name=$1; shift ;;
            --json) json=true; shift ;;
            # SLURM long options
            --slurm) slurm=true; shift ;;
            --partition) shift; partition=$1; shift ;;
            --gres) shift; gres=$1; shift ;;
            --time) shift; time_limit=$1; shift ;;
            # Sync options
            --no-install) no_install=true; shift ;;
            # Commands - stop parsing flags
            --jobs|--status|--log|--kill|--gpus|--sync|--last) break ;;
            # Unknown
            *) error "Unknown option: $1" ;;
        esac
    done

    # Helper to get job arg (handles --last)
    get_job_arg() {
        local arg="$1"
        [[ $arg == "--json" ]] && arg="$2"  # skip --json if it comes first
        [[ $arg == "--last" ]] && arg=$(get_last_job "$target")
        [[ -z $arg ]] && error "No jobs found"
        echo "$arg"
    }

    # Check for --json after command
    has_json_arg() {
        [[ $1 == "--json" || $2 == "--json" || $3 == "--json" ]]
    }

    # Check for commands
    case $1 in
        --jobs)
            shift
            [[ $1 == "--json" ]] && json=true
            if $slurm; then cmd_slurm_jobs "$target"
            else cmd_jobs "$target" "$json"; fi
            return
            ;;
        --status)
            shift
            has_json_arg "$@" && json=true
            local job=$(resolve_job "$target" "$1")
            if $slurm; then cmd_slurm_status "$target" "$job"
            else cmd_status "$target" "$job" "$json"; fi
            return
            ;;
        --log)
            shift
            local job=$(resolve_job "$target" "$1")
            local follow=""
            [[ $2 == "-f" || $1 == "-f" ]] && follow="-f"
            cmd_log "$target" "$job" "$follow"
            return
            ;;
        --kill)
            shift
            local job=$(resolve_job "$target" "$1")
            if $slurm; then cmd_slurm_kill "$target" "$job"
            else cmd_kill "$target" "$job"; fi
            return
            ;;
        --gpus)
            shift
            [[ $1 == "--json" ]] && json=true
            if $slurm; then cmd_slurm_gpus "$target"
            else cmd_gpus "$target" "$json"; fi
            return
            ;;
        --sync)
            shift  # consume --sync
            # Parse --no-install if it follows --sync
            local sync_no_install="$no_install"
            while [[ $1 == --* ]]; do
                case $1 in
                    --no-install) sync_no_install=true; shift ;;
                    *) break ;;
                esac
            done
            cmd_sync "$target" "$python" "$sync_no_install" "$1"
            return
            ;;
    esac

    # Parse file
    local file=""
    if [[ $# -gt 0 && -f $1 ]]; then
        file=$1
        shift
    fi

    # Run
    if $slurm; then
        # Pass modules as --module pairs
        local -a mod_args=()
        for mod in "${modules[@]}"; do
            mod_args+=(--module "$mod")
        done
        if $detach; then
            run_slurm_detached "$target" "$python" "$file" "$partition" "$gres" "$time_limit" "$job_name" "${mod_args[@]}" "$@"
        else
            run_slurm_foreground "$target" "$python" "$file" "$partition" "$gres" "$time_limit" "${mod_args[@]}" "$@"
        fi
    else
        if $detach; then
            run_detached "$target" "$python" "$file" "$job_name" "$@"
        else
            run_foreground "$target" "$python" "$file" "$@"
        fi
    fi
}

main "$@"
