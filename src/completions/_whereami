#compdef whereami

_whereami() {
    local -a commands
    commands=(
        'setup:Configure the DNS name for this machine'
        'show:Show configured DNS name'
        'reset:Remove configuration'
        'help:Show usage'
    )

    _arguments -C \
        '1:path or command:->first' \
        '*:path:_files'

    case $state in
        first)
            _alternative \
                'commands:command:((setup\:"Configure DNS name" show\:"Show DNS name" reset\:"Remove config" help\:"Show usage"))' \
                'files:path:_files'
            ;;
    esac
}

_whereami "$@"
