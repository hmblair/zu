#compdef photosort

_photosort() {
    local -a commands=(
        'setup:Manage photo libraries (add, remove, list)'
        'stats:Show photo counts for all libraries'
        'iphone:Import photos from connected iPhone'
        'fix-exif:Add EXIF dates to files based on folder structure'
        'help:Show usage'
    )

    local -a setup_commands=(
        'add:Add a new photo library'
        'remove:Remove a photo library'
        'list:List configured libraries'
    )

    local -a options=(
        '--dry-run[Preview changes without copying files]'
        '--move[Move instead of copy (destructive)]'
        '--hash[Use MD5 hash for duplicate detection]'
        '--help[Show help message]'
    )

    _arguments -C \
        '1:command:->command' \
        '*::arg:->args' \
        "${options[@]}"

    case $state in
        command)
            _describe -t commands 'photosort command' commands
            _files -/
            ;;
        args)
            case $words[1] in
                setup)
                    _describe -t setup-commands 'setup command' setup_commands
                    ;;
                stats)
                    _message 'year (optional)'
                    ;;
                iphone|fix-exif)
                    _arguments "${options[@]}"
                    ;;
                *)
                    _files -/
                    ;;
            esac
            ;;
    esac
}

_photosort "$@"
