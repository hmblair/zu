#compdef free

_free() {
    local -a commands
    commands=(
        'setup:Install daemon for hourly cache updates'
        'uninstall:Remove daemon'
        'reload:Reload daemon configuration'
        'update:Manually update the cache'
        'status:Show daemon and cache status'
        'help:Show help'
    )

    _arguments -C \
        '-n[Show top n largest files]:count' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1:command:->command'

    case $state in
        command)
            _describe -t commands 'free command' commands
            ;;
    esac
}

_free "$@"
