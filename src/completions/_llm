#compdef llm

_llm() {
    local curcontext="$curcontext" state

    _arguments -C \
        '(-m --model)'{-m,--model}'[HuggingFace model]:model:' \
        '(-s --system)'{-s,--system}'[Use named system prompt]:prompt:' \
        '(-c --conversation)'{-c,--conversation}'[Enable multi-turn conversation]' \
        '(-r --raw)'{-r,--raw}'[Disable markdown formatting]' \
        '(-v --verbose)'{-v,--verbose}'[Show llama-cli output]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1:command:->cmd' \
        '*:prompt:'

    case $state in
        cmd)
            local -a commands
            commands=(
                'config:Configure prompts and models'
                'serve:Start server (keeps model in memory)'
                'stop:Stop server'
                'status:Show server and prompt status'
            )
            _describe -t commands 'command' commands
            ;;
    esac
}

_llm "$@"
