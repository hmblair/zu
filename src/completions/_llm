#compdef llm

_llm() {
    local curcontext="$curcontext" state line

    _arguments -C \
        '(-p --prompt)'{-p,--prompt}'[Prompt to prepend to file]:prompt:' \
        '(-m --model)'{-m,--model}'[HuggingFace model]:model:' \
        '(-t --temp)'{-t,--temp}'[Temperature]:temperature:' \
        '(-T --template)'{-T,--template}'[Chat template]:template:' \
        '(-s --system)'{-s,--system}'[Use named system prompt]:prompt:' \
        '(-r --raw)'{-r,--raw}'[Disable markdown formatting]' \
        '(-v --verbose)'{-v,--verbose}'[Show llama-cli output]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1:command or file:->first' \
        '*:file:_files'

    case $state in
        first)
            local -a commands
            commands=(
                'config:Configure prompts, models, and settings'
                'serve:Start server'
                'stop:Stop server'
                'status:Show server and prompt status'
            )
            _alternative \
                'commands:command:((${(q)commands[@]}))' \
                'files:file:_files'
            ;;
    esac

    # Handle serve subcommand options
    if [[ $line[1] == serve ]]; then
        _arguments \
            '--context[Context size]:size:'
    fi
}

_llm "$@"
