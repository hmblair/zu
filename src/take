#!/usr/bin/env zsh

# copy - Copy to clipboard (works locally and over SSH)
# Uses OSC 52 escape sequence for SSH sessions

source "${0:A:h}/common"

input=""
interrupted=false

trap 'interrupted=true' INT
trap 'echo; exit 130' QUIT

copy_osc52() {
    # OSC 52 escape sequence - works over SSH with compatible terminals
    # (iTerm2, kitty, alacritty, Windows Terminal, etc.)
    local data=$(base64 | tr -d '\n')
    printf '\033]52;c;%s\a' "$data"
}

copy_local() {
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard
    elif command -v wl-copy >/dev/null 2>&1; then
        wl-copy
    else
        return 1
    fi
}

# Get input
from_stdin=false
if [[ $# -eq 0 ]]; then
    from_stdin=true
    # Check if stdin is a TTY (interactive) or pipe/file
    if [[ -t 0 ]]; then
        # Interactive - read line by line with timeout to allow interruption
        while ! $interrupted; do
            if ! IFS= read -t 1 -r line; then
                # Check if it was just timeout vs EOF/error
                if [[ $? -eq 1 ]]; then
                    # EOF - break
                    break
                fi
                # Timeout - continue loop to check interrupted flag
                continue
            fi
            [[ -n "$input" ]] && input+=$'\n'
            input+="$line"
        done
    else
        # Piped/file input - read all at once
        input=$(cat)
    fi
else
    input=$(cat "$@" 2>&1)
fi

# Echo to stderr so user can see what was copied (only when piping)
if $from_stdin && [[ -n "$input" ]]; then
    echo "$input" >&2
fi

# Try local clipboard first (faster, more reliable)
if [[ -z "$SSH_CONNECTION" ]]; then
    if echo -n "$input" | copy_local 2>/dev/null; then
        if $interrupted; then
            warn "Copied (interrupted)" >&2
        else
            success "Copied" >&2
        fi
        exit 0
    fi
fi

# Fall back to OSC 52 (works over SSH)
if echo -n "$input" | copy_osc52; then
    if $interrupted; then
        warn "Copied via OSC 52 (interrupted)" >&2
    else
        success "Copied via OSC 52" >&2
    fi
    exit 0
fi

echo "${RED}Failed to copy${NC}" >&2
exit 1
