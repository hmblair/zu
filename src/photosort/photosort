#!/usr/bin/env zsh

# photosort - Organize photos by EXIF date into YYYY/MM/DD structure

PATH="/usr/bin:/bin:$PATH"
setopt nullglob

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# ─────────────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────────────

CONFIG_DIR="$HOME/.config/photosort"
CONFIG_FILE="$CONFIG_DIR/config"
IPHONE_MOUNT="$HOME/iphone"
PHOTO_EXTENSIONS=(jpg jpeg heic png cr2 cr3 nef arw dng raf)
VIDEO_EXTENSIONS=(mp4 mov avi mkv)
ALL_EXTENSIONS=($PHOTO_EXTENSIONS $VIDEO_EXTENSIONS)

# Detect fastest available hash command (xxhash is 5-10x faster than md5)
if command -v xxhsum &>/dev/null; then
    HASH_CMD="xxhsum"
elif command -v xxh64sum &>/dev/null; then
    HASH_CMD="xxh64sum"
else
    HASH_CMD="md5sum"
fi

# Libraries array: "name:path" or "name:host:path"
typeset -a LIBRARIES=()

# Load config
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
    fi
    # Migrate old single-library config
    if [[ -n "$DEST_DIR" && ${#LIBRARIES[@]} -eq 0 ]]; then
        if [[ -n "$DEST_HOST" ]]; then
            LIBRARIES+=("default:$DEST_HOST:$DEST_DIR")
        else
            LIBRARIES+=("default:$DEST_DIR")
        fi
    fi
}

# Check if setup has been run
check_setup() {
    if [[ ! -f "$CONFIG_FILE" ]] || [[ ${#LIBRARIES[@]} -eq 0 ]]; then
        error "photosort not configured. Run 'photosort setup add' first."
    fi
}

# Parse library entry into name, host, path
# Usage: parse_library "name:host:path" or "name:path"
# Sets: LIB_NAME, LIB_HOST, LIB_PATH
parse_library() {
    local entry="$1"
    local parts=(${(s/:/)entry})

    LIB_NAME="${parts[1]}"
    if [[ ${#parts[@]} -eq 3 ]]; then
        LIB_HOST="${parts[2]}"
        LIB_PATH="${parts[3]}"
    else
        LIB_HOST=""
        LIB_PATH="${parts[2]}"
    fi
}

# Select a library via menu
# Returns selected library entry, sets DEST_HOST and DEST_DIR
select_library() {
    if [[ ${#LIBRARIES[@]} -eq 1 ]]; then
        parse_library "${LIBRARIES[1]}"
        DEST_HOST="$LIB_HOST"
        DEST_DIR="$LIB_PATH"
        return 0
    fi

    local -a names=()
    for lib in "${LIBRARIES[@]}"; do
        parse_library "$lib"
        if [[ -n "$LIB_HOST" ]]; then
            names+=("$LIB_NAME ($LIB_HOST:$LIB_PATH)")
        else
            names+=("$LIB_NAME ($LIB_PATH)")
        fi
    done

    echo "Select library:"
    menu "${names[@]}"
    local idx=$((1 + $?))

    parse_library "${LIBRARIES[$idx]}"
    DEST_HOST="$LIB_HOST"
    DEST_DIR="$LIB_PATH"
}

load_config

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: photosort [options] <source>
       photosort iphone [--dry-run]

Organize photos from source folder into LIBRARY/YYYY/MM/DD/

Commands:
  add             Add a new photo library
  remove          Remove a photo library
  list            List configured libraries
  stats [year]    Show photo counts for all libraries
  iphone          Import photos from connected iPhone
  fix-exif        Add EXIF dates to files based on folder structure

Options:
  --dry-run    Preview changes without copying files
  --move       Move instead of copy (destructive)
  --hash       Use MD5 hash for duplicate detection (slower but reliable)
  --help       Show this help message

Examples:
  photosort add                       # Add a new library
  photosort ~/DCIM                    # Copy photos (prompts for library)
  photosort --dry-run /mnt/sd/DCIM    # Preview without copying
  photosort --move ~/Downloads        # Move instead of copy
  photosort iphone                    # Import from iPhone
EOF
}

progress_bar() {
    local current="$1"
    local total="$2"
    local width=40
    local pct=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))

    printf "\r  [%s%s] %d/%d (%d%%)" \
        "$(printf '#%.0s' $(seq 1 $filled 2>/dev/null))" \
        "$(printf '.%.0s' $(seq 1 $empty 2>/dev/null))" \
        "$current" "$total" "$pct"
}

file_hash() {
    $HASH_CMD "$1" 2>/dev/null | cut -d' ' -f1
}

files_match() {
    local file1="$1"
    local file2="$2"
    local use_hash="$3"

    # First check size (fast)
    if [[ $(stat -c '%s' "$file1") -ne $(stat -c '%s' "$file2") ]]; then
        return 1  # Different size = different file
    fi

    # If hash mode, compare hashes
    if [[ "$use_hash" == "1" ]]; then
        [[ "$(file_hash "$file1")" == "$(file_hash "$file2")" ]]
        return $?
    fi

    # Size matches and no hash mode = assume same
    return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# Setup commands
# ─────────────────────────────────────────────────────────────────────────────

save_config() {
    /bin/mkdir -p "$CONFIG_DIR"
    {
        echo "# photosort configuration"
        echo "LIBRARIES=("
        for lib in "${LIBRARIES[@]}"; do
            echo "  \"$lib\""
        done
        echo ")"
    } > "$CONFIG_FILE"
}

cmd_setup_add() {
    info "Add photo library"
    echo ""

    # Prompt for name
    local name=""
    vared -p "Library name (e.g., pictures, raw): " name
    [[ -z "$name" ]] && error "Name is required"

    # Check for duplicate name
    for lib in "${LIBRARIES[@]}"; do
        parse_library "$lib"
        if [[ "$LIB_NAME" == "$name" ]]; then
            error "Library '$name' already exists"
        fi
    done

    # Prompt for optional SSH host
    local host=""
    vared -p "SSH host (leave empty for local): " host

    # Prompt for path
    local path=""
    vared -p "Directory path: " path
    [[ -z "$path" ]] && error "Path is required"

    # Validate based on local or remote
    if [[ -n "$host" ]]; then
        # Remote: test SSH connection and directory
        if ! /usr/bin/ssh -o ConnectTimeout=5 "$host" "test -d '$path'" 2>/dev/null; then
            if ! /usr/bin/ssh -o ConnectTimeout=5 "$host" "exit 0" 2>/dev/null; then
                error "Cannot connect to $host"
            fi
            if read -q "?Directory doesn't exist on $host. Create it? [y/N] "; then
                echo ""
                /usr/bin/ssh "$host" "mkdir -p '$path'"
                success "Created $path on $host"
            else
                echo ""
                error "Directory must exist"
            fi
        fi
        LIBRARIES+=("$name:$host:$path")
    else
        # Local: expand path and validate
        path="${path:A}"
        if [[ ! -d "$path" ]]; then
            if read -q "?Directory doesn't exist. Create it? [y/N] "; then
                echo ""
                /bin/mkdir -p "$path"
                success "Created $path"
            else
                echo ""
                error "Directory must exist"
            fi
        fi
        LIBRARIES+=("$name:$path")
    fi

    save_config
    echo ""
    success "Library '$name' added"
}

cmd_setup_remove() {
    if [[ ${#LIBRARIES[@]} -eq 0 ]]; then
        warn "No libraries configured"
        return
    fi

    info "Remove photo library"
    echo ""

    local -a names=()
    for lib in "${LIBRARIES[@]}"; do
        parse_library "$lib"
        names+=("$LIB_NAME")
    done

    echo "Select library to remove:"
    menu "${names[@]}"
    local idx=$((1 + $?))
    local removed_name="${names[$idx]}"

    # Remove from array
    LIBRARIES=("${LIBRARIES[@]:0:$((idx-1))}" "${LIBRARIES[@]:$idx}")

    save_config
    echo ""
    success "Library '$removed_name' removed"
}

cmd_setup_list() {
    if [[ ${#LIBRARIES[@]} -eq 0 ]]; then
        warn "No libraries configured. Run 'photosort setup add' to add one."
        return
    fi

    info "Configured libraries:"
    echo ""
    for lib in "${LIBRARIES[@]}"; do
        parse_library "$lib"
        if [[ -n "$LIB_HOST" ]]; then
            echo "  ${BOLD}$LIB_NAME${NC}  $LIB_HOST:$LIB_PATH"
        else
            echo "  ${BOLD}$LIB_NAME${NC}  $LIB_PATH"
        fi
    done
}

# Global size index: SIZE_INDEX[size]="file1|file2|..."
typeset -A SIZE_INDEX
typeset -g SIZE_INDEX_BUILT=0

build_size_index() {
    [[ $SIZE_INDEX_BUILT -eq 1 ]] && return
    info "Building size index of existing photos..."

    local count=0
    # Use find -printf for speed (one command vs 13000+ stat calls)
    while IFS=: read -r size filepath; do
        if [[ -n "${SIZE_INDEX[$size]}" ]]; then
            SIZE_INDEX[$size]+="|$filepath"
        else
            SIZE_INDEX[$size]="$filepath"
        fi
        ((count++))
    done < <(find "$DEST_DIR" -type f -printf '%s:%p\n' 2>/dev/null)

    info "  Indexed $count files"
    SIZE_INDEX_BUILT=1
}

check_size_duplicate() {
    local file="$1"
    local use_hash="$2"

    local size=$(stat -c '%s' "$file" 2>/dev/null)
    local matches="${SIZE_INDEX[$size]}"

    [[ -z "$matches" ]] && return 1  # No size match

    # Size match found - always verify with hash to avoid false positives
    local source_hash=$(file_hash "$file")
    local IFS='|'
    for existing in ${=matches}; do
        if [[ "$source_hash" == "$(file_hash "$existing")" ]]; then
            echo "$existing"
            return 0
        fi
    done
    return 1  # Hash didn't match - different file with same size
}

find_duplicate_in_folder() {
    local source_file="$1"
    local dest_dir="$2"
    local use_hash="$3"

    [[ ! -d "$dest_dir" ]] && return 1

    # Build cache for this folder if not already done
    build_folder_cache "$dest_dir"

    local source_size=$(stat -c '%s' "$source_file")
    local source_hash=""
    local cache="${FOLDER_CACHE[$dest_dir]}"

    [[ -z "$cache" ]] && return 1

    # Parse cache and find size matches
    local IFS='|'
    for entry in ${=cache}; do
        local entry_size="${entry%%:*}"
        local entry_file="${entry#*:}"

        [[ "$entry_size" != "$source_size" ]] && continue

        # Size matches - check hash if enabled
        if [[ "$use_hash" == "1" ]]; then
            [[ -z "$source_hash" ]] && source_hash=$(file_hash "$source_file")
            if [[ "$source_hash" == "$(file_hash "$entry_file")" ]]; then
                echo "$entry_file"
                return 0
            fi
        else
            # Size match without hash = assume duplicate
            echo "$entry_file"
            return 0
        fi
    done

    return 1
}

# ─────────────────────────────────────────────────────────────────────────────
# Core functions
# ─────────────────────────────────────────────────────────────────────────────

# Associative array for batch EXIF dates: EXIF_DATES[filepath]=date
typeset -gA EXIF_DATES

# Check if exiv2 is available (faster than exiftool)
USE_EXIV2=0
if command -v exiv2 &>/dev/null; then
    USE_EXIV2=1
fi

# Batch fetch EXIF dates for multiple files using parallel processing
# Usage: batch_fetch_exif file1 file2 ... OR reads from stdin if no args
batch_fetch_exif() {
    local tmpdir=$(mktemp -d)
    local num_cores=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

    {
        # Write filenames to temp file
        local tmpfile="$tmpdir/files.txt"
        if [[ $# -gt 0 ]]; then
            printf '%s\n' "$@" > "$tmpfile"
        else
            cat > "$tmpfile"
        fi

        [[ ! -s "$tmpfile" ]] && return

        local to_fetch=$(wc -l < "$tmpfile" | tr -d ' ')

        # Split into chunks for parallel processing
        split -n "l/$num_cores" "$tmpfile" "$tmpdir/chunk_"

        # Run EXIF reader on each chunk in parallel
        local pids=()
        local i=0
        for chunk in "$tmpdir"/chunk_*; do
            [[ -f "$chunk" ]] || continue
            if [[ $USE_EXIV2 -eq 1 ]]; then
                # exiv2 per-file (no batch mode, but faster per file)
                while IFS= read -r f; do
                    local date=$(exiv2 -g Exif.Photo.DateTimeOriginal -Pv "$f" 2>/dev/null | head -1)
                    [[ -z "$date" ]] && date=$(exiv2 -g Exif.Image.DateTime -Pv "$f" 2>/dev/null | head -1)
                    printf '%s\t%s\n' "$f" "$date"
                done < "$chunk" > "$tmpdir/out_$i.txt" &
            else
                # exiftool batch with -@ (fast)
                exiftool -fast2 -T -SourceFile -DateTimeOriginal -CreateDate -MediaCreateDate -@ "$chunk" \
                    > "$tmpdir/out_$i.txt" 2>/dev/null &
            fi
            pids+=($!)
            ((i++))
        done

        # Show progress while waiting
        while true; do
            local running=0
            for pid in "${pids[@]}"; do
                kill -0 "$pid" 2>/dev/null && ((running++))
            done
            local processed=$(cat "$tmpdir"/out_*.txt 2>/dev/null | wc -l)
            printf "\r  [%d/%d]" "$processed" "$to_fetch"
            [[ $running -eq 0 ]] && break
            sleep 0.3
        done

        # Wait for all to finish
        for pid in "${pids[@]}"; do
            wait "$pid" 2>/dev/null
        done

        local processed=$(cat "$tmpdir"/out_*.txt 2>/dev/null | wc -l)
        printf "\r  [%d/%d]\n" "$processed" "$to_fetch"

        # Parse output and update EXIF_DATES
        if [[ $USE_EXIV2 -eq 1 ]]; then
            # exiv2 format: filepath\tdate
            awk -F'\t' '{
                if ($1 != "" && $2 != "") {
                    filepath = $1; date = $2
                    gsub(/'\''/, "'\''\\'\'''\''", filepath)
                    print "EXIF_DATES['\''" filepath "'\'']='\''" date "'\''"
                }
            }' "$tmpdir"/out_*.txt > "$tmpdir/assignments.zsh"
        else
            # exiftool format: filepath\tdate1\tdate2\tdate3
            awk -F'\t' '{
                filepath = $1
                date = ""
                for (i = 2; i <= 4; i++) {
                    if ($i != "" && $i != "-" && $i !~ /^0000/) {
                        date = $i
                        break
                    }
                }
                if (date != "" && filepath != "" && filepath != "-") {
                    gsub(/'\''/, "'\''\\'\'''\''", filepath)
                    print "EXIF_DATES['\''" filepath "'\'']='\''" date "'\''"
                }
            }' "$tmpdir"/out_*.txt > "$tmpdir/assignments.zsh"
        fi
        source "$tmpdir/assignments.zsh"
    } always {
        rm -rf "$tmpdir"
    }
}

get_date_from_exif() {
    local file="$1"

    # Use pre-fetched date if available
    if [[ -n "${EXIF_DATES[$file]}" ]]; then
        echo "${EXIF_DATES[$file]}"
        return
    fi

    # Fallback to single-file call (for small batches or missed files)
    local -a dates
    dates=("${(@f)$(exiftool -s -s -s -DateTimeOriginal -CreateDate -MediaCreateDate "$file" 2>/dev/null)}")

    for d in "${dates[@]}"; do
        if [[ -n "$d" && "$d" != "0000:00:00 00:00:00" ]]; then
            echo "$d"
            return
        fi
    done

    echo ""
}

get_date_from_filename() {
    local file="$1"
    local basename="${file:t}"

    # Try to extract date from common filename patterns
    # Pattern: YYYYMMDD or YYYY-MM-DD or YYYY_MM_DD
    if [[ "$basename" =~ ^([0-9]{4})[-_]?([0-9]{2})[-_]?([0-9]{2}) ]]; then
        echo "${match[1]}:${match[2]}:${match[3]} 00:00:00"
        return
    fi

    echo ""
}

get_date_from_mtime() {
    local file="$1"
    stat -c '%y' "$file" 2>/dev/null | sed 's/-/:/g; s/\.[0-9]*//'
}

format_date_path() {
    local date="$1"
    # Input: "2025:01:15 14:30:00"
    # Output: "2025/01/15"

    local year="${date:0:4}"
    local month="${date:5:2}"
    local day="${date:8:2}"

    echo "$year/$month/$day"
}

format_filename() {
    local date="$1"
    local ext="$2"
    # Input: "2025:01:15 14:30:00", "jpg"
    # Output: "20250115-143000.jpg"

    local formatted=$(echo "$date" | sed 's/[: ]//g; s/\(........\)\(......\).*/\1-\2/')
    echo "${formatted}.${ext:l}"
}

# Stats for progress mode
typeset -g STATS_COPIED=0
typeset -g STATS_SKIPPED=0
typeset -g STATS_NODATE=0

typeset -g STATS_FAILED=0

process_file_new() {
    local file="$1"
    local dry_run="$2"
    local copy_mode="$3"

    local ext="${file:e:l}"
    local basename="${file:t}"

    # Check source still exists (iPhone might be unplugged)
    if [[ ! -f "$file" ]]; then
        ((STATS_FAILED++))
        return 1
    fi

    # Get date (try EXIF, then filename, then mtime)
    local date=$(get_date_from_exif "$file")

    if [[ -z "$date" ]]; then
        date=$(get_date_from_filename "$file")
    fi

    if [[ -z "$date" ]]; then
        date=$(get_date_from_mtime "$file")
    fi

    if [[ -z "$date" ]]; then
        ((STATS_NODATE++))
        return
    fi

    # Build destination path
    local date_path=$(format_date_path "$date")
    local new_name=$(format_filename "$date" "$ext")
    local dest_dir="$DEST_DIR/$date_path"
    local dest_file="$dest_dir/$new_name"

    # Handle filename collision
    local counter=1
    while [[ -f "$dest_file" ]]; do
        new_name=$(format_filename "$date" "$ext" | sed "s/\.$ext/-$counter.$ext/")
        dest_file="$dest_dir/$new_name"
        ((counter++))
    done

    # Perform the operation
    if [[ "$dry_run" != "1" ]]; then
        /bin/mkdir -p "$dest_dir"

        local src_size=$(stat -c '%s' "$file" 2>/dev/null)
        if [[ -z "$src_size" ]]; then
            ((STATS_FAILED++))
            return 1
        fi

        if [[ "$copy_mode" == "1" ]]; then
            cp "$file" "$dest_file" 2>/dev/null
        else
            mv "$file" "$dest_file" 2>/dev/null
        fi

        # Verify copy succeeded
        if [[ ! -f "$dest_file" ]]; then
            ((STATS_FAILED++))
            return 1
        fi

        local dest_size=$(stat -c '%s' "$dest_file" 2>/dev/null)
        if [[ "$src_size" != "$dest_size" ]]; then
            # Incomplete copy - remove corrupted file
            rm -f "$dest_file"
            ((STATS_FAILED++))
            return 1
        fi
    fi
    ((STATS_COPIED++))
}

process_file() {
    local file="$1"
    local dry_run="$2"
    local copy_mode="$3"
    local use_hash="$4"

    local ext="${file:e:l}"
    local basename="${file:t}"

    # Check if supported extension
    local supported=0
    for e in $ALL_EXTENSIONS; do
        [[ "$ext" == "$e" ]] && supported=1 && break
    done
    [[ $supported -eq 0 ]] && return

    # Fast duplicate check by size (before reading EXIF)
    local existing_dup=$(check_size_duplicate "$file" "$use_hash")
    if [[ -n "$existing_dup" ]]; then
        ((STATS_SKIPPED++))
        return
    fi

    # Get date (try EXIF, then filename, then mtime)
    local date=$(get_date_from_exif "$file")
    local date_source="EXIF"

    if [[ -z "$date" ]]; then
        date=$(get_date_from_filename "$file")
        date_source="filename"
    fi

    if [[ -z "$date" ]]; then
        date=$(get_date_from_mtime "$file")
        date_source="mtime"
    fi

    if [[ -z "$date" ]]; then
        ((STATS_NODATE++))
        return
    fi

    # Build destination path
    local date_path=$(format_date_path "$date")
    local new_name=$(format_filename "$date" "$ext")
    local dest_dir="$DEST_DIR/$date_path"
    local dest_file="$dest_dir/$new_name"

    # Handle filename collision (different file, same timestamp)
    local counter=1
    while [[ -f "$dest_file" ]]; do
        new_name=$(format_filename "$date" "$ext" | sed "s/\.$ext/-$counter.$ext/")
        dest_file="$dest_dir/$new_name"
        ((counter++))
    done

    # Perform the operation
    if [[ "$dry_run" != "1" ]]; then
        /bin/mkdir -p "$dest_dir"
        if [[ "$copy_mode" == "1" ]]; then
            cp "$file" "$dest_file"
        else
            mv "$file" "$dest_file"
        fi
    fi
    ((STATS_COPIED++))
}

cmd_sort() {
    local source_dir="$1"
    local dry_run="$2"
    local copy_mode="$3"
    local use_hash="$4"

    [[ ! -d "$source_dir" ]] && error "Source directory not found: $source_dir"

    info "Source: $source_dir"
    info "Destination: $DEST_DIR"
    [[ "$dry_run" == "1" ]] && warn "(dry run - no files will be moved)"
    [[ "$copy_mode" == "1" ]] && info "(copy mode - originals will be preserved)"
    echo ""

    # Build size index of existing photos (fast, local disk)
    build_size_index

    # Get source file list with sizes (one fast command)
    info "Scanning source files..."
    local -a new_files=()
    local total=0
    local skipped=0

    while IFS=: read -r size filepath; do
        ((total++))
        # Check extension
        local ext="${filepath:e:l}"
        local supported=0
        for e in $ALL_EXTENSIONS; do
            [[ "$ext" == "$e" ]] && supported=1 && break
        done
        [[ $supported -eq 0 ]] && continue

        # Check if size exists in index (potential duplicate)
        if [[ -n "${SIZE_INDEX[$size]}" ]]; then
            ((skipped++))
            # Store for hash verification later
            new_files+=("CHECK:$size:$filepath")
        else
            # Definitely new - no size match
            new_files+=("NEW:$size:$filepath")
        fi
    done < <(find "$source_dir" -type f -printf '%s:%p\n' 2>/dev/null)

    info "  Found $total files, ${#new_files[@]} to check"
    echo ""

    # Batch fetch EXIF dates (much faster than per-file calls)
    if [[ ${#new_files[@]} -gt 0 ]]; then
        info "Reading EXIF data..."
        local -a filepaths=()
        for entry in "${new_files[@]}"; do
            filepaths+=("${entry#*:*:}")
        done
        printf '%s\n' "${filepaths[@]}" | batch_fetch_exif
        echo ""
    fi

    # Reset stats
    STATS_COPIED=0
    STATS_SKIPPED=0
    STATS_NODATE=0
    STATS_FAILED=0

    local count=0
    local check_count=${#new_files[@]}
    local disconnected=0

    info "Processing..."

    for entry in "${new_files[@]}"; do
        ((count++))
        progress_bar "$count" "$check_count"

        local entry_type="${entry%%:*}"
        local rest="${entry#*:}"
        local size="${rest%%:*}"
        local filepath="${rest#*:}"

        if [[ "$entry_type" == "CHECK" ]]; then
            # Size match - verify with hash
            local dup=$(check_size_duplicate "$filepath" "1")
            if [[ -n "$dup" ]]; then
                ((STATS_SKIPPED++))
                continue
            fi
        fi

        # Process as new file
        process_file_new "$filepath" "$dry_run" "$copy_mode"

        # Check if source disappeared (disconnect detection)
        if [[ $? -eq 1 && $STATS_FAILED -ge 3 ]]; then
            echo ""
            warn "Source disconnected - stopping"
            disconnected=1
            break
        fi
    done

    echo ""
    echo ""

    # Show summary
    if [[ $total -eq 0 ]]; then
        warn "No supported files found"
    else
        local action="copied"
        [[ "$dry_run" == "1" ]] && action="to copy"
        [[ "$copy_mode" != "1" && "$dry_run" != "1" ]] && action="moved"
        [[ "$copy_mode" != "1" && "$dry_run" == "1" ]] && action="to move"

        if [[ $disconnected -eq 1 ]]; then
            warn "Interrupted!"
        else
            success "Done!"
        fi
        echo "  ${GREEN}$STATS_COPIED${NC} $action"
        echo "  ${GREY}$STATS_SKIPPED${NC} skipped (duplicates)"
        [[ $STATS_NODATE -gt 0 ]] && echo "  ${YELLOW}$STATS_NODATE${NC} skipped (no date)"
        [[ $STATS_FAILED -gt 0 ]] && echo "  ${RED}$STATS_FAILED${NC} failed"
        [[ $disconnected -eq 1 ]] && info "Run again after reconnecting to continue"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Fix EXIF command
# ─────────────────────────────────────────────────────────────────────────────

cmd_fix_exif() {
    local dry_run="$1"

    info "Scanning for files missing EXIF dates..."
    echo ""

    local fixed=0
    local skipped=0
    local total=0

    # Find all files in DEST_DIR with YYYY/MM/DD structure
    while IFS= read -r file; do
        ((total++))

        # Extract date from path: .../YYYY/MM/DD/filename
        local dir="${file:h}"
        local day="${dir:t}"
        local month_dir="${dir:h}"
        local month="${month_dir:t}"
        local year_dir="${month_dir:h}"
        local year="${year_dir:t}"

        # Validate it looks like a date
        if [[ ! "$year" =~ ^[0-9]{4}$ ]] || [[ ! "$month" =~ ^[0-9]{2}$ ]] || [[ ! "$day" =~ ^[0-9]{2}$ ]]; then
            continue
        fi

        # Check if file already has EXIF date
        local existing_date=$(exiftool -s -s -s -DateTimeOriginal "$file" 2>/dev/null)
        if [[ -n "$existing_date" && "$existing_date" != "0000:00:00 00:00:00" ]]; then
            ((skipped++))
            continue
        fi

        # Build EXIF date string (use noon as default time)
        local exif_date="$year:$month:$day 12:00:00"

        if [[ "$dry_run" == "1" ]]; then
            echo "  would fix: ${file#$DEST_DIR/} → $exif_date"
        else
            exiftool -overwrite_original -DateTimeOriginal="$exif_date" "$file" >/dev/null 2>&1
            echo "  fixed: ${file#$DEST_DIR/}"
        fi
        ((fixed++))

    done < <(find "$DEST_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.heic" \) 2>/dev/null)

    echo ""
    if [[ "$dry_run" == "1" ]]; then
        success "Found $fixed files to fix ($skipped already have EXIF dates)"
    else
        success "Fixed $fixed files ($skipped already had EXIF dates)"
    fi
}

