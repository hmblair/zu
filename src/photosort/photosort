# Helper to get directory size (local or remote)
get_dir_size() {
    local host="$1"
    local path="$2"
    if [[ -n "$host" ]]; then
        /usr/bin/ssh "$host" "du -sh '$path' 2>/dev/null" | /usr/bin/cut -f1
    else
        du -sh "$path" 2>/dev/null | /usr/bin/cut -f1
    fi
}

# Check if extension is a video
is_video_ext() {
    local ext="${1:l}"
    for e in $VIDEO_EXTENSIONS; do
        [[ "$ext" == "$e" ]] && return 0
    done
    return 1
}

# Generate underline matching visible length of text (strips ANSI codes)
underline() {
    local text="$1"
    # Strip ANSI escape codes to get visible length
    local stripped=$(echo -n "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#stripped}
    printf '─%.0s' $(seq 1 $len)
}

# Stats for a single library
cmd_stats_library() {
    local lib_name="$1"
    local lib_host="$2"
    local lib_path="$3"
    local filter_year="$4"

    # Header
    if [[ -n "$lib_host" ]]; then
        echo "${BOLD}$lib_name${NC}  ($lib_host:$lib_path)"
    else
        echo "${BOLD}$lib_name${NC}  ($lib_path)"
    fi
    echo "════════════════════════════════════════"
    echo ""

    typeset -A year_photos
    typeset -A year_videos
    typeset -A month_photos
    typeset -A month_videos
    local total_photos=0
    local total_videos=0

    # Build search path
    local search_path="$lib_path"
    [[ -n "$filter_year" ]] && search_path="$lib_path/$filter_year"

    # Check if filtered year exists
    if [[ -n "$filter_year" ]]; then
        if [[ -n "$lib_host" ]]; then
            if ! /usr/bin/ssh "$lib_host" "test -d '$search_path'" 2>/dev/null; then
                warn "No photos found for $filter_year"
                echo ""
                return
            fi
        elif [[ ! -d "$search_path" ]]; then
            warn "No photos found for $filter_year"
            echo ""
            return
        fi
    fi

    # Scan all files and count by year/month
    local find_output
    if [[ -n "$lib_host" ]]; then
        find_output=$(/usr/bin/ssh "$lib_host" "find '$search_path' -type f 2>/dev/null")
    else
        find_output=$(find "$search_path" -type f 2>/dev/null)
    fi

    while IFS= read -r file; do
        [[ -z "$file" ]] && continue

        # Extract date from path: .../YYYY/MM/DD/filename
        local dir="${file:h}"
        local day="${dir:t}"
        local month_dir="${dir:h}"
        local month="${month_dir:t}"
        local year_dir="${month_dir:h}"
        local year="${year_dir:t}"

        # Validate it looks like a date
        if [[ ! "$year" =~ ^[0-9]{4}$ ]] || [[ ! "$month" =~ ^[0-9]{2}$ ]]; then
            continue
        fi

        # Count by type (photo vs video)
        local ext="${file:e}"
        local key="$year:$month"
        if is_video_ext "$ext"; then
            ((month_videos[$key]++))
            ((year_videos[$year]++))
            ((total_videos++))
        else
            ((month_photos[$key]++))
            ((year_photos[$year]++))
            ((total_photos++))
        fi
    done <<< "$find_output"

    # Get sorted unique years (from both photos and videos)
    local -a years=()
    for key in "${(@k)year_photos}"; do
        years+=("$key")
    done
    for key in "${(@k)year_videos}"; do
        [[ ! " ${years[*]} " =~ " $key " ]] && years+=("$key")
    done
    years=(${(on)years})

    # Display by year
    for year in "${years[@]}"; do
        local photos="${year_photos[$year]:-0}"
        local videos="${year_videos[$year]:-0}"
        local year_size=$(get_dir_size "$lib_host" "$lib_path/$year")

        # Build count string (with proper pluralization)
        local count_str=""
        if [[ $photos -gt 0 ]]; then
            [[ $photos -eq 1 ]] && count_str="${CYAN}$photos${NC} photo" || count_str="${CYAN}$photos${NC} photos"
        fi
        if [[ $videos -gt 0 ]]; then
            [[ -n "$count_str" ]] && count_str="$count_str, "
            [[ $videos -eq 1 ]] && count_str="${count_str}${CYAN}$videos${NC} video" || count_str="${count_str}${CYAN}$videos${NC} videos"
        fi

        local year_line="${BOLD}$year${NC}  ($count_str, ${CYAN}$year_size${NC})"
        echo "$year_line"
        underline "$year_line"
        echo

        # Get months for this year (from both photos and videos)
        local -a months=()
        for key in "${(@k)month_photos}"; do
            if [[ "$key" == "$year:"* ]]; then
                months+=("${key#*:}")
            fi
        done
        for key in "${(@k)month_videos}"; do
            if [[ "$key" == "$year:"* ]]; then
                local m="${key#*:}"
                [[ ! " ${months[*]} " =~ " $m " ]] && months+=("$m")
            fi
        done
        months=(${(on)months})

        for month in "${months[@]}"; do
            local p="${month_photos[$year:$month]:-0}"
            local v="${month_videos[$year:$month]:-0}"
            local month_name=""
            case "$month" in
                01) month_name="Jan" ;; 02) month_name="Feb" ;;
                03) month_name="Mar" ;; 04) month_name="Apr" ;;
                05) month_name="May" ;; 06) month_name="Jun" ;;
                07) month_name="Jul" ;; 08) month_name="Aug" ;;
                09) month_name="Sep" ;; 10) month_name="Oct" ;;
                11) month_name="Nov" ;; 12) month_name="Dec" ;;
                *) month_name="$month" ;;
            esac
            if [[ $v -gt 0 ]]; then
                printf "  %s %s  %5d  %5d\n" "$month" "$month_name" "$p" "$v"
            else
                printf "  %s %s  %5d\n" "$month" "$month_name" "$p"
            fi
        done
        echo ""
    done

    local total_size=$(get_dir_size "$lib_host" "$search_path")

    # Build total string (with proper pluralization)
    local total_str=""
    if [[ $total_photos -gt 0 ]]; then
        [[ $total_photos -eq 1 ]] && total_str="${CYAN}$total_photos${NC}${BOLD} photo" || total_str="${CYAN}$total_photos${NC}${BOLD} photos"
    fi
    if [[ $total_videos -gt 0 ]]; then
        [[ -n "$total_str" ]] && total_str="$total_str, "
        [[ $total_videos -eq 1 ]] && total_str="${total_str}${CYAN}$total_videos${NC}${BOLD} video" || total_str="${total_str}${CYAN}$total_videos${NC}${BOLD} videos"
    fi

    local total_line="${BOLD}Total: $total_str, ${CYAN}$total_size${NC}"
    underline "$total_line"
    echo
    echo "$total_line"
    echo ""
}

cmd_stats() {
    local filter_year="$1"

    [[ -n "$filter_year" ]] && info "Filtering: $filter_year" && echo ""

    for lib in "${LIBRARIES[@]}"; do
        parse_library "$lib"
        cmd_stats_library "$LIB_NAME" "$LIB_HOST" "$LIB_PATH" "$filter_year"
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# iPhone command
# ─────────────────────────────────────────────────────────────────────────────

is_iphone_mounted() {
    mount | grep -q "$IPHONE_MOUNT"
}

cmd_iphone() {
    local dry_run="$1"
    local use_hash="$2"

    # Check if ifuse is available
    if ! command -v ifuse &>/dev/null; then
        error "ifuse not installed. Run: sudo apt install ifuse libimobiledevice6"
    fi

    # Create mount point if needed
    /bin/mkdir -p "$IPHONE_MOUNT"

    # Mount if not already mounted
    if ! is_iphone_mounted; then
        info "Mounting iPhone..."
        if ! ifuse "$IPHONE_MOUNT" 2>/dev/null; then
            error "Failed to mount iPhone. Make sure it's connected and trusted."
        fi
        success "iPhone mounted at $IPHONE_MOUNT"
    else
        info "iPhone already mounted at $IPHONE_MOUNT"
    fi

    # Check for DCIM
    if [[ ! -d "$IPHONE_MOUNT/DCIM" ]]; then
        error "DCIM folder not found. Is the iPhone unlocked?"
    fi

    # Count photos
    local photo_count=$(find "$IPHONE_MOUNT/DCIM" -type f 2>/dev/null | wc -l)
    info "Found $photo_count files in DCIM"
    echo ""

    # Run sort in copy mode (preserve originals on phone)
    cmd_sort "$IPHONE_MOUNT/DCIM" "$dry_run" "1" "$use_hash"

    echo ""
    if [[ "$dry_run" != "1" ]]; then
        success "Photos copied to $DEST_DIR"
        info "Originals remain on iPhone - delete manually when ready"
    fi

    # Ask about unmounting
    echo ""
    if read -q "?Unmount iPhone? [y/N] "; then
        echo ""
        fusermount -u "$IPHONE_MOUNT"
        success "iPhone unmounted"
    else
        echo ""
        info "iPhone still mounted at $IPHONE_MOUNT"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Main dispatcher
# ─────────────────────────────────────────────────────────────────────────────

DRY_RUN=0
MOVE_MODE=0
USE_HASH=0
SOURCE=""

# Check for subcommands first
if [[ "$1" == "add" ]]; then
    cmd_setup_add
    exit 0
fi

if [[ "$1" == "remove" || "$1" == "rm" ]]; then
    cmd_setup_remove
    exit 0
fi

if [[ "$1" == "list" || "$1" == "ls" ]]; then
    cmd_setup_list
    exit 0
fi

if [[ "$1" == "stats" ]]; then
    check_setup
    cmd_stats "$2"
    exit 0
fi

if [[ "$1" == "iphone" ]]; then
    check_setup
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=1; shift ;;
            --hash) USE_HASH=1; shift ;;
            *) shift ;;
        esac
    done
    select_library
    cmd_iphone "$DRY_RUN" "$USE_HASH"
    exit 0
fi

if [[ "$1" == "fix-exif" ]]; then
    check_setup
    shift
    [[ "$1" == "--dry-run" ]] && DRY_RUN=1
    select_library
    cmd_fix_exif "$DRY_RUN"
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --move)
            MOVE_MODE=1
            shift
            ;;
        --hash)
            USE_HASH=1
            shift
            ;;
        --help|-h|help)
            usage
            exit 0
            ;;
        -*)
            error "Unknown option: $1"
            ;;
        *)
            SOURCE="$1"
            shift
            ;;
    esac
done

[[ -z "$SOURCE" ]] && usage && exit 1
[[ ! -d "$SOURCE" ]] && error "Source directory not found: $SOURCE"

check_setup
select_library
# copy_mode is inverse of MOVE_MODE (copy by default)
local copy_mode=$((1 - MOVE_MODE))
cmd_sort "$SOURCE" "$DRY_RUN" "$copy_mode" "$USE_HASH"
