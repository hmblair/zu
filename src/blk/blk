#!/usr/bin/env zsh

# blk - Website Blocker CLI
# Blocks websites for a fixed period using pf firewall
# Blocks are enforced and cannot be removed until timer expires

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# Configuration
BLOCK_DIR="$HOME/.blk"
DATA_FILE="$BLOCK_DIR/data.enc"
SALT_FILE="$BLOCK_DIR/salt"
TRIGGER_FILE="$BLOCK_DIR/trigger"
ADD_REQUEST_FILE="$BLOCK_DIR/add_request"
SUMMARY_FILE="$BLOCK_DIR/summary"
DNS_BACKUP_FILE="$BLOCK_DIR/dns_backup"
PLIST_LABEL="com.zu.blkd"
DAEMON_PASS_FILE="/var/root/.blk_pass"
OP_ITEM_NAME="blk"  # 1Password item name for storing password
FAMILY_DNS="1.1.1.3"

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

usage() {
    echo "Usage: blk <command> [args]"
    echo ""
    echo "Commands:"
    echo "  add [--hidden] <domain> <duration>  Block a domain/pattern for specified duration"
    echo "  daily [--hidden] <domain> <schedule>  Set up a daily recurring block"
    echo "  remove <domain>             Remove a daily schedule (only when not active)"
    echo "  link <parent> <domain>...   Link domains to follow parent's block rules"
    echo "  unlink <parent> <domain>... Remove linked domains from parent"
    echo "  list [--show-hidden]        Show all active blocks with time remaining"
    echo "  status <domain>             Check if a domain is blocked"
    echo "  dns on                      Switch DNS to 1.1.1.3 (blocks malware/adult content)"
    echo "  dns off                     Restore original DNS settings"
    echo "  dns reset                   Reset DNS to automatic on all interfaces"
    echo "  dns status                  Show current DNS status"
    echo "  setup                       One-time setup (installs daemon)"
    echo "  reload                      Restart the daemon"
    echo "  uninstall                   Remove daemon and config (only if no active blocks)"
    echo ""
    echo "Duration format:"
    echo "  30s = 30 seconds"
    echo "  30m = 30 minutes"
    echo "  2h  = 2 hours"
    echo "  1d  = 1 day"
    echo "  1w  = 1 week"
    echo ""
    echo "Daily schedule format:"
    echo "  09:00-17:00   Block from 9am to 5pm daily"
    echo "  22:00-06:00   Block from 10pm to 6am daily (crosses midnight)"
    echo ""
    echo "Wildcard patterns:"
    echo "  *reddit*      Block reddit.com, old.reddit.com, reddit.net, etc."
    echo "  *.reddit.com  Block all subdomains of reddit.com"
    echo "  reddit.*      Block reddit with any TLD"
    echo ""
    echo "Examples:"
    echo "  blk add twitter.com 2h"
    echo "  blk add '*reddit*' 1d"
    echo "  blk daily '*reddit*' 09:00-17:00"
    echo "  blk remove '*reddit*'"
    echo "  blk link youtube.com googlevideo.com ytimg.com"
    echo "  blk list"
}

# ─────────────────────────────────────────────────────────────────────────────
# 1Password integration
# ─────────────────────────────────────────────────────────────────────────────

# Check if 1Password CLI is available
op_available() {
    command -v op &>/dev/null
}

# Get password from 1Password (returns empty string on failure)
op_get_password() {
    if ! op_available; then
        return 1
    fi
    # Sign out first to force fresh Touch ID prompt every time
    op signout --all 2>/dev/null
    # Try to read password field from the item (triggers Touch ID)
    local password
    password=$(op item get "$OP_ITEM_NAME" --fields password --reveal 2>/dev/null)
    if [[ $? -eq 0 ]] && [[ -n "$password" ]]; then
        echo -n "$password"
        return 0
    fi
    return 1
}

# Store password in 1Password
op_store_password() {
    local password="$1"
    if ! op_available; then
        return 1
    fi
    # Check if item already exists
    if op item get "$OP_ITEM_NAME" &>/dev/null; then
        # Update existing item
        op item edit "$OP_ITEM_NAME" "password=$password" &>/dev/null
    else
        # Create new item
        op item create --category=password --title="$OP_ITEM_NAME" "password=$password" &>/dev/null
    fi
    return $?
}

# ─────────────────────────────────────────────────────────────────────────────

# Check if setup has been completed
check_setup() {
    if [[ ! -f "$SALT_FILE" ]] || [[ ! -f "$DATA_FILE" ]]; then
        error "blk has not been set up. Run 'blk setup' first."
    fi
}

# Get password - tries 1Password first, falls back to manual prompt
prompt_password() {
    local prompt="${1:-Password: }"
    local password

    # Try 1Password first (will trigger Touch ID if available)
    if op_available; then
        password=$(op_get_password)
        if [[ $? -eq 0 ]] && [[ -n "$password" ]]; then
            echo -n "$password"
            return 0
        fi
        # 1Password failed (user cancelled, item not found, etc.) - fall through to manual
    fi

    # Manual password entry
    read -s "password?$prompt"
    echo "" >&2  # newline to stderr for terminal formatting
    echo -n "$password"
}

# Validate domain or pattern format
validate_domain() {
    local domain="$1"
    # Allow wildcards (*) or standard domain format
    if [[ "$domain" == *"*"* ]]; then
        # Wildcard pattern: must have at least one non-wildcard character
        local stripped="${domain//\*/}"
        if [[ -z "$stripped" ]]; then
            error "Pattern must contain at least one non-wildcard character"
        fi
        return 0
    fi
    # Basic domain validation: alphanumeric, hyphens, dots, at least one dot
    if ! [[ "$domain" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$ ]]; then
        error "Invalid domain format: $domain"
    fi
}

# Wrapper for zu_decrypt that validates JSON
decrypt_data() {
    local password="$1"
    local decrypted
    decrypted=$(zu_decrypt "$DATA_FILE" "$password")
    if [[ $? -ne 0 ]]; then
        return 1
    fi
    # Validate it's valid JSON
    if ! printf '%s' "$decrypted" | python3 -c "import sys,json; json.load(sys.stdin)" 2>/dev/null; then
        return 1
    fi
    printf '%s' "$decrypted"
    return 0
}

# Aliases for common functions (shorter names for this script)
parse_duration() { zu_parse_duration "$@"; }
format_duration() { zu_format_duration "$@"; }

# Touch trigger file to signal daemon
signal_daemon() {
    touch "$TRIGGER_FILE" 2>/dev/null
}

# Check if daemon is running and healthy
check_daemon_health() {
    # Returns: 0=healthy, 1=not running, 2=crashing
    # Try sudo launchctl first (works for system daemons)
    local daemon_info=$(sudo launchctl list 2>/dev/null | grep "$PLIST_LABEL")
    if [[ -n "$daemon_info" ]]; then
        # Parse: PID  ExitCode  Label
        local exit_code=$(echo "$daemon_info" | awk '{print $2}')
        local pid=$(echo "$daemon_info" | awk '{print $1}')
        if [[ "$pid" == "-" ]] && [[ "$exit_code" != "0" ]]; then
            echo "crashing:$exit_code"
            return 2
        fi
        echo "running"
        return 0
    fi
    # Fallback: check if blkd process is running
    if pgrep -f "blkd" >/dev/null 2>&1; then
        echo "running"
        return 0
    fi
    # Check if plist exists but daemon not running
    if [[ -f "/Library/LaunchDaemons/${PLIST_LABEL}.plist" ]]; then
        echo "not_running"
        return 1
    fi
    echo "not_installed"
    return 1
}

# Check if pf rules are loaded when they should be
check_pf_enforcement() {
    # Returns: 0=ok, 1=rules missing
    local anchor_name="com.zu.blk"
    local rules=$(sudo pfctl -a "$anchor_name" -s rules 2>/dev/null | grep -c "block")
    if [[ "$rules" -gt 0 ]]; then
        echo "enforced:$rules"
        return 0
    fi
    echo "not_enforced"
    return 1
}

# Parse schedule string (HH:MM-HH:MM) and validate
parse_schedule() {
    local schedule="$1"
    if ! [[ "$schedule" =~ ^[0-9]{1,2}:[0-9]{2}-[0-9]{1,2}:[0-9]{2}$ ]]; then
        error "Invalid schedule format: $schedule (use HH:MM-HH:MM)"
    fi
    local start="${schedule%%-*}"
    local end="${schedule##*-}"
    zu_parse_time "$start" > /dev/null  # validates
    zu_parse_time "$end" > /dev/null    # validates

    # Prevent 24-hour blocks (would never allow removal)
    if [[ "$start" == "$end" ]]; then
        error "Start and end times cannot be the same (would block 24 hours)"
    fi

    echo "$start-$end"
}

# Alias for common function
is_schedule_active() { zu_is_schedule_active "$@"; }

# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

cmd_setup() {
    info "Setting up website blocker..."

    # Check if already set up
    if [[ -f "$SALT_FILE" ]]; then
        warn "blk is already set up. Run 'blk uninstall' first to reconfigure."
        exit 1
    fi

    # Create block directory
    mkdir -p "$BLOCK_DIR"
    chmod 700 "$BLOCK_DIR"

    # Prompt for password (direct prompt, not via prompt_password which tries 1Password)
    echo "Choose a password for encrypting your block list."
    echo "You will need this password to add blocks or view the list."
    echo ""

    local password
    local confirm
    read -s "password?Password: "
    echo ""
    read -s "confirm?Confirm password: "
    echo ""

    if [[ "$password" != "$confirm" ]]; then
        rm -rf "$BLOCK_DIR"
        error "Passwords do not match."
    fi

    if [[ -z "$password" ]]; then
        rm -rf "$BLOCK_DIR"
        error "Password cannot be empty."
    fi

    # Offer to store in 1Password if available
    if op_available; then
        echo ""
        read -q "use_op?Store password in 1Password for Touch ID unlock? [y/N] "
        echo ""
        if [[ "$use_op" == "y" ]]; then
            if op_store_password "$password"; then
                success "Password stored in 1Password as '$OP_ITEM_NAME'"
            else
                warn "Failed to store in 1Password. You can add it manually later."
            fi
        fi
    fi

    # Generate salt
    openssl rand -hex 32 > "$SALT_FILE"
    chmod 600 "$SALT_FILE"

    # Initialize empty data file
    zu_encrypt "{}" "$password" > "$DATA_FILE"
    chmod 600 "$DATA_FILE"

    # Create trigger file
    touch "$TRIGGER_FILE"
    chmod 644 "$TRIGGER_FILE"

    # Create empty summary file (for password-free list command)
    echo "{}" > "$SUMMARY_FILE"
    chmod 644 "$SUMMARY_FILE"

    # Store password in root-only file for daemon access (no trailing newline)
    echo ""
    info "Storing daemon password (requires sudo)..."
    echo -n "$password" | sudo tee "$DAEMON_PASS_FILE" > /dev/null
    if [[ $? -ne 0 ]]; then
        rm -rf "$BLOCK_DIR"
        error "Failed to store daemon password."
    fi
    sudo chmod 600 "$DAEMON_PASS_FILE"
    sudo chown root:wheel "$DAEMON_PASS_FILE"

    # Copy daemon script
    local daemon_script="$SCRIPT_DIR/blkd"
    if [[ ! -f "$daemon_script" ]]; then
        rm -rf "$BLOCK_DIR"
        error "Daemon script not found at $daemon_script"
    fi

    echo ""
    info "Installing daemon (requires sudo)..."

    # Create and load daemon plist
    zu_service_create "$PLIST_LABEL" "$daemon_script" \
        --type keep_alive \
        --level system \
        --log "/var/log/blkd.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$PLIST_LABEL" system

    echo ""
    success "Setup complete!"
    echo "Use 'blk add <domain> <duration>' to block websites."
}

cmd_reload() {
    check_setup

    local daemon_script="$SCRIPT_DIR/blkd"
    if [[ ! -f "$daemon_script" ]]; then
        error "Daemon script not found at $daemon_script"
    fi

    info "Reloading daemon..."

    # Regenerate plist and reload
    zu_service_unload "$PLIST_LABEL" system
    zu_service_create "$PLIST_LABEL" "$daemon_script" \
        --type keep_alive \
        --level system \
        --log "/var/log/blkd.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$PLIST_LABEL" system

    success "Daemon reloaded."
}

cmd_uninstall() {
    check_setup

    # Check for active blocks
    local password=$(prompt_password)
    local data
    data=$(decrypt_data "$password")
    if [[ $? -ne 0 ]]; then
        error "Incorrect password or corrupted data."
    fi
    local now=$(date +%s)

    # Check if any blocks are still active
    local active_blocks=false
    echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
for domain, expiry in data.items():
    if expiry > now:
        print(f'{domain}')
" | while read domain; do
        active_blocks=true
        warn "Active block: $domain"
    done

    if [[ "$active_blocks" == "true" ]]; then
        error "Cannot uninstall while blocks are active. Wait for them to expire."
    fi

    info "Uninstalling website blocker..."

    # Unload and remove daemon
    zu_service_remove "$PLIST_LABEL" system

    # Remove pf anchor
    sudo pfctl -a com.zu.blk -F all 2>/dev/null

    # Remove daemon password file
    sudo rm -f "$DAEMON_PASS_FILE"

    # Remove block directory
    rm -rf "$BLOCK_DIR"

    success "Uninstall complete."
}

cmd_add() {
    local hidden=false
    local domain=""
    local duration=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hidden)
                hidden=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$domain" ]]; then
                    domain="$1"
                elif [[ -z "$duration" ]]; then
                    duration="$1"
                else
                    error "Unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$domain" ]] || [[ -z "$duration" ]]; then
        error "Usage: blk add [--hidden] <domain> <duration>"
    fi

    # Validate duration early (before setup check, to give helpful error without password)
    parse_duration "$duration" > /dev/null  # validates, exits on error

    check_setup

    # Normalize domain (remove protocol, www, trailing slash, convert to lowercase)
    domain=$(echo "$domain" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    # Validate domain
    validate_domain "$domain"

    local seconds=$(parse_duration "$duration")
    local expiry=$(($(date +%s) + seconds))

    # Confirm if block is longer than 1 day
    if [[ $seconds -gt 86400 ]]; then
        local formatted=$(format_duration "$seconds")
        warn "You are about to block $domain for $formatted."
        read -q "confirm?Are you sure? [y/N] "
        echo ""
        if [[ "$confirm" != "y" ]]; then
            echo "Cancelled."
            exit 0
        fi
    fi

    # Check existing blocks from summary file (doesn't require password)
    if [[ -f "$SUMMARY_FILE" ]]; then
        local existing_check=$(python3 -c "
import sys, json
try:
    with open('$SUMMARY_FILE') as f:
        data = json.load(f)
except:
    sys.exit(0)
domain = '$domain'
now = $(date +%s)
new_expiry = $expiry
if domain in data:
    val = data[domain]
    if isinstance(val, dict) and 'expiry' in val:
        if val['expiry'] > now and val['expiry'] > new_expiry:
            print(f'blocked|{int(val[\"expiry\"])}')
        else:
            print('ok')
    elif isinstance(val, dict) and 'schedule' in val:
        print(f'daily|{val[\"schedule\"]}')
    else:
        print('ok')
else:
    print('ok')
" 2>/dev/null)

        local check_type="${existing_check%%|*}"
        if [[ "$check_type" == "blocked" ]]; then
            local existing_expiry="${existing_check#*|}"
            local existing_date=$(date -r "$existing_expiry" '+%Y-%m-%d %H:%M:%S')
            error "$domain is already blocked until $existing_date. Cannot shorten an existing block."
        elif [[ "$check_type" == "daily" ]]; then
            local existing_schedule="${existing_check#*|}"
            error "$domain has a daily schedule ($existing_schedule). Remove it first before adding a timed block."
        fi
    fi

    # Get password to sign the request
    local password=$(prompt_password)

    # Write signed add request for daemon to process
    local request_data
    if [[ "$hidden" == "true" ]]; then
        request_data="{\"domain\": \"$domain\", \"expiry\": $expiry, \"hidden\": true}"
    else
        request_data="{\"domain\": \"$domain\", \"expiry\": $expiry}"
    fi
    local hmac=$(zu_hmac "$request_data" "$password")
    printf '%s\n%s' "$request_data" "$hmac" > "$ADD_REQUEST_FILE"

    # Signal daemon to process the request
    signal_daemon

    # Wait briefly for daemon to process (check summary file update)
    local max_wait=10
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
        sleep 0.5
        waited=$((waited + 1))
        # Check if request file was cleared (daemon processed it)
        if [[ ! -f "$ADD_REQUEST_FILE" ]]; then
            break
        fi
    done

    if [[ -f "$ADD_REQUEST_FILE" ]]; then
        warn "Request submitted. Daemon will process it shortly."
    fi

    success "Blocked $domain for $duration (until $(date -r $expiry '+%Y-%m-%d %H:%M:%S'))"
}

cmd_daily() {
    local hidden=false
    local domain=""
    local schedule=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --hidden)
                hidden=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$domain" ]]; then
                    domain="$1"
                elif [[ -z "$schedule" ]]; then
                    schedule="$1"
                else
                    error "Unexpected argument: $1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$domain" ]] || [[ -z "$schedule" ]]; then
        error "Usage: blk daily [--hidden] <domain> <start>-<end> (e.g., blk daily reddit.com 09:00-17:00)"
    fi

    # Validate schedule early (before setup check, to give helpful error without password)
    parse_schedule "$schedule" > /dev/null  # validates, exits on error

    check_setup

    # Normalize domain
    domain=$(echo "$domain" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    # Validate domain
    validate_domain "$domain"

    schedule=$(parse_schedule "$schedule")

    # Check if domain already has a timed block from summary file (no password needed)
    if [[ -f "$SUMMARY_FILE" ]]; then
        local existing=$(python3 -c "
import sys, json
try:
    with open('$SUMMARY_FILE') as f:
        data = json.load(f)
except:
    print('none')
    sys.exit(0)
domain = '$domain'
now = $(date +%s)
if domain in data:
    val = data[domain]
    if isinstance(val, dict) and 'expiry' in val:
        if val['expiry'] > now:
            print('timed')
        else:
            print('none')
    elif isinstance(val, dict) and 'schedule' in val:
        print('daily')
    else:
        print('unknown')
else:
    print('none')
" 2>/dev/null)

        if [[ "$existing" == "timed" ]]; then
            error "$domain already has a timed block. Wait for it to expire first."
        fi
    fi

    # Get password to sign the request
    local password=$(prompt_password)

    # Write signed add request for daemon to process
    local request_data
    if [[ "$hidden" == "true" ]]; then
        request_data="{\"domain\": \"$domain\", \"schedule\": \"$schedule\", \"hidden\": true}"
    else
        request_data="{\"domain\": \"$domain\", \"schedule\": \"$schedule\"}"
    fi
    local hmac=$(zu_hmac "$request_data" "$password")
    printf '%s\n%s' "$request_data" "$hmac" > "$ADD_REQUEST_FILE"

    # Signal daemon to process the request
    signal_daemon

    # Wait briefly for daemon to process
    local max_wait=10
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
        sleep 0.5
        waited=$((waited + 1))
        if [[ ! -f "$ADD_REQUEST_FILE" ]]; then
            break
        fi
    done

    if [[ -f "$ADD_REQUEST_FILE" ]]; then
        warn "Request submitted. Daemon will process it shortly."
    fi

    success "Daily block set for $domain ($schedule)"
    if is_schedule_active "$schedule"; then
        warn "Schedule is currently ACTIVE - $domain is now blocked."
    else
        info "Schedule is currently inactive - $domain is not blocked right now."
    fi
}

cmd_remove() {
    local domain="$1"

    if [[ -z "$domain" ]]; then
        error "Usage: blk remove <domain>"
    fi

    check_setup

    # Normalize domain
    domain=$(echo "$domain" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    # Get password and decrypt
    local password=$(prompt_password)
    local data
    data=$(decrypt_data "$password")
    if [[ $? -ne 0 ]]; then
        error "Incorrect password or corrupted data."
    fi

    # Check what type of block exists
    local block_info=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
domain = '$domain'
if domain not in data:
    print('none')
else:
    val = data[domain]
    if isinstance(val, (int, float)):
        print(f'timed|{int(val)}')
    elif isinstance(val, dict) and 'expiry' in val:
        print(f'timed|{int(val[\"expiry\"])}')
    elif isinstance(val, dict) and 'schedule' in val:
        print(f'daily|{val[\"schedule\"]}')
    else:
        print('unknown')
" 2>/dev/null)

    local block_type="${block_info%%|*}"
    local block_value="${block_info#*|}"

    if [[ "$block_type" == "none" ]]; then
        error "$domain is not blocked."
    fi

    if [[ "$block_type" == "timed" ]]; then
        local now=$(date +%s)
        if [[ $block_value -gt $now ]]; then
            error "$domain has a timed block that hasn't expired yet. Cannot remove."
        fi
    fi

    if [[ "$block_type" == "daily" ]]; then
        if is_schedule_active "$block_value"; then
            error "$domain daily schedule is currently active ($block_value). Can only remove outside blocked hours."
        fi
    fi

    # Remove the block
    local new_data=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
del data['$domain']
print(json.dumps(data))
")

    # Re-encrypt and save
    local encrypted=$(zu_encrypt "$new_data" "$password")
    printf '%s\n' "$encrypted" > "$DATA_FILE"

    # Signal daemon
    signal_daemon

    success "Removed block for $domain"
}

cmd_link() {
    if [[ $# -lt 2 ]]; then
        error "Usage: blk link <parent> <domain> [domain...]"
    fi

    local parent="$1"
    shift
    local domains=("$@")

    check_setup

    # Normalize parent
    parent=$(echo "$parent" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    # Get password and decrypt
    local password=$(prompt_password)
    local data
    data=$(decrypt_data "$password")
    if [[ $? -ne 0 ]]; then
        error "Incorrect password or corrupted data."
    fi

    # Check parent exists and add linked domains
    local new_data=$(python3 -c "
import sys, json

data = json.loads('''$data''')
parent = '$parent'
domains = '''${(j:,:)domains}'''.split(',')

if parent not in data:
    print('ERROR:Parent domain is not blocked')
    sys.exit(0)

# Initialize includes array if needed
if 'includes' not in data[parent]:
    data[parent]['includes'] = []

# Add new domains (avoid duplicates)
for d in domains:
    d = d.strip().lower()
    if d and d not in data[parent]['includes']:
        data[parent]['includes'].append(d)

print(json.dumps(data))
" 2>/dev/null)

    if [[ "$new_data" == ERROR:* ]]; then
        error "${new_data#ERROR:}"
    fi

    # Sign and write request for daemon
    local request_data="{\"action\": \"update\", \"data\": $new_data}"
    local hmac=$(zu_hmac "$new_data" "$password")

    # Re-encrypt and save directly (link doesn't need daemon request flow)
    local encrypted=$(zu_encrypt "$new_data" "$password")
    printf '%s\n' "$encrypted" > "$DATA_FILE"

    # Signal daemon
    signal_daemon

    success "Linked ${#domains[@]} domain(s) to $parent"
}

cmd_unlink() {
    if [[ $# -lt 2 ]]; then
        error "Usage: blk unlink <parent> <domain> [domain...]"
    fi

    local parent="$1"
    shift
    local domains=("$@")

    check_setup

    # Normalize parent
    parent=$(echo "$parent" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    # Get password and decrypt
    local password=$(prompt_password)
    local data
    data=$(decrypt_data "$password")
    if [[ $? -ne 0 ]]; then
        error "Incorrect password or corrupted data."
    fi

    # Remove linked domains
    local new_data=$(python3 -c "
import sys, json

data = json.loads('''$data''')
parent = '$parent'
domains = '''${(j:,:)domains}'''.split(',')

if parent not in data:
    print('ERROR:Parent domain is not blocked')
    sys.exit(0)

if 'includes' not in data[parent]:
    print('ERROR:No linked domains for this parent')
    sys.exit(0)

# Remove specified domains
for d in domains:
    d = d.strip().lower()
    if d in data[parent]['includes']:
        data[parent]['includes'].remove(d)

# Clean up empty includes
if not data[parent]['includes']:
    del data[parent]['includes']

print(json.dumps(data))
" 2>/dev/null)

    if [[ "$new_data" == ERROR:* ]]; then
        error "${new_data#ERROR:}"
    fi

    # Re-encrypt and save
    local encrypted=$(zu_encrypt "$new_data" "$password")
    printf '%s\n' "$encrypted" > "$DATA_FILE"

    # Signal daemon
    signal_daemon

    success "Unlinked ${#domains[@]} domain(s) from $parent"
}

cmd_list() {
    local show_hidden=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --show-hidden)
                show_hidden=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                error "Unexpected argument: $1"
                ;;
        esac
    done

    check_setup

    local data
    local now=$(date +%s)

    if [[ "$show_hidden" == "true" ]]; then
        # Show hidden requires password to decrypt
        local password=$(prompt_password)
        data=$(decrypt_data "$password")
        if [[ $? -ne 0 ]]; then
            error "Incorrect password or corrupted data."
        fi
    else
        # Read from unencrypted summary file (no password needed)
        if [[ ! -f "$SUMMARY_FILE" ]]; then
            data="{}"
        else
            data=$(cat "$SUMMARY_FILE" 2>/dev/null || echo "{}")
        fi
    fi

    local has_timed=false
    local has_daily=false
    local show_hidden_flag="$show_hidden"

    # Check daemon health and pf enforcement
    local daemon_status=$(check_daemon_health)
    local has_active_blocks=false

    # Determine if there are any active blocks (timed or in-schedule daily)
    local active_check=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
for domain, val in data.items():
    if isinstance(val, (int, float)) and val > now:
        print('timed')
        sys.exit(0)
    elif isinstance(val, dict) and 'expiry' in val and val['expiry'] > now:
        print('timed')
        sys.exit(0)
    elif isinstance(val, dict) and 'schedule' in val:
        print(val['schedule'])
        sys.exit(0)
print('none')
" 2>/dev/null)

    if [[ "$active_check" == "timed" ]]; then
        has_active_blocks=true
    elif [[ "$active_check" != "none" ]] && [[ -n "$active_check" ]]; then
        # It's a schedule string like "08:00-18:00"
        if is_schedule_active "$active_check"; then
            has_active_blocks=true
        fi
    fi

    # Show daemon/enforcement status
    echo ""
    echo "${BOLD}Status${NC}"
    echo "─────────────────────────────────────────"
    case "$daemon_status" in
        running)
            if [[ "$has_active_blocks" == "true" ]]; then
                local pf_status=$(check_pf_enforcement)
                if [[ "$pf_status" == enforced* ]]; then
                    local rule_count="${pf_status#enforced:}"
                    printf "  Daemon: ${GREEN}running${NC}    Firewall: ${GREEN}enforced${NC} (%s rules)\n" "$rule_count"
                else
                    printf "  Daemon: ${GREEN}running${NC}    Firewall: ${RED}NOT ENFORCED${NC}\n"
                    warn "Blocks are configured but firewall rules are not loaded!"
                fi
            else
                printf "  Daemon: ${GREEN}running${NC}    Firewall: ${GREY}no active blocks${NC}\n"
            fi
            ;;
        not_running)
            printf "  Daemon: ${RED}not running${NC}\n"
            warn "Daemon is not running. Run 'blk reload' to fix."
            ;;
        not_installed)
            printf "  Daemon: ${RED}not installed${NC}\n"
            warn "Daemon is not installed. Run 'blk setup' first."
            ;;
        crashing:*)
            local exit_code="${daemon_status#crashing:}"
            printf "  Daemon: ${RED}crashing${NC} (exit code %s)\n" "$exit_code"
            if [[ "$exit_code" == "127" ]]; then
                warn "Daemon script not found. Run 'blk reload' to fix."
            else
                warn "Daemon is crashing. Check /var/log/blkd.log for details."
            fi
            ;;
    esac

    # Get timed blocks (format: domain|remaining|expiry|hidden|includes_csv)
    local timed_blocks=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
show_hidden = '$show_hidden_flag' == 'true'
for domain, val in sorted(data.items()):
    if isinstance(val, (int, float)):
        remaining = int(val) - now
        if remaining > 0:
            print(f'{domain}|{remaining}|{int(val)}||')
    elif isinstance(val, dict) and 'expiry' in val:
        if not show_hidden and val.get('hidden'):
            continue
        remaining = int(val['expiry']) - now
        if remaining > 0:
            hidden = 'hidden' if val.get('hidden') else ''
            includes = ','.join(val.get('includes', []))
            print(f'{domain}|{remaining}|{int(val[\"expiry\"])}|{hidden}|{includes}')
" 2>/dev/null)

    # Get daily blocks (format: domain|schedule|hidden|includes_csv)
    local daily_blocks=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
show_hidden = '$show_hidden_flag' == 'true'
for domain, val in sorted(data.items()):
    if isinstance(val, dict) and 'schedule' in val:
        if not show_hidden and val.get('hidden'):
            continue
        hidden = 'hidden' if val.get('hidden') else ''
        includes = ','.join(val.get('includes', []))
        print(f'{domain}|{val[\"schedule\"]}|{hidden}|{includes}')
" 2>/dev/null)

    echo ""
    echo "${BOLD}Timed Blocks${NC}"
    echo "─────────────────────────────────────────"

    if [[ -n "$timed_blocks" ]]; then
        echo "$timed_blocks" | while IFS='|' read domain remaining expiry hidden_marker includes; do
            has_timed=true
            local formatted=$(format_duration "$remaining")
            local expiry_date=$(date -r "$expiry" '+%Y-%m-%d %H:%M')
            local hidden_label=""
            [[ "$hidden_marker" == "hidden" ]] && hidden_label=" ${GREY}[hidden]${NC}"
            printf "  ${CYAN}%-30s${NC} ${YELLOW}%s${NC} (until %s)%b\n" "$domain" "$formatted" "$expiry_date" "$hidden_label"
            # Show linked domains
            if [[ -n "$includes" ]]; then
                echo "$includes" | tr ',' '\n' | while read inc; do
                    [[ -n "$inc" ]] && printf "    ${GREY}└─ %s${NC}\n" "$inc"
                done
            fi
        done
    else
        echo "  ${GREY}No timed blocks${NC}"
    fi

    echo ""
    echo "${BOLD}Daily Schedules${NC}"
    echo "─────────────────────────────────────────"

    if [[ -n "$daily_blocks" ]]; then
        echo "$daily_blocks" | while IFS='|' read domain schedule hidden_marker includes; do
            has_daily=true
            local hidden_label=""
            [[ "$hidden_marker" == "hidden" ]] && hidden_label=" ${GREY}[hidden]${NC}"
            if is_schedule_active "$schedule"; then
                printf "  ${RED}%-30s${NC} ${YELLOW}%s${NC} ${RED}[ACTIVE]${NC}%b\n" "$domain" "$schedule" "$hidden_label"
            else
                printf "  ${CYAN}%-30s${NC} ${YELLOW}%s${NC} ${GREEN}[inactive]${NC}%b\n" "$domain" "$schedule" "$hidden_label"
            fi
            # Show linked domains
            if [[ -n "$includes" ]]; then
                echo "$includes" | tr ',' '\n' | while read inc; do
                    [[ -n "$inc" ]] && printf "    ${GREY}└─ %s${NC}\n" "$inc"
                done
            fi
        done
    else
        echo "  ${GREY}No daily schedules${NC}"
    fi
    echo ""
}

cmd_status() {
    local domain="$1"

    if [[ -z "$domain" ]]; then
        error "Usage: blk status <domain>"
    fi

    check_setup

    # Normalize domain
    domain=$(echo "$domain" | sed -E 's|^https?://||; s|^www\.||; s|/.*$||' | tr '[:upper:]' '[:lower:]')

    local password=$(prompt_password)
    local data
    data=$(decrypt_data "$password")
    if [[ $? -ne 0 ]]; then
        error "Incorrect password or corrupted data."
    fi
    local now=$(date +%s)

    local result=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
domain = '$domain'
now = $now
if domain not in data:
    print('not_blocked')
else:
    val = data[domain]
    if isinstance(val, (int, float)):
        remaining = int(val) - now
        if remaining > 0:
            print(f'timed|{remaining}|{int(val)}')
        else:
            print('expired')
    elif isinstance(val, dict) and 'expiry' in val:
        remaining = int(val['expiry']) - now
        if remaining > 0:
            print(f'timed|{remaining}|{int(val[\"expiry\"])}')
        else:
            print('expired')
    elif isinstance(val, dict) and 'schedule' in val:
        print(f'daily|{val[\"schedule\"]}')
    else:
        print('unknown')
")

    echo ""
    local result_type="${result%%|*}"

    if [[ "$result_type" == "not_blocked" ]]; then
        echo "  ${GREEN}$domain${NC} is not blocked"
    elif [[ "$result_type" == "expired" ]]; then
        echo "  ${GREEN}$domain${NC} block has expired"
    elif [[ "$result_type" == "timed" ]]; then
        local remaining=$(echo "$result" | cut -d'|' -f2)
        local expiry=$(echo "$result" | cut -d'|' -f3)
        local formatted=$(format_duration "$remaining")
        local expiry_date=$(date -r "$expiry" '+%Y-%m-%d %H:%M')
        echo "  ${RED}$domain${NC} is blocked for ${YELLOW}$formatted${NC} (until $expiry_date)"
    elif [[ "$result_type" == "daily" ]]; then
        local schedule="${result#*|}"
        if is_schedule_active "$schedule"; then
            echo "  ${RED}$domain${NC} has daily schedule ${YELLOW}$schedule${NC} ${RED}[ACTIVE]${NC}"
        else
            echo "  ${CYAN}$domain${NC} has daily schedule ${YELLOW}$schedule${NC} ${GREEN}[inactive]${NC}"
        fi
    fi
    echo ""
}

