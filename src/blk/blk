cmd_dns() {
    local subcmd="${1:-status}"

    # Get all network services (skip first line which is a header message)
    local services=("${(@f)$(networksetup -listallnetworkservices 2>/dev/null | tail -n +2)}")

    case "$subcmd" in
        on)
            mkdir -p "$BLOCK_DIR"

            # Backup current DNS for each service
            local backup=""
            for service in "${services[@]}"; do
                [[ "$service" == "*"* ]] && continue  # Skip disabled services
                local dns=$(networksetup -getdnsservers "$service" 2>/dev/null)
                if [[ "$dns" != "There aren't any DNS Servers set on"* ]]; then
                    backup+="$service|$dns"$'\n'
                else
                    backup+="$service|empty"$'\n'
                fi
            done
            echo -n "$backup" > "$DNS_BACKUP_FILE"

            # Set DNS to family-friendly Cloudflare
            for service in "${services[@]}"; do
                [[ "$service" == "*"* ]] && continue
                sudo networksetup -setdnsservers "$service" "$FAMILY_DNS" 2>/dev/null
            done

            success "DNS set to $FAMILY_DNS (Cloudflare family-friendly)"
            ;;
        off)
            if [[ ! -f "$DNS_BACKUP_FILE" ]]; then
                error "No DNS backup found. Run 'blk dns on' first."
            fi

            # Restore DNS for each service
            while IFS='|' read -r service dns; do
                [[ -z "$service" ]] && continue
                if [[ "$dns" == "empty" ]]; then
                    sudo networksetup -setdnsservers "$service" "Empty" 2>/dev/null
                else
                    sudo networksetup -setdnsservers "$service" ${(f)dns} 2>/dev/null
                fi
            done < "$DNS_BACKUP_FILE"

            rm -f "$DNS_BACKUP_FILE"
            success "DNS restored to original settings"
            ;;
        status)
            echo ""
            echo "${BOLD}DNS Status${NC}"
            echo "─────────────────────────────────────────"

            local is_family=false
            for service in "${services[@]}"; do
                [[ "$service" == "*"* ]] && continue
                local dns=$(networksetup -getdnsservers "$service" 2>/dev/null)
                if [[ "$dns" == "There aren't any DNS Servers set on"* ]]; then
                    dns="(automatic)"
                fi
                if [[ "$dns" == "$FAMILY_DNS" ]]; then
                    is_family=true
                    printf "  %-20s ${GREEN}%s${NC} (family)\n" "$service:" "$dns"
                else
                    printf "  %-20s %s\n" "$service:" "$dns"
                fi
            done

            echo ""
            if [[ -f "$DNS_BACKUP_FILE" ]]; then
                echo "  ${YELLOW}Family DNS is active${NC} (backup saved)"
            else
                echo "  ${GREY}Family DNS is not active${NC}"
            fi
            echo ""
            ;;
        reset)
            # Reset all services to automatic DNS
            for service in "${services[@]}"; do
                [[ "$service" == "*"* ]] && continue
                sudo networksetup -setdnsservers "$service" "Empty" 2>/dev/null
            done

            # Remove backup file if it exists
            rm -f "$DNS_BACKUP_FILE"

            success "DNS reset to automatic on all interfaces"
            ;;
        *)
            error "Unknown dns command: $subcmd (use on, off, reset, or status)"
            ;;
    esac
}

case "${1:-}" in
    add)
        shift
        cmd_add "$@"
        ;;
    daily)
        shift
        cmd_daily "$@"
        ;;
    remove)
        cmd_remove "$2"
        ;;
    link)
        shift
        cmd_link "$@"
        ;;
    unlink)
        shift
        cmd_unlink "$@"
        ;;
    list)
        shift
        cmd_list "$@"
        ;;
    status)
        cmd_status "$2"
        ;;
    dns)
        cmd_dns "$2"
        ;;
    setup)
        cmd_setup
        ;;
    reload)
        cmd_reload
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h)
        usage
        ;;
    "")
        usage
        ;;
    *)
        error "Unknown command: $1. Run 'blk help' for usage."
        ;;
esac
