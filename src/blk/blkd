#!/usr/bin/env zsh

# blkd - Website Blocker Daemon
# Runs as root via launchd, manages pf firewall rules
# Periodically verifies rules are in place and removes expired blocks

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/../common"

# ─────────────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────────────

BLOCK_DIR="$HOME/.blk"
DATA_FILE="$BLOCK_DIR/data.enc"
SALT_FILE="$BLOCK_DIR/salt"
TRIGGER_FILE="$BLOCK_DIR/trigger"
ADD_REQUEST_FILE="$BLOCK_DIR/add_request"
SUMMARY_FILE="$BLOCK_DIR/summary"
ANCHOR_NAME="com.zu.blk"
ANCHOR_FILE="/etc/pf.anchors/$ANCHOR_NAME"
DAEMON_PASS_FILE="/var/root/.blk_pass"

CHECK_INTERVAL=5  # seconds between rule verification
LOG_PREFIX="[blkd]"

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

log() {
    echo "$LOG_PREFIX $(date '+%Y-%m-%d %H:%M:%S') $1"
}

log_error() {
    echo "$LOG_PREFIX $(date '+%Y-%m-%d %H:%M:%S') ERROR: $1" >&2
}

# ─────────────────────────────────────────────────────────────────────────────
# Password and Decryption
# ─────────────────────────────────────────────────────────────────────────────

get_password() {
    # Retrieve password from root-only file (handle with or without trailing newline)
    tr -d '\n' < "$DAEMON_PASS_FILE" 2>/dev/null
}

# Wrappers for common functions
decrypt_data() {
    local password="$1"
    zu_decrypt "$DATA_FILE" "$password"
}

encrypt_data() {
    zu_encrypt "$@"
}

is_schedule_active() {
    zu_is_schedule_active "$@"
}

# ─────────────────────────────────────────────────────────────────────────────
# Domain Resolution
# ─────────────────────────────────────────────────────────────────────────────

# Check if a pattern matches a domain
pattern_matches() {
    local pattern="$1"
    local domain="$2"
    # Convert wildcard pattern to regex: * becomes .*
    local regex="^${pattern//\*/.*}$"
    [[ "$domain" =~ $regex ]]
}

# Check if entry is a wildcard pattern
is_wildcard() {
    [[ "$1" == *"*"* ]]
}

# Expand wildcard pattern to concrete domains
expand_wildcard() {
    local pattern="$1"
    local domains=""

    # Extract the core part (remove wildcards)
    local core="${pattern//\*/}"
    core="${core#.}"  # Remove leading dot
    core="${core%.}"  # Remove trailing dot

    # Common TLDs to try
    local tlds=("com" "net" "org" "io" "co")

    # Common subdomains to try
    local subdomains=("" "www" "old" "new" "m" "mobile" "api" "cdn" "static" "assets" "i" "v" "app")

    # If pattern is like *reddit*, try reddit with various TLDs
    if [[ "$pattern" == \** ]] && [[ "$pattern" == *\* ]]; then
        # Pattern like *reddit* - try as base domain with TLDs
        for tld in "${tlds[@]}"; do
            for sub in "${subdomains[@]}"; do
                if [[ -n "$sub" ]]; then
                    domains+="${sub}.${core}.${tld}"$'\n'
                else
                    domains+="${core}.${tld}"$'\n'
                fi
            done
        done
    elif [[ "$pattern" == \** ]]; then
        # Pattern like *reddit.com - try various subdomains
        local base="${pattern#\*}"
        base="${base#.}"
        for sub in "${subdomains[@]}"; do
            if [[ -n "$sub" ]]; then
                domains+="${sub}.${base}"$'\n'
            else
                domains+="${base}"$'\n'
            fi
        done
    elif [[ "$pattern" == *\* ]]; then
        # Pattern like reddit.* - try various TLDs
        local base="${pattern%\*}"
        base="${base%.}"
        for tld in "${tlds[@]}"; do
            for sub in "${subdomains[@]}"; do
                if [[ -n "$sub" ]]; then
                    domains+="${sub}.${base}.${tld}"$'\n'
                else
                    domains+="${base}.${tld}"$'\n'
                fi
            done
        done
    fi

    echo "$domains" | grep -v '^$' | sort -u
}

resolve_domain() {
    local domain="$1"
    # Get both A and AAAA records
    local ips=""

    # IPv4
    local ipv4=$(dig +short A "$domain" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
    [[ -n "$ipv4" ]] && ips="$ipv4"

    # Also resolve www subdomain if not already www
    if [[ ! "$domain" =~ ^www\. ]]; then
        local www_ipv4=$(dig +short A "www.$domain" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
        [[ -n "$www_ipv4" ]] && ips="$ips"$'\n'"$www_ipv4"
    fi

    # Return unique IPs
    echo "$ips" | sort -u | grep -v '^$'
}

# Resolve a domain or wildcard pattern to IPs
resolve_entry() {
    local entry="$1"

    if is_wildcard "$entry"; then
        # Expand wildcard and resolve each resulting domain
        local expanded=$(expand_wildcard "$entry")
        local all_ips=""
        while IFS= read -r domain; do
            [[ -z "$domain" ]] && continue
            local ips=$(resolve_domain "$domain")
            [[ -n "$ips" ]] && all_ips+="$ips"$'\n'
        done <<< "$expanded"
        echo "$all_ips" | sort -u | grep -v '^$'
    else
        resolve_domain "$entry"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# PF Firewall Management
# ─────────────────────────────────────────────────────────────────────────────

ensure_anchor_in_pf_conf() {
    # Check if our anchor is in pf.conf
    if ! grep -q "anchor \"$ANCHOR_NAME\"" /etc/pf.conf 2>/dev/null; then
        log "Adding anchor to /etc/pf.conf"
        # Add anchor after the last anchor line, or at the end
        if grep -q "^anchor" /etc/pf.conf; then
            # Insert after last anchor line
            local last_anchor_line=$(grep -n "^anchor" /etc/pf.conf | tail -1 | cut -d: -f1)
            sed -i '' "${last_anchor_line}a\\
anchor \"$ANCHOR_NAME\"
" /etc/pf.conf
        else
            # Append to end
            echo "anchor \"$ANCHOR_NAME\"" >> /etc/pf.conf
        fi
        # Reload pf.conf
        pfctl -f /etc/pf.conf 2>/dev/null
    fi
}

generate_pf_rules() {
    local data="$1"
    local now=$(date +%s)
    local rules=""

    # Parse JSON and get entries that should be active now
    # Handles both timed blocks (expiry timestamp) and daily schedules
    local entries=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
for entry, val in data.items():
    if isinstance(val, (int, float)):
        # Timed block (simple format) - check if not expired
        if val > now:
            print(entry)
    elif isinstance(val, dict) and 'expiry' in val:
        # Timed block (hidden format) - check if not expired
        if val['expiry'] > now:
            print(entry)
    elif isinstance(val, dict) and 'schedule' in val:
        # Daily schedule - print entry|schedule for shell to check
        print(f'{entry}|{val[\"schedule\"]}')
" 2>/dev/null)

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        local entry
        local schedule=""

        if [[ "$line" == *"|"* ]]; then
            # Daily schedule entry
            entry="${line%%|*}"
            schedule="${line#*|}"
            # Check if schedule is currently active
            if ! is_schedule_active "$schedule"; then
                continue
            fi
        else
            # Timed block entry
            entry="$line"
        fi

        local ips=$(resolve_entry "$entry")
        while IFS= read -r ip; do
            [[ -z "$ip" ]] && continue
            rules+="block return out quick on en0 to $ip"$'\n'
            rules+="block return out quick on en1 to $ip"$'\n'
            # Also block on other common interfaces
            rules+="block return out quick on utun0 to $ip"$'\n'
            rules+="block return out quick on utun1 to $ip"$'\n'
        done <<< "$ips"
    done <<< "$entries"

    echo "$rules"
}

apply_pf_rules() {
    local rules="$1"

    # Write rules to anchor file
    echo "$rules" > "$ANCHOR_FILE"
    chmod 644 "$ANCHOR_FILE"

    # Load the anchor
    if [[ -n "$rules" ]]; then
        pfctl -a "$ANCHOR_NAME" -f "$ANCHOR_FILE" 2>/dev/null
        # Ensure pf is enabled
        pfctl -e 2>/dev/null
    else
        # No rules, flush the anchor
        pfctl -a "$ANCHOR_NAME" -F all 2>/dev/null
    fi
}

get_current_rules() {
    pfctl -a "$ANCHOR_NAME" -s rules 2>/dev/null
}

# ─────────────────────────────────────────────────────────────────────────────
# Block Management
# ─────────────────────────────────────────────────────────────────────────────

# Process add requests from the CLI (allows adding blocks without password)
process_add_requests() {
    local password="$1"

    if [[ ! -f "$ADD_REQUEST_FILE" ]]; then
        return 0
    fi

    local request=$(cat "$ADD_REQUEST_FILE" 2>/dev/null)
    if [[ -z "$request" ]]; then
        rm -f "$ADD_REQUEST_FILE"
        return 0
    fi

    log "Processing add request"

    # Decrypt current data
    local data=$(decrypt_data "$password")
    if [[ -z "$data" ]]; then
        data="{}"
    fi

    # Merge the request into data
    local new_data=$(python3 -c "
import sys, json

# Parse current data
try:
    data = json.loads('''$data''')
except:
    data = {}

# Parse request
try:
    request = json.loads('''$request''')
except Exception as e:
    print(json.dumps(data))
    sys.exit(0)

domain = request.get('domain')
if not domain:
    print(json.dumps(data))
    sys.exit(0)

# Build the entry
if 'schedule' in request:
    # Daily schedule
    entry = {'schedule': request['schedule']}
    if request.get('hidden'):
        entry['hidden'] = True
    data[domain] = entry
elif 'expiry' in request:
    # Timed block
    if request.get('hidden'):
        data[domain] = {'expiry': request['expiry'], 'hidden': True}
    else:
        data[domain] = {'expiry': request['expiry']}

print(json.dumps(data))
" 2>/dev/null)

    if [[ -n "$new_data" ]] && [[ "$new_data" != "$data" ]]; then
        # Re-encrypt and save
        encrypt_data "$new_data" "$password" > "$DATA_FILE"
        log "Added block from request"
    fi

    # Remove the request file
    rm -f "$ADD_REQUEST_FILE"
}

# Update the summary file with non-hidden blocks
update_summary_file() {
    local data="$1"
    local now=$(date +%s)

    # Extract non-hidden active blocks
    local summary=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
summary = {}
for domain, val in data.items():
    if isinstance(val, (int, float)):
        # Simple timed block (not hidden) - convert to dict format for consistency
        if val > now:
            summary[domain] = {'expiry': int(val)}
    elif isinstance(val, dict):
        # Skip hidden entries
        if val.get('hidden'):
            continue
        if 'expiry' in val:
            if val['expiry'] > now:
                summary[domain] = {'expiry': int(val['expiry'])}
        elif 'schedule' in val:
            summary[domain] = {'schedule': val['schedule']}
print(json.dumps(summary))
" 2>/dev/null)

    if [[ -n "$summary" ]]; then
        echo "$summary" > "$SUMMARY_FILE"
        chmod 644 "$SUMMARY_FILE"
    fi
}

remove_expired_blocks() {
    local password="$1"
    local data="$2"
    local now=$(date +%s)

    # Remove expired entries
    local new_data=$(echo "$data" | python3 -c "
import sys, json
data = json.load(sys.stdin)
now = $now
active = {}
for k, v in data.items():
    if isinstance(v, (int, float)):
        # Simple timed block
        if v > now:
            active[k] = v
    elif isinstance(v, dict) and 'expiry' in v:
        # Hidden timed block
        if v['expiry'] > now:
            active[k] = v
    elif isinstance(v, dict) and 'schedule' in v:
        # Daily schedule - always keep
        active[k] = v
print(json.dumps(active))
" 2>/dev/null)

    if [[ "$new_data" != "$data" ]]; then
        log "Removing expired blocks"
        encrypt_data "$new_data" "$password" > "$DATA_FILE"
        echo "$new_data"
    else
        echo "$data"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Main Loop
# ─────────────────────────────────────────────────────────────────────────────

main() {
    log "Starting blkd daemon"

    # Ensure anchor is in pf.conf
    ensure_anchor_in_pf_conf

    # Get password from file
    local password=$(get_password)
    if [[ -z "$password" ]]; then
        log_error "Cannot retrieve password from $DAEMON_PASS_FILE. Exiting."
        exit 1
    fi
    log "Password retrieved successfully (length: ${#password})"

    local last_trigger_mtime=""
    local expected_rules=""

    while true; do
        # Check if trigger file was modified (new block added)
        local current_trigger_mtime=""
        if [[ -f "$TRIGGER_FILE" ]]; then
            current_trigger_mtime=$(stat -f %m "$TRIGGER_FILE" 2>/dev/null)
        fi

        local reload_needed=false

        if [[ "$current_trigger_mtime" != "$last_trigger_mtime" ]]; then
            log "Trigger file changed, reloading blocks"
            reload_needed=true
            last_trigger_mtime="$current_trigger_mtime"
        fi

        # Process any pending add requests (allows adding blocks without password)
        process_add_requests "$password"

        # Decrypt and process blocks
        local data=$(decrypt_data "$password")
        if [[ -z "$data" ]] || [[ "$data" == "{}" ]]; then
            # No blocks, ensure rules are cleared
            if [[ -n "$expected_rules" ]]; then
                log "No active blocks, clearing rules"
                apply_pf_rules ""
                expected_rules=""
            fi
            # Update summary file (empty)
            echo "{}" > "$SUMMARY_FILE"
            chmod 644 "$SUMMARY_FILE"
        else
            # Remove expired blocks
            data=$(remove_expired_blocks "$password" "$data")

            # Update the summary file with non-hidden blocks
            update_summary_file "$data"

            # Generate expected rules
            local new_rules=$(generate_pf_rules "$data")

            # Check if rules need updating
            if [[ "$reload_needed" == "true" ]] || [[ "$new_rules" != "$expected_rules" ]]; then
                log "Updating pf rules"
                apply_pf_rules "$new_rules"
                expected_rules="$new_rules"
            fi

            # Verify rules are still in place (tamper detection)
            local current_rules=$(get_current_rules)
            if [[ -n "$expected_rules" ]] && [[ "$current_rules" != *"block return"* ]]; then
                log "Rules were cleared externally, re-applying"
                apply_pf_rules "$expected_rules"
            fi
        fi

        sleep "$CHECK_INTERVAL"
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# Entry Point
# ─────────────────────────────────────────────────────────────────────────────

# Wait a moment for system to stabilize after boot
sleep 2

main
