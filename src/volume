#!/usr/bin/env zsh

source "${0:A:h}/common"

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    echo "Usage: ${0:t} [command]"
    echo "Show or adjust system volume"
    echo ""
    echo "Commands:"
    echo "  up        Increase volume by 5%"
    echo "  down      Decrease volume by 5%"
    echo "  set <N>   Set volume to N%"
    echo "  mute      Toggle mute"
    echo ""
    echo "With no command, shows current volume and audio device."
    exit 0
fi

if [[ $ZU_IS_MACOS -eq 1 ]]; then

    show_volume() {
        local pct=$(osascript -e 'output volume of (get volume settings)')
        local is_muted=$(osascript -e 'output muted of (get volume settings)')
        local muted=""
        [[ "$is_muted" == "true" ]] && muted=" ${RED}(muted)${NC}"
        local device=$(system_profiler SPAudioDataType 2>/dev/null | awk '/^        [^ ].*:$/{gsub(/^ +| *:$/,"",$0); name=$0} /Default Output Device: Yes/{print name; exit}')
        echo "${BOLD}${pct}%${NC}${muted}  ${GREY}${device}${NC}"
    }

    vol_up()   { osascript -e 'set volume output volume ((output volume of (get volume settings)) + 5)'; }
    vol_down() { osascript -e 'set volume output volume ((output volume of (get volume settings)) - 5)'; }
    vol_mute() { osascript -e 'set volume output muted not (output muted of (get volume settings))'; }
    vol_set()  { osascript -e "set volume output volume $1"; }

else

    if ! command -v wpctl &>/dev/null; then
        error "wpctl not found (requires WirePlumber/PipeWire)"
    fi

    show_volume() {
        local raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
        if [[ -z "$raw" ]]; then
            error "No default audio sink found"
        fi
        local level=$(echo "$raw" | awk '{print $2}')
        local pct=$(printf "%.0f" $(( level * 100 )))
        local muted=""
        [[ "$raw" == *MUTED* ]] && muted=" ${RED}(muted)${NC}"
        local device=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep 'node.description' | head -1 | sed 's/.*"\(.*\)".*/\1/')
        echo "${BOLD}${pct}%${NC}${muted}  ${GREY}${device}${NC}"
    }

    vol_up()   { wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+; }
    vol_down() { wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; }
    vol_mute() { wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; }
    vol_set()  { wpctl set-volume @DEFAULT_AUDIO_SINK@ "${1}%"; }

fi

case "${1:-}" in
    up)
        vol_up
        show_volume
        ;;
    down)
        vol_down
        show_volume
        ;;
    mute)
        vol_mute
        show_volume
        ;;
    set)
        [[ -z "${2:-}" ]] && error "Usage: ${0:t} set <percent>"
        [[ "$2" =~ ^[0-9]+$ ]] || error "Volume must be between 0 and 100"
        (( $2 > 100 )) && error "Volume must be between 0 and 100"
        vol_set "$2"
        show_volume
        ;;
    "")
        show_volume
        ;;
    *)
        error "Unknown command: $1"
        ;;
esac
