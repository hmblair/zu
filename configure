#!/usr/bin/env zsh

# configure - Set up zu bin directory with symlinks
# Only links main entry points: dir/dir scripts and root-level executables

setopt nullglob

SCRIPT_DIR="${0:A:h}"
SRC_DIR="$SCRIPT_DIR/src"
BIN_DIR="$SCRIPT_DIR/bin"
COMPLETIONS_DIR="$SRC_DIR/completions"
SITE_FUNCTIONS="/usr/local/share/zsh/site-functions"

mkdir -p "$BIN_DIR"

# Clear existing symlinks (but preserve compiled binaries)
for f in "$BIN_DIR"/*; do
    [[ -L "$f" ]] && rm -f "$f"
done

# Build C programs
echo "Building C programs..."
make -C "$SRC_DIR/l" -s

# Link dir/dir pattern scripts (e.g., src/bkup/bkup, src/blk/blk)
for script in "$SRC_DIR"/*/*; do
    [[ ! -x "$script" ]] && continue
    dir="${script:h:t}"
    name="${script:t}"
    [[ "$dir" == "completions" ]] && continue
    [[ "$name" != "$dir" ]] && continue
    ln -sf "../src/$dir/$name" "$BIN_DIR/$name"
done

# Link root-level executables in src/ (excluding special files)
for script in "$SRC_DIR"/*; do
    [[ -d "$script" ]] && continue
    [[ ! -x "$script" ]] && continue
    name="${script:t}"
    [[ "$name" == "common" ]] && continue
    ln -sf "../src/$name" "$BIN_DIR/$name"
done

echo "Configured $(ls -1 "$BIN_DIR" | wc -l | tr -d ' ') commands in bin/"

# Link completions to site-functions
# Try system location first, fall back to user-local
USER_SITE_FUNCTIONS="$HOME/.local/share/zsh/site-functions"

link_completions() {
    local target="$1"
    mkdir -p "$target"
    for comp in "$COMPLETIONS_DIR"/_*; do
        [[ ! -f "$comp" ]] && continue
        name="${comp:t}"
        ln -sf "$comp" "$target/$name"
    done
    echo "Linked $(ls -1 "$COMPLETIONS_DIR"/_* 2>/dev/null | wc -l | tr -d ' ') completions to $target"
}

if [[ -w "$SITE_FUNCTIONS" || -w "${SITE_FUNCTIONS:h}" ]] && [[ " $fpath " == *" $SITE_FUNCTIONS "* ]]; then
    # System location is writable and in fpath
    link_completions "$SITE_FUNCTIONS"
elif [[ -d "$USER_SITE_FUNCTIONS" ]] || [[ " $fpath " == *" $USER_SITE_FUNCTIONS "* ]]; then
    # User location exists or is in fpath
    link_completions "$USER_SITE_FUNCTIONS"
    if [[ " $fpath " != *" $USER_SITE_FUNCTIONS "* ]]; then
        echo "Note: Add to ~/.zshrc:  fpath=($USER_SITE_FUNCTIONS \$fpath)"
    fi
else
    # Create user dir and link there
    link_completions "$USER_SITE_FUNCTIONS"
    echo "Note: Add to ~/.zshrc:  fpath=($USER_SITE_FUNCTIONS \$fpath)"
fi
