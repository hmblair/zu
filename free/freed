#!/usr/bin/env zsh

# freed - Cache daemon for free script
# Updates the list of largest files in the home directory

# Ensure PATH is set for launchd environment
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONFIG_DIR="$HOME/.config/free"
CONFIG_FILE="$CONFIG_DIR/config.json"
CACHE_FILE="$CONFIG_DIR/cache"
STATUS_FILE="$CONFIG_DIR/status.json"
LOG_FILE="/tmp/freed.log"
DEFAULT_CACHE_COUNT=100

# Read cache_count from config, fallback to default
if [[ -f "$CONFIG_FILE" ]]; then
    CACHE_COUNT=$(grep -o '"cache_count": [0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*')
fi
CACHE_COUNT=${CACHE_COUNT:-$DEFAULT_CACHE_COUNT}

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Scan for largest files (capture stderr to log file)
find ~ -type f -size +1M -print0 2>>"$LOG_FILE" | \
    xargs -0 du -h 2>>"$LOG_FILE" | \
    sort -hr | \
    head -n $CACHE_COUNT > "$CACHE_FILE.tmp"

# Check if we got any results (temp file exists and has content)
if [[ -s "$CACHE_FILE.tmp" ]]; then
    # Atomically replace cache file
    mv "$CACHE_FILE.tmp" "$CACHE_FILE"
    # Update status with success
    cat > "$STATUS_FILE" <<EOF
{"updated": $(date +%s), "status": "success", "log": "$LOG_FILE"}
EOF
else
    echo "[$(date)] Cache update failed: temp file empty or missing" >> "$LOG_FILE"
    rm -f "$CACHE_FILE.tmp"
    # Update status with failure
    cat > "$STATUS_FILE" <<EOF
{"updated": $(date +%s), "status": "failed", "log": "$LOG_FILE"}
EOF
fi
