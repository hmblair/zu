#!/usr/bin/env zsh

SCRIPT_DIR=${0:A:h}
source $SCRIPT_DIR/../common

# Configuration
CONFIG_DIR="$HOME/.config/free"
CONFIG_FILE="$CONFIG_DIR/config.json"
CACHE_FILE="$CONFIG_DIR/cache"
STATUS_FILE="$CONFIG_DIR/status.json"
PLIST_LABEL="com.zu.freed"
DAEMON_PATH="$SCRIPT_DIR/freed"
DEFAULT_CACHE_COUNT=100

# Read cache_count from config, fallback to default
get_cache_count() {
    if [[ -f "$CONFIG_FILE" ]]; then
        grep -o '"cache_count": [0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*'
    fi
}
CACHE_COUNT=$(get_cache_count)
CACHE_COUNT=${CACHE_COUNT:-$DEFAULT_CACHE_COUNT}

# Helper: format time ago
time_ago() {
    local seconds=$1
    if [[ $seconds -lt 60 ]]; then
        echo "${seconds}s ago"
    elif [[ $seconds -lt 3600 ]]; then
        echo "$((seconds / 60))m ago"
    elif [[ $seconds -lt 86400 ]]; then
        echo "$((seconds / 3600))h ago"
    else
        echo "$((seconds / 86400))d ago"
    fi
}

# Command: setup
cmd_setup() {
    mkdir -p "$CONFIG_DIR"

    # Prompt for cache size
    local cache_count=$DEFAULT_CACHE_COUNT
    echo -n "Cache size [$DEFAULT_CACHE_COUNT]: "
    read user_count
    if [[ -n "$user_count" ]]; then
        cache_count=$user_count
    fi

    # Write config file
    echo "{\"cache_count\": $cache_count}" > "$CONFIG_FILE"

    # Install daemon
    zu_service_create "$PLIST_LABEL" "$DAEMON_PATH" \
        --type "interval:3600" \
        --log "/tmp/freed.log" \
        --env "HOME=$HOME" "USER=$USER"
    zu_service_load "$PLIST_LABEL"

    success "Daemon installed"
    echo "Cache will update every hour"
    echo ""
    echo "Run ${CYAN}free update${NC} to build cache now"
}

# Command: uninstall
cmd_uninstall() {
    if zu_service_exists "$PLIST_LABEL"; then
        zu_service_remove "$PLIST_LABEL"
        success "Daemon uninstalled"
    else
        echo "Daemon not installed"
    fi
}

# Command: reload
cmd_reload() {
    if zu_service_exists "$PLIST_LABEL"; then
        zu_service_reload "$PLIST_LABEL"
        success "Daemon reloaded"
    else
        echo "Daemon not installed. Run ${CYAN}free setup${NC} first."
    fi
}

# Command: update
cmd_update() {
    echo "Updating cache..."
    "$DAEMON_PATH"
    success "Cache updated"
}

# Command: status
cmd_status() {
    local LOG_FILE="/tmp/freed.log"
    local has_error=false

    echo ""
    echo "${BOLD}Free Cache Status${NC}"
    echo "──────────────────────────────────"

    # Check daemon status
    if zu_service_exists "$PLIST_LABEL"; then
        printf "  Daemon:       ${GREEN}✓ installed${NC}\n"
    else
        printf "  Daemon:       ${YELLOW}✗ not installed${NC}\n"
    fi

    # Check status file
    if [[ ! -f "$STATUS_FILE" ]]; then
        printf "  Last update:  ${YELLOW}never${NC}\n"
        printf "  Cache:        ${YELLOW}not built${NC}\n"
        echo ""
        echo "Run ${CYAN}free update${NC} to build cache"
        return 1
    fi

    # Read status info
    local updated=$(grep -o '"updated": [0-9]*' "$STATUS_FILE" 2>/dev/null | grep -o '[0-9]*')
    local run_status=$(grep -o '"status": "[^"]*"' "$STATUS_FILE" 2>/dev/null | grep -o '"[^"]*"$' | tr -d '"')
    local log=$(grep -o '"log": "[^"]*"' "$STATUS_FILE" 2>/dev/null | grep -o '"[^"]*"$' | tr -d '"')

    # Calculate time ago
    local now=$(date +%s)
    local age=$((now - updated))
    local ago=$(time_ago $age)

    # Show last update time and status
    if [[ "$run_status" == "success" ]]; then
        printf "  Last update:  ${GREEN}✓ success${NC} ($ago)\n"
    else
        printf "  Last update:  ${RED}✗ failed${NC} ($ago)\n"
        printf "  Log file:     ${GREY}%s${NC}\n" "${log:-$LOG_FILE}"
        has_error=true
    fi

    # Show cache info
    if [[ -f "$CACHE_FILE" ]]; then
        local file_count=$(wc -l < "$CACHE_FILE" | tr -d ' ')
        printf "  Cache:        ${CYAN}%s files${NC}\n" "$file_count"
    else
        printf "  Cache:        ${YELLOW}not built${NC}\n"
    fi

    echo ""

    if $has_error; then
        return 1
    fi
}

# Command: show largest files from cache
cmd_show_files() {
    local count=$1

    if [[ $count -gt $CACHE_COUNT ]]; then
        echo "${RED}Error:${NC} -n cannot exceed cache size ($CACHE_COUNT)"
        return 1
    fi

    if [[ ! -f "$CACHE_FILE" ]]; then
        echo "${YELLOW}No cache found.${NC} Run ${CYAN}free setup${NC} or ${CYAN}free update${NC}"
        return 1
    fi

    # Get cache age
    local updated=$(grep -o '"updated": [0-9]*' "$STATUS_FILE" 2>/dev/null | grep -o '[0-9]*')
    local now=$(date +%s)
    local age=$((now - updated))

    echo ""
    echo "${BOLD}Top $count largest files${NC} ${GREY}(cached $(time_ago $age))${NC}"
    head -n $count "$CACHE_FILE" | \
        awk -v cyan="$CYAN" -v nc="$NC" '{size=$1; $1=""; sub(/^ /, ""); printf cyan "%-8s" nc " %s\n", size, $0}'
}

# Main
case "$1" in
    setup)
        cmd_setup
        ;;
    uninstall)
        cmd_uninstall
        ;;
    reload)
        cmd_reload
        ;;
    update)
        cmd_update
        ;;
    status)
        cmd_status
        ;;
    *)
        # Parse -n flag
        count=0
        while getopts "n:" opt; do
            case $opt in
                n) count=$OPTARG ;;
            esac
        done

        # Show free space
        df -H / | awk -v cyan="$CYAN" -v nc="$NC" 'NR==2 {print cyan $4 nc " of " cyan $2 nc " free"}'

        # Show largest files if -n was provided
        if [[ $count -gt 0 ]]; then
            cmd_show_files $count
        fi
        ;;
esac
